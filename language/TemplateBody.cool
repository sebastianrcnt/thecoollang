class TemplateScope { U8 *names[4096]; I64 count; };
Bool TemplateHasLocal(TemplateScope *scope,U8 *name){I64 i;for(i=scope->count-1;i>=0;i--)if(Eq(scope->names[i],name))return TRUE;return FALSE;}
U0 TemplateLocal(TemplateScope *scope,U8 *name){if(scope->count==4096)Error("template local syntax limit exceeded");scope->names[scope->count++]=name;}
// Allocation-free grammar and nondependent name preflight before specialization.
extern U0 TemplateExpression(Function *f,TemplateScope *scope,I64 minimum,I64 nesting);
extern U0 TemplateBlock(Function *f,TemplateScope *scope,I64 nesting,I64 loops);
extern U0 TemplateStatement(Function *f,TemplateScope *scope,I64 nesting,I64 loops);
U0 TemplateDepth(I64 nesting){if(nesting>256)Error("template body syntax nesting limit exceeded");}
U0 TemplateList(Function *f,TemplateScope *scope,I64 close,I64 mode,I64 nesting){
    if(Take(close))return;
    do{
        if(mode==1){Ident();Need(':',"expected ':' after initializer field");}
        TemplateExpression(f,scope,1,nesting+1);
        if(!Take(','))break;
        if(mode && Take(close))return;
    }while(TRUE);
    Need(close,"expected closing delimiter after expression list");
}
Bool TemplateArgumentsAhead(){
    I64 i=pos,depth=0;
    if(tokens[i].kind!='[')return FALSE;
    do{if(tokens[i].kind=='[')depth++;if(tokens[i].kind==']')depth--;i++;}while(depth && tokens[i].kind);
    return !depth && (tokens[i].kind=='(' || tokens[i].kind=='{');
}
U0 TemplateArguments(Function *f,TemplateScope *scope,I64 nesting){
    I64 count=0;Need('[',"expected type arguments");
    do{if(count++==8)Error("generic argument limit exceeded");if(TemplateTypeSyntax(f,nesting+1))Error("generic argument cannot be void");}while(Take(','));
    Need(']',"expected ']' after type arguments");
}
U0 TemplateValueName(Function *f,TemplateScope *scope,Token *token,U8 *name,U8 *package,Bool qualified){
    I64 i,type,id;
    if(!qualified){
        if(TemplateHasLocal(scope,name))return;
        for(i=0;i<f->generic_count;i++)if(Eq(name,f->generic_names[i]))return;
        if(TypeName(name)>=0 || Eq(name,"true") || Eq(name,"false") || Eq(name,"null") || Eq(name,"len") || Eq(name,"assert"))return;
    }
    type=FindType(package,name);
    if(type>=0){if(qualified && !Shape(type)->public)ErrorAt(token,"type is private to its package");return;}
    if(qualified && Eq(package,"std/io") && (Eq(name,"print") || Eq(name,"println")))return;
    if(qualified && Eq(package,"std/mem") && (Eq(name,"owner_count") || Eq(name,"alloc") || Eq(name,"free") || Eq(name,"copy")))return;
    id=FindFunIn(package,name);
    if(id<0)ErrorAt(token,"unknown name in template body");
    if(qualified && !functions[id].public)ErrorAt(token,"function is private to its package");
}
// Completion inside an uninstantiated generic body: template locals are not
// in the current function's locals, so emit them from the template scope.
U0 TemplateCompletion(TemplateScope *scope){
    I64 i;if(!CompletionAt())return;
    for(i=0;i<scope->count;i++)CompletionItem(scope->names[i],6);
    CompletionGeneral(FALSE);
}
U0 TemplateStatementCompletion(TemplateScope *scope){
    I64 i;if(!CompletionAt())return;
    for(i=0;i<scope->count;i++)CompletionItem(scope->names[i],6);
    CompletionStatement();
}
U0 TemplatePrimary(Function *f,TemplateScope *scope,I64 nesting){
    I64 kind=At()->kind;Bool typed=FALSE,qualified=FALSE;U8 *name,*package;Token *token;
    TemplateDepth(nesting);
    if(kind=='-' || kind=='!' || kind=='~' || kind=='*' || kind=='&' || Is("move")){
        pos++;if(kind=='&' && (Is("mut") || Is("raw")))pos++;
        TemplatePrimary(f,scope,nesting+1);return;
    }
    if(Is("sizeof")){
        pos++;Need('(',"expected '(' after sizeof");TemplateTypeSyntax(f,0);Need(')',"expected ')' after sizeof");
    }else if(Is("new") || Is("borrow_raw") || (Is("cast") && tokens[pos+1].kind=='[')){
        kind=0;if(Is("cast"))kind=1;if(Is("borrow_raw"))kind=2;pos++;
        Need('[',"expected type argument");TemplateTypeSyntax(f,0);Need(']',"expected ']'");Need('(',"expected '('");
        if(kind || At()->kind!=')')TemplateExpression(f,scope,1,nesting+1);
        if(kind==2){Need(',',"expected borrow anchor");TemplateExpression(f,scope,1,nesting+1);}
        Need(')',"expected ')'");
    }else if(kind=='['){TemplateTypeSyntax(f,0);Need('{',"expected aggregate initializer");TemplateList(f,scope,'}',2,nesting);}
    else if(Take('(')){TemplateExpression(f,scope,1,nesting+1);Need(')',"expected ')'");}
    else if(kind==K_INT || kind==K_FLOAT || kind==K_STRING){pos++;}
    else{
        TemplateCompletion(scope);
        token=At();name=Ident();package=token->package;typed=FindType(package,name)>=0;
        // Imports can qualify a nominal type; local projections remain unresolved.
        if(!typed && !TemplateHasLocal(scope,name) && At()->kind=='.' && tokens[pos+1].kind==K_ID){
            Alias *a;for(a=aliases;a;a=a->next)if(Eq(a->file,token->file)&&Eq(a->name,name)){package=a->path;qualified=TRUE;pos++;name=Ident();typed=FindType(package,name)>=0;break;}
        }
        TemplateValueName(f,scope,token,name,package,qualified);
        if(At()->kind=='[' && (typed || TemplateArgumentsAhead()))TemplateArguments(f,scope,nesting);
        if(Take('{'))TemplateList(f,scope,'}',1,nesting);
        else if(Take('('))TemplateList(f,scope,')',0,nesting);
    }
    while(TRUE){
        if(Take('.')){Ident();if(TemplateArgumentsAhead())TemplateArguments(f,scope,nesting);if(Take('('))TemplateList(f,scope,')',0,nesting);}
        else if(Take('[')){
            if(At()->kind!=':')TemplateExpression(f,scope,1,nesting+1);
            if(Take(':')){if(At()->kind!=']')TemplateExpression(f,scope,1,nesting+1);}
            Need(']',"expected ']' after index or slice");
        }else break;
    }
}
U0 TemplateExpression(Function *f,TemplateScope *scope,I64 minimum,I64 nesting){
    I64 precedence;TemplateDepth(nesting);TemplatePrimary(f,scope,nesting+1);
    while((precedence=Prec(At()->kind))>=minimum){pos++;TemplateExpression(f,scope,precedence+1,nesting+1);}
}
U0 TemplateSimple(Function *f,TemplateScope *scope,Bool binding,I64 nesting){
    U8 *name;
    if(binding && (Is("let") || Is("var"))){pos++;name=Ident();if(Take(':')){if(TemplateTypeSyntax(f,0))Error("cannot bind a void value");}Need('=',"variables must have an initializer");TemplateExpression(f,scope,1,nesting+1);TemplateLocal(scope,name);}
    else{TemplateExpression(f,scope,1,nesting+1);if(Take('='))TemplateExpression(f,scope,1,nesting+1);}
}
U0 TemplateBlock(Function *f,TemplateScope *scope,I64 nesting,I64 loops){
    I64 saved=scope->count;TemplateDepth(nesting);Need('{',"expected '{'");
    while(!Take('}')){if(!At()->kind)Error("unterminated block");TemplateStatement(f,scope,nesting+1,loops);}
    scope->count=saved;
}
U0 TemplateStatement(Function *f,TemplateScope *scope,I64 nesting,I64 loops){
    Bool loop;I64 saved;U8 *name;TemplateDepth(nesting);TemplateStatementCompletion(scope);
    if(At()->kind=='{'){TemplateBlock(f,scope,nesting+1,loops);return;}
    if(Is("unsafe")){pos++;TemplateBlock(f,scope,nesting+1,loops);return;}
    if(Is("if") || Is("while")){
        loop=Is("while");pos++;Need('(',"expected '(' before condition");TemplateExpression(f,scope,1,nesting+1);Need(')',"expected ')'");TemplateBlock(f,scope,nesting+1,loops+loop);
        if(!loop && Is("else")){pos++;if(Is("if"))TemplateStatement(f,scope,nesting+1,loops);else TemplateBlock(f,scope,nesting+1,loops);}return;
    }
    if(Is("for")){
        saved=scope->count;pos++;Need('(',"expected '(' after for");if(!Take(';')){TemplateSimple(f,scope,TRUE,nesting);Need(';',"expected ';'");}
        if(!Take(';')){TemplateExpression(f,scope,1,nesting+1);Need(';',"expected ';'");}
        if(!Take(')')){TemplateSimple(f,scope,FALSE,nesting);Need(')',"expected ')'");}TemplateBlock(f,scope,nesting+1,loops+1);scope->count=saved;return;
    }
    if(Is("match")){
        pos++;Need('(',"expected '(' after match");TemplateExpression(f,scope,1,nesting+1);Need(')',"expected ')'");Need('{',"expected match arms");
        while(!Take('}')){
            saved=scope->count;
            if(Is("_"))pos++;
            else{TemplateTypeSyntax(f,0);Need('.',"expected enum variant");Ident();if(Take('(')){if(!Take(')')){name=Ident();TemplateLocal(scope,name);Need(')',"expected ')' after pattern binding");}}}
            Need(K_FAT_ARROW,"expected '=>' after match pattern");TemplateBlock(f,scope,nesting+1,loops);scope->count=saved;Take(',');
        }return;
    }
    if(Is("break") || Is("continue")){if(!loops)Error("loop control outside a loop");pos++;Need(';',"expected ';'");return;}
    if(Is("return")){pos++;if(!Take(';')){TemplateExpression(f,scope,1,nesting+1);Need(';',"expected ';'");}return;}
    if(Is("defer")){pos++;TemplateExpression(f,scope,1,nesting+1);Need(';',"expected ';'");return;}
    TemplateSimple(f,scope,TRUE,nesting);Need(';',"expected ';'");
}

U0 TemplateBodyCheck(Function *f){
    TemplateScope scope;I64 i;scope.count=0;
    for(i=f->signature;i<f->begin;i++)if(tokens[i].kind==K_ID && tokens[i+1].kind==':')TemplateLocal(&scope,tokens[i].text);
    TemplateBlock(f,&scope,0,0);
}
