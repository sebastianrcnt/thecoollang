// Completion stops the isolated checking process at the actual parser context.
extern U0 CompletionDeclarations(Bool public_only);
extern I64 MethodOwner(Function *f);
extern Bool IsReference(I64 type);
U0 CompletionInsert(I64 index,Token *token){I64 i;if(ntok>=MAX_TOKENS-2)ErrorAt(token,"completion token limit exceeded");for(i=ntok;i>=index;i--)tokens[i+1]=tokens[i];tokens[index]=*token;ntok++;}
U0 CompletionBegin(U8 *file,U8 *number){I64 offset=0,i=0;while(number[i]){if(number[i]<'0'||number[i]>'9'||offset>100000000)NativeExit(2);offset=offset*10+number[i++]-'0';}completion_file=file;completion_offset=offset;}
U0 CompletionExcluded(U8 *file,I64 start,I64 end){if(completion_file && Eq(file,completion_file) && start<=completion_offset && completion_offset<end)NativeExit(0);}
U0 CompletionPrepare(U8 *file,U8 *number){I64 offset=0,i=0,first=-1,last=-1,braces=0,selected=-1;Token *t,close,marker;while(number[i]){if(number[i]<'0'||number[i]>'9'||offset>100000000)NativeExit(2);offset=offset*10+number[i++]-'0';}for(i=0;i<ntok;i++){t=&tokens[i];if(Eq(t->file,file)){if(first<0)first=i;last=i;if(t->kind=='{')braces++;if(t->kind=='}')braces--;}}if(first<0){MemSet(&marker,0,sizeof(Token));marker.start=marker.end=offset;completion_token=&marker;completion_prefix="";CompletionDeclarations(FALSE);}close=tokens[last];close.kind='}';close.text="}";if(offset>close.end)close.end=offset;close.start=close.end;while(braces>0){CompletionInsert(last+1,&close);last++;braces--;}for(i=first;i<=last;i++){t=&tokens[i];if(t->kind!=K_ID && t->start<offset && offset<t->end)NativeExit(0);if(t->kind==K_ID && t->start<=offset && offset<=t->end){selected=i;break;}}if(selected>=0)completion_prefix=Slice(tokens[selected].text,0,offset-tokens[selected].start);else{for(i=first;i<=last && tokens[i].start<offset;i++);marker=tokens[first];marker.kind=K_ID;marker.text="__cool_completion__";marker.raw=NULL;marker.start=marker.end=offset;CompletionInsert(i,&marker);selected=i;completion_prefix="";}completion_token=&tokens[selected];}
Bool CompletionAt(){return completion_token && At()==completion_token;}
U0 CompletionItem(U8 *name,I64 kind){I64 i=0;Text *out;while(completion_prefix[i]){if(name[i]!=completion_prefix[i])return;i++;}out=TextNew();Append(out,"{\"kind\":\"completion\",\"label\":");EditorQuote(out,name);Append(out,",\"completionKind\":");Number(out,kind);Append(out,",\"start\":");Number(out,completion_token->start);Append(out,",\"end\":");Number(out,completion_token->end);Append(out,"}\n");Out(out->data);Free(out->data);Free(out);}
U0 CompletionPackage(U8 *package,Bool external,Bool types_only){I64 i;Function *f;AggregateType *t;for(i=0;i<nfun;i++){f=&functions[i];if(!types_only && !f->origin && Eq(f->package,package) && (!external || f->public) && MethodOwner(f)<0)CompletionItem(f->name,3);}for(i=0;i<naggregates;i++){t=&aggregate_types[i];if((t->kind==A_STRUCT || t->kind==A_ENUM) && !t->origin && Eq(t->package,package) && (!external || t->public))CompletionItem(t->name,22);}if(!types_only && Eq(package,"std/io")){CompletionItem("print",3);CompletionItem("println",3);}if(!types_only && Eq(package,"std/mem")){CompletionItem("alloc",3);CompletionItem("free",3);CompletionItem("copy",3);CompletionItem("owner_count",3);}}
U0 CompletionQualified(U8 *package,Bool types_only){if(CompletionAt()){CompletionPackage(package,TRUE,types_only);NativeExit(0);}}
U0 CompletionGeneral(Bool types_only){Local *local;Alias *alias;if(!CompletionAt())return;if(!types_only)for(local=locals;local;local=local->next)if(!local->moved && FindLocal(local->name)==local)CompletionItem(local->name,6);CompletionPackage(At()->package,FALSE,types_only);for(alias=aliases;alias;alias=alias->next)if(Eq(alias->file,At()->file))CompletionItem(alias->name,9);CompletionItem("i64",14);CompletionItem("i32",14);CompletionItem("i16",14);CompletionItem("i8",14);CompletionItem("u64",14);CompletionItem("u32",14);CompletionItem("u16",14);CompletionItem("u8",14);CompletionItem("usize",14);CompletionItem("isize",14);CompletionItem("f64",14);CompletionItem("f32",14);CompletionItem("bool",14);CompletionItem("string",14);CompletionItem("own",14);if(!types_only){CompletionItem("assert",3);CompletionItem("len",3);CompletionItem("sizeof",3);CompletionItem("true",14);CompletionItem("false",14);CompletionItem("null",14);}NativeExit(0);}
U0 CompletionMembers(I64 type,Bool variants){I64 fields_type=type,owner,i,j;Field *field;Function *f;if(!CompletionAt())return;if(Pointer(fields_type) && unsafe_depth)fields_type-=T_PTR;if(AggregateKind(fields_type)==A_STRUCT || (variants && AggregateKind(fields_type)==A_ENUM)){Layout(fields_type);for(field=Shape(fields_type)->fields;field;field=field->next)if(field->public || Eq(Shape(fields_type)->package,At()->package))CompletionItem(field->name,5);}if(!variants){owner=type;if(AggregateKind(owner)==A_OWNER || IsReference(owner))owner=Shape(owner)->element;if(AggregateKind(owner)==A_STRUCT || AggregateKind(owner)==A_ENUM){if(Shape(owner)->origin)owner=Shape(owner)->origin;for(i=0;i<nfun;i++){f=&functions[i];if(!f->origin && (f->public || Eq(f->package,At()->package)) && MethodOwner(f)==owner){for(j=0;f->name[j]!='.';j++);CompletionItem(f->name+j+1,2);}}}}NativeExit(0);}

U0 CompletionStatement(){if(!CompletionAt())return;CompletionItem("let",14);CompletionItem("var",14);CompletionItem("if",14);CompletionItem("while",14);CompletionItem("for",14);CompletionItem("return",14);CompletionItem("unsafe",14);CompletionItem("defer",14);CompletionItem("match",14);if(loop_depth){CompletionItem("break",14);CompletionItem("continue",14);}CompletionGeneral(FALSE);}
// Reorder body checking only; declaration and signature validation are unchanged.
U0 CompletionOrder(I64 *parsed,I64 count){I64 position,i,previous;Function *f;if(!completion_token)return;position=(completion_token-tokens);for(i=0;i<count;i++){f=&functions[parsed[i]];if(!f->foreign && !f->generic_count && f->begin<=position && position<f->end){previous=parsed[0];parsed[0]=parsed[i];parsed[i]=previous;return;}}}
U0 CompletionDeclarations(Bool public_only){CompletionItem("fn",14);CompletionItem("struct",14);CompletionItem("enum",14);CompletionItem("extern",14);CompletionItem("export",14);if(!public_only){CompletionItem("pub",14);CompletionItem("package",14);CompletionItem("import",14);}NativeExit(0);}
U0 CompletionTopLevel(){Token *previous;if(completion_token && Is("pub") && &tokens[pos+1]==completion_token)CompletionDeclarations(TRUE);if(!CompletionAt())return;if(!pos)CompletionDeclarations(FALSE);previous=&tokens[pos-1];if(!Eq(previous->file,At()->file) || previous->kind==';' || previous->kind=='}')CompletionDeclarations(FALSE);if(previous->kind==K_ID && Eq(previous->text,"pub"))CompletionDeclarations(TRUE);}
