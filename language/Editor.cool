U0 EditorQuote(Text *out,U8 *value){I64 i=0,byte;U8 *hex="0123456789abcdef";Char(out,'"');if(value)while(value[i]){byte=value[i++];if(byte=='"' || byte=='\\'){Char(out,'\\');Char(out,byte);}else if(byte<32){Append(out,"\\u00");Char(out,hex[byte/16]);Char(out,hex[byte%16]);}else Char(out,byte);}Char(out,'"');}
U0 EditorDiagnostic(Token *token,U8 *message){Text *out=TextNew();Append(out,"{\"file\":");EditorQuote(out,token->file);Append(out,",\"start\":");Number(out,token->start);Append(out,",\"end\":");Number(out,token->end);Append(out,",\"line\":");Number(out,token->line);Append(out,",\"column\":");Number(out,token->col);Append(out,",\"message\":");EditorQuote(out,message);Append(out,"}\n");Out(out->data);Free(out->data);Free(out);}
