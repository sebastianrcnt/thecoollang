U0 EditorQuote(Text *out,U8 *value){I64 i=0,byte;U8 *hex="0123456789abcdef";Char(out,'"');if(value)while(value[i]){byte=value[i++];if(byte=='"' || byte=='\\'){Char(out,'\\');Char(out,byte);}else if(byte<32){Append(out,"\\u00");Char(out,hex[byte/16]);Char(out,hex[byte%16]);}else Char(out,byte);}Char(out,'"');}
U0 EditorDiagnostic(Token *token,U8 *message){Text *out=TextNew();Append(out,"{\"file\":");EditorQuote(out,token->file);Append(out,",\"start\":");Number(out,token->start);Append(out,",\"end\":");Number(out,token->end);Append(out,",\"line\":");Number(out,token->line);Append(out,",\"column\":");Number(out,token->col);Append(out,",\"message\":");EditorQuote(out,message);Append(out,"}\n");Out(out->data);Free(out->data);Free(out);}
// Token text identity preserves lexical binding identity, including shadowing.
U0 EditorPrepare(){I64 i,slot;Token *token;editor_capacity=16;while(editor_capacity<ntok*2)editor_capacity*=2;editor_names=CAlloc(editor_capacity*sizeof(Token *));for(i=0;i<ntok;i++){token=&tokens[i];if(token->text){slot=token->text;slot=(slot/8)&(editor_capacity-1);while(editor_names[slot])slot=(slot+1)&(editor_capacity-1);editor_names[slot]=token;}}}
Token *EditorNameToken(U8 *name){I64 slot;if(!editor_index || !name || !editor_names)return NULL;slot=name;slot=(slot/8)&(editor_capacity-1);while(editor_names[slot]){if(editor_names[slot]->text==name)return editor_names[slot];slot=(slot+1)&(editor_capacity-1);}return NULL;}
U0 EditorReference(Token *source,Token *target){Text *out;if(!editor_index || !source || !target)return;out=TextNew();Append(out,"{\"kind\":\"reference\",\"file\":");EditorQuote(out,source->file);Append(out,",\"start\":");Number(out,source->start);Append(out,",\"end\":");Number(out,source->end);Append(out,",\"targetFile\":");EditorQuote(out,target->file);Append(out,",\"targetStart\":");Number(out,target->start);Append(out,",\"targetEnd\":");Number(out,target->end);Append(out,"}\n");Out(out->data);Free(out->data);Free(out);}
U0 EditorTypeReference(U8 *name,I64 type){if(!editor_index || type<T_AGG)return;EditorReference(EditorNameToken(name),EditorNameToken(Shape(type)->name));}
U0 EditorNodes(Node *n){Token *source,*target;while(n){if(n->local_ref && (n->kind==N_LOCAL || n->kind==N_LOCAL_ADDRESS || n->kind==N_BIND || n->kind==N_ASSIGN)){source=n->token;if(n->kind==N_BIND)source=EditorNameToken(n->local_ref->name);EditorReference(source,EditorNameToken(n->local_ref->name));}if(n->kind==N_CALL && n->slot>=0 && n->slot<nfun){target=functions[n->slot].token-1;source=EditorNameToken(n->name);if(n->token && n->token->kind=='.')source=n->token+1;EditorReference(source,target);}EditorNodes(n->a);EditorNodes(n->b);EditorNodes(n->c);n=n->next;}}
U0 EditorProgram(){I64 i;Function *f;for(i=0;i<nfun;i++){f=&functions[i];if(f->token)EditorReference(f->token-1,f->token-1);EditorNodes(f->body);}}
