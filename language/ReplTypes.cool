class ReplTypeChange { AggregateType *target;AggregateType saved;ReplTypeChange *next; };
ReplTypeChange *repl_type_changes;
U0 ReplSaveLayout(I64 type){ReplTypeChange *change;if(!allow_redefinition || type-T_AGG>=repl_saved_types)return;change=CAlloc(sizeof(ReplTypeChange));change->target=Shape(type);change->saved=*change->target;change->next=repl_type_changes;repl_type_changes=change;}
U0 ReplFreeFields(Field *field){Field *next;while(field){next=field->next;Free(field);field=next;}}
U0 ReplRollbackTypes(){ReplTypeChange *change;I64 i;while(repl_type_changes){change=repl_type_changes;repl_type_changes=change->next;if(change->target->fields!=change->saved.fields)ReplFreeFields(change->target->fields);*change->target=change->saved;Free(change);}for(i=repl_saved_types;i<naggregates;i++){ReplFreeFields(aggregate_types[i].fields);MemSet(&aggregate_types[i],0,sizeof(AggregateType));}}
U0 ReplCommitTypes(){ReplTypeChange *change;while(repl_type_changes){change=repl_type_changes;repl_type_changes=change->next;Free(change);}}
U0 ReplFinishLiterals(){ReplLiteral *entry;while(repl_new_literals){entry=repl_new_literals;repl_new_literals=entry->pending_next;if(repl_discard_literals){repl_literals[entry->bucket]=entry->next;Free(entry->text);Free(entry);}}repl_discard_literals=FALSE;}
