Local *ReferenceSyntheticRoot(ReferenceCheck *check){Local *local=CAlloc(sizeof(Local));local->all_next=check->synthetic_roots;check->synthetic_roots=local;return local;}
// Pure slice return masks; -1 is opaque, zero is never a proof.
class SliceProjectionScan {Function *function;Token *tokens;I64 position,end;U8 **names;I64 *origins,count,depth,mask;};
I64 SliceProjectionValue(SliceProjectionScan *s){I64 selected=0,origin;if(s->position>=s->end || s->tokens[s->position].kind!=K_ID)return -1;while(selected<s->count && !Eq(s->names[selected],s->tokens[s->position].text))selected++;if(selected==s->count || s->origins[selected]<=0)return -1;origin=s->origins[selected];s->position++;if(s->position<s->end && s->tokens[s->position].kind=='['){s->position++;if(s->position<s->end && s->tokens[s->position].kind==K_INT)s->position++;if(s->position>=s->end || s->tokens[s->position].kind!=':')return -1;s->position++;if(s->position<s->end && s->tokens[s->position].kind==K_INT)s->position++;if(s->position>=s->end || s->tokens[s->position].kind!=']')return -1;s->position++;}return origin;}
I64 SliceProjectionBlock(SliceProjectionScan *s){
 I64 base,outcome=0,origin,left,right,i;Token *token;U8 *condition,*name;Bool valid;
 if(s->depth>=16 || s->position>=s->end || s->tokens[s->position].kind!='{')return -1;
 s->depth++;base=s->count;s->position++;
 while(s->position<s->end && s->tokens[s->position].kind!='}'){
  if(outcome==1)return -1;token=&s->tokens[s->position];
  if(token->kind=='{'){outcome=SliceProjectionBlock(s);if(outcome<0)return -1;}
  else{
   if(token->kind!=K_ID)return -1;
   if(Eq(token->text,"return")){s->position++;origin=SliceProjectionValue(s);if(origin<=0 || s->position>=s->end || s->tokens[s->position].kind!=';')return -1;s->mask|=origin;s->position++;outcome=1;}
   else if(Eq(token->text,"if")){
    s->position++;if(s->position>=s->end || s->tokens[s->position].kind!='(')return -1;s->position++;
    if(s->position<s->end && s->tokens[s->position].kind=='!')s->position++;
    if(s->position>=s->end || s->tokens[s->position].kind!=K_ID)return -1;
    condition=s->tokens[s->position].text;valid=Eq(condition,"true") || Eq(condition,"false");
    for(i=0;i<s->function->argc;i++)if(s->function->arg_types[i]==T_BOOL && Eq(s->function->arg_names[i],condition))valid=TRUE;
    if(!valid)return -1;s->position++;if(s->position>=s->end || s->tokens[s->position].kind!=')')return -1;
    s->position++;left=SliceProjectionBlock(s);if(left<0)return -1;right=0;
    if(s->position<s->end && s->tokens[s->position].kind==K_ID && Eq(s->tokens[s->position].text,"else")){s->position++;right=SliceProjectionBlock(s);if(right<0)return -1;}
    if(left==1 && right==1)outcome=1;
   }else{
    if(!Eq(token->text,"let") && !Eq(token->text,"var"))return -1;
    if(s->position+3>=s->end || s->tokens[s->position+1].kind!=K_ID || s->tokens[s->position+2].kind!='=' || s->count==32)return -1;
    name=s->tokens[s->position+1].text;for(i=0;i<s->count;i++)if(Eq(s->names[i],name))return -1;
    s->position+=3;origin=SliceProjectionValue(s);if(origin<=0 || s->position>=s->end || s->tokens[s->position].kind!=';')return -1;
    s->position++;s->names[s->count]=name;s->origins[s->count]=origin;s->count++;
   }
  }
 }
 if(s->position>=s->end)return -1;s->position++;s->count=base;s->depth--;return outcome;
}
I64 ReferenceSliceProjection(Function *f){SliceProjectionScan s;U8 *names[32];I64 origins[32],i;if(f->foreign || f->generic_count || f->store_destinations || AggregateKind(f->result)!=A_SLICE || f->argc>32)return -1;if(f->begin<0 || f->end>ntok || f->end-f->begin<5 || f->end-f->begin>512)return -1;for(i=0;i<f->argc;i++){names[i]=f->arg_names[i];origins[i]=-1;if(f->arg_types[i]==f->result && (f->borrow_contract&(1<<i)))origins[i]=1<<i;}MemSet(&s,0,sizeof(SliceProjectionScan));s.function=f;s.tokens=tokens;s.position=f->begin;s.end=f->end;s.names=names;s.origins=origins;s.count=f->argc;if(SliceProjectionBlock(&s)!=1 || s.position!=s.end || s.mask<=0)return -1;return s.mask;}
extern U0 ReferenceSliceElementGraph(ReferenceCheck *check,ReferenceLoan *target,ReferenceLoan *source,Node *expression,Node *place,Local *via);
// Manual bootstrap counterpart of production typed loan metadata.
U0 ReferenceGraphFree(ProvenanceGraph *graph){if(graph){ProvenanceGraphFree(graph);Free(graph);}}
U0 ReferenceCheckFree(ReferenceCheck *check){Local *local,*next;ReferenceRelease(check,NULL);ReferenceGraphFree(check->graph);for(local=check->synthetic_roots;local;local=next){next=local->all_next;Free(local);}Free(check);}
U0 ReferenceChecksAbort(){ReferenceCheck *check;while(reference_checks){check=reference_checks;reference_checks=check->next;ReferenceCheckFree(check);}}
ProvenanceNode *ReferenceGraphValueNode(ProvenanceGraph *graph,I64 type,Local *root,I64 mode,I64 opaque){ProvenanceNode *n=graph->nodes;while(n){if(n->opaque==opaque && n->type==type && n->root==root && n->exclusive==mode && !n->edges)return n;n=n->next;}n=ProvenanceNodeNew(graph,type,root,mode);n->opaque=opaque;return n;}
ProvenanceNode *ReferenceGraphLeaf(ProvenanceGraph *graph,I64 type,Local *root,I64 mode){I64 kind=AggregateKind(type),opaque=0;if(kind==A_STRUCT || kind==A_ARRAY || kind==A_ENUM || kind==A_OWNER || (kind==6 && Borrowed(Shape(type)->element)))opaque=1;return ReferenceGraphValueNode(graph,type,root,mode,opaque);}
ProvenanceNode *ReferenceGraphParent(ProvenanceGraph *graph,I64 type,I64 kind,I64 key,ProvenanceNode *child){ProvenanceNode *n=graph->nodes;ProvenanceEdge *edge;while(n){edge=n->edges;if(!n->opaque && n->type==type && !n->root && edge && !edge->next && edge->kind==kind && edge->key==key && edge->target==child && edge->exclusive==1)return n;n=n->next;}n=ProvenanceNodeNew(graph,type,NULL,1);if(!ProvenanceEdgeNew(n,kind,key,child,1))Error("invalid internal loan projection");return n;}
Bool ReferenceGraphSame(ProvenanceNode *a,ProvenanceNode *b){ProvenanceEdge *x,*y;I64 count=0;if(a->type!=b->type || a->root!=b->root || a->exclusive!=b->exclusive || a->opaque!=b->opaque || a->summary_base!=b->summary_base)return FALSE;for(x=a->edges;x;x=x->next){y=b->edges;while(y && !(x->kind==y->kind && x->key==y->key && x->exclusive==y->exclusive && x->target==y->target))y=y->next;if(!y)return FALSE;count++;}for(y=b->edges;y;y=y->next)count--;return count==0;}
ProvenanceNode *ReferenceGraphIntern(ProvenanceGraph *graph,ProvenanceNode *fresh){ProvenanceNode *old;ProvenanceEdge *edge,*next;if(graph->nodes!=fresh)Error("invalid internal graph intern head");for(old=fresh->next;old;old=old->next)if(ReferenceGraphSame(fresh,old)){graph->nodes=fresh->next;edge=fresh->edges;while(edge){next=edge->next;Free(edge);edge=next;}Free(fresh);return old;}return fresh;}
I64 ReferenceRootMode(ReferenceLoan *source){ProvenanceQueryState *first,*tail,*current,*next;ProvenanceNode *n;ProvenanceEdge *edge;I64 mode=0;if(!source->provenance){if(source->provenance_known)return 0;return source->exclusive;}first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->exclusive=source->exclusive;tail=first;current=first;while(current){n=current->node;if(n->root==source->root)mode|=current->exclusive & n->exclusive;for(edge=n->edges;edge;edge=edge->next)tail=ProvenanceQueryAppend(first,tail,edge->target,NULL,current->exclusive & edge->exclusive);current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}return mode;}
extern U0 ReferencePhysicalJoin(ReferenceCheck *check,ReferenceLoan *loan,ReferenceLoan *source);
U0 ReferenceProvenanceJoin(ReferenceCheck *check,ReferenceLoan *loan,ReferenceLoan *source){ReferencePhysicalJoin(check,loan,source);
 ProvenanceNode *left=loan->provenance,*right=source->provenance,*joined;ProvenanceEdge *edge;I64 type=loan->provenance_type;
 if(!type && left)type=left->type;
 if((!right && !source->provenance_known) || (right && right->type!=type))right=ReferenceGraphValueNode(check->graph,type,source->root,ReferenceRootMode(source),1);
 if((!left && !loan->provenance_known) || (left && left->type!=type))left=ReferenceGraphValueNode(check->graph,type,loan->root,ReferenceRootMode(loan),1);
 loan->provenance=left;if(left)loan->provenance_known=!left->opaque;if(!right)return;
 if(!left && loan->provenance_known){loan->provenance=right;loan->provenance_known=!right->opaque;return;}
 if(!left || left==right || left->type!=right->type)return;
 joined=ProvenanceNodeNew(check->graph,left->type,left->root,left->exclusive);if(!joined->root){joined->root=right->root;joined->exclusive=right->exclusive;}else if(right->root)joined->exclusive|=right->exclusive;
 joined->opaque=left->opaque | right->opaque;joined->summary_base=left->summary_base;if(!joined->summary_base && left->summary_kind)joined->summary_base=left;if(!joined->summary_base)joined->summary_base=right->summary_base;if(!joined->summary_base && right->summary_kind)joined->summary_base=right;
 for(edge=left->edges;edge;edge=edge->next)ProvenanceEdgeNew(joined,edge->kind,edge->key,edge->target,edge->exclusive);for(edge=right->edges;edge;edge=edge->next)ProvenanceEdgeNew(joined,edge->kind,edge->key,edge->target,edge->exclusive);
 loan->provenance=ReferenceGraphIntern(check->graph,joined);loan->provenance_known=!loan->provenance->opaque;
}
ReferenceLoan *ReferenceNewFrom(ReferenceCheck *check,ReferenceLoan *source,Local *parent,I64 exclusive,I64 indirect,Node *expression,ReferenceLoan *next){ReferenceLoan *old=next,*loan;while(old && old->expression==expression && !old->holder && old->owner_pin==check->pending_owner){if(old->root==source->root && old->parent==parent && old->exclusive==exclusive && old->indirect==indirect){ReferenceProvenanceJoin(check,old,source);return next;}old=old->next;}loan=ReferenceNew(check,source->root,parent,exclusive,indirect,expression,next);loan->physical_provenance=source->physical_provenance;if(loan->provenance_type==source->provenance_type){loan->provenance=source->provenance;loan->provenance_known=source->provenance_known;}return loan;}
U0 ReferenceAggregateProvenance(ReferenceCheck *check,ReferenceLoan *loan,Node *aggregate,Node *item){I64 kind=AggregateKind(aggregate->type),edge=0,key=0;if(!loan->provenance)return;if(kind==A_STRUCT || kind==A_ENUM){edge=1;key=item->field_key;}if(kind==A_ARRAY)edge=2;if(kind==A_OWNER)edge=4;if(!edge || (edge==1 && !key))return;loan->provenance=ReferenceGraphParent(check->graph,aggregate->type,edge,key,loan->provenance);loan->provenance_type=aggregate->type;loan->provenance_known=1;}
ProvenanceGraph *ReferenceLoansCopyGraph(ReferenceLoan *loans){I64 count=0,i;ReferenceLoan *loan;ProvenanceGraph *graph;ProvenanceNode **sources,**targets;Bool valid;for(loan=loans;loan;loan=loan->next)count+=2;if(!count)return NULL;sources=CAlloc(count*8);targets=CAlloc(count*8);i=0;for(loan=loans;loan;loan=loan->next){sources[i++]=loan->provenance;sources[i++]=loan->physical_provenance;}graph=CAlloc(sizeof(ProvenanceGraph));valid=ProvenanceGraphCopyRoots(graph,sources,targets,count);if(valid){i=0;for(loan=loans;loan;loan=loan->next){loan->provenance=targets[i++];loan->physical_provenance=targets[i++];}}Free(sources);Free(targets);if(!valid){ReferenceGraphFree(graph);Error("invalid internal persistent loan graph");}return graph;}
class ReferenceTypeState { I64 type; ProvenanceNode *node; ReferenceTypeState *next; };
ProvenanceNode *ReferenceTypeNode(ReferenceCheck *check,I64 type,Local *root,ReferenceTypeState **states,Bool shared_origin){
 ReferenceTypeState *state;ProvenanceNode *node,*child;AggregateType *shape;Field *field;I64 kind,mode;
 if(!TrackedBorrow(type))return NULL;for(state=*states;state;state=state->next)if(state->type==type)return state->node;
 node=ProvenanceNodeNew(check->graph,type,NULL,1);state=ScratchAllocate(sizeof(ReferenceTypeState));state->type=type;state->node=node;state->next=*states;*states=state;shape=Shape(type);
 if(shape->kind==6 || shape->kind==A_SLICE){mode=shape->count;if(shape->kind==A_SLICE)mode=1;if(!shared_origin || !mode)node->root=root;node->exclusive=mode;child=ReferenceTypeNode(check,shape->element,root,states,shared_origin);kind=3;if(shape->kind==A_SLICE)kind=2;if(child && !ProvenanceEdgeNew(node,kind,0,child,mode))Error("invalid internal reference type summary");}
 else if(shape->kind==A_ARRAY || shape->kind==A_OWNER){child=ReferenceTypeNode(check,shape->element,root,states,shared_origin);kind=2;if(shape->kind==A_OWNER)kind=4;if(child && !ProvenanceEdgeNew(node,kind,0,child,1))Error("invalid internal payload type summary");}
 else if(shape->kind==A_STRUCT || shape->kind==A_ENUM){Layout(type);for(field=shape->fields;field;field=field->next){child=ReferenceTypeNode(check,field->type,root,states,shared_origin);if(child && !ProvenanceEdgeNew(node,1,field,child,1))Error("invalid internal field type summary");}}
 else {node->root=root;node->exclusive=ReferenceMode(type);node->opaque=1;}return node;
}
ProvenanceNode *ReferenceTypeSummary(ReferenceCheck *check,I64 type,Local *root){ReferenceTypeState *states=NULL,*next;ProvenanceNode *cached,*node;for(cached=check->graph->nodes;cached;cached=cached->next)if(cached->summary_kind==1 && cached->type==type && cached->summary_root==root)return cached;node=ReferenceTypeNode(check,type,root,&states,FALSE);while(states){next=states->next;ScratchRelease(states);states=next;}if(node){node->summary_root=root;node->summary_kind=1;node->summary_mode=1;}return node;}
U0 ReferenceParameterGraph(ReferenceCheck *check,ReferenceLoan *loan,I64 type,Bool payload){ProvenanceNode *child;loan->provenance_type=type;if(ReferenceBorrowedSlice(type)){loan->provenance=ReferenceGraphValueNode(check->graph,type,loan->root,loan->exclusive,0);if(payload){child=ReferenceTypeSummary(check,Shape(type)->element,loan->root);loan->provenance=NULL;if(child)loan->provenance=ReferenceGraphParent(check->graph,type,2,0,child);}}else if(payload && IsReference(type)){child=ReferenceTypeSummary(check,Shape(type)->element,loan->root);loan->provenance=NULL;if(child)loan->provenance=ReferenceGraphParent(check->graph,type,3,0,child);}else if(!IsReference(type))loan->provenance=ReferenceTypeSummary(check,type,loan->root);else loan->provenance=ReferenceGraphValueNode(check->graph,type,loan->root,loan->exclusive,0);loan->provenance_known=1;if(loan->provenance)loan->provenance_known=!loan->provenance->opaque;}
ProvenanceNode *ReferenceSharedOriginSummary(ReferenceCheck *check,I64 type,Local *root){ReferenceTypeState *states=NULL,*next;ProvenanceNode *old,*node;for(old=check->graph->nodes;old;old=old->next)if(old->summary_kind==4 && old->type==type && old->summary_root==root)return old;node=ReferenceTypeNode(check,type,root,&states,TRUE);while(states){next=states->next;ScratchRelease(states);states=next;}if(node){node->summary_root=root;node->summary_kind=4;node->summary_mode=0;}return node;}
ProvenanceNode *ReferenceBoundedSummary(ReferenceCheck *check,I64 type,Local *root,I64 mode,Bool payload){I64 kind=2,value_type=type,edge_kind=3;ProvenanceNode *old,*base,*result;ProvenanceEdge *edge;if(payload){kind=3;if(ReferenceBorrowedSlice(type))kind=5;}for(old=check->graph->nodes;old;old=old->next)if(old->summary_kind==kind && old->summary_root==root && old->type==type && old->summary_mode==mode)return old;if(payload)value_type=Shape(type)->element;if(!mode)base=ReferenceSharedOriginSummary(check,value_type,root);else base=ReferenceTypeSummary(check,value_type,root);if(!base)return NULL;if(payload){if(ReferenceBorrowedSlice(type))edge_kind=2;result=ProvenanceNodeNew(check->graph,type,NULL,1);if(!ProvenanceEdgeNew(result,edge_kind,0,base,mode))Error("invalid internal call payload summary");}else{result=ProvenanceNodeNew(check->graph,type,base->root,base->exclusive & mode);result->opaque=base->opaque;for(edge=base->edges;edge;edge=edge->next)if(!ProvenanceEdgeNew(result,edge->kind,edge->key,edge->target,edge->exclusive & mode))Error("invalid internal call value summary");}result->summary_base=base;result->summary_root=root;result->summary_kind=kind;result->summary_mode=mode;return result;}
U0 ReferenceCallGraph(ReferenceLoan *output,ReferenceCheck *check,ReferenceLoan *source,I64 type,I64 indirect){ReferenceLoan result=*source;I64 bound;result.physical_provenance=NULL;result.provenance_type=type;if(!source->provenance && source->provenance_known){*output=result;return;}bound=source->exclusive & ReferenceRootMode(source);if(ReferenceLayered(type) && !indirect)result.provenance=ReferenceGraphLeaf(check->graph,type,source->root,bound);else result.provenance=ReferenceBoundedSummary(check,type,source->root,bound,ReferenceLayered(type) && indirect);result.provenance_known=1;if(result.provenance)result.provenance_known=!result.provenance->opaque;*output=result;return;}
ReferenceLoan *ReferenceNewCall(ReferenceCheck *check,ReferenceLoan *source,Local *parent,I64 exclusive,I64 indirect,Node *expression,ReferenceLoan *next){ReferenceLoan scoped=*source,value,*old=next,*loan;scoped.exclusive&=exclusive;if(expression->kind==N_CALL && expression->slot>=0 && expression->slot<nfun && ReferenceSliceProjection(&functions[expression->slot])>=0 && scoped.provenance_type==expression->type){value=scoped;value.physical_provenance=NULL;}else ReferenceCallGraph(&value,check,&scoped,expression->type,indirect);while(old && old->expression==expression && !old->holder && old->owner_pin==check->pending_owner){if(old->root==source->root && old->parent==parent && old->exclusive==exclusive && old->indirect==indirect){ReferenceProvenanceJoin(check,old,&value);return next;}old=old->next;}loan=ReferenceNew(check,source->root,parent,exclusive,indirect,expression,next);loan->physical_provenance=value.physical_provenance;loan->provenance=value.provenance;loan->provenance_type=value.provenance_type;loan->provenance_known=value.provenance_known;return loan;}
class ReferenceCursor { ProvenanceCursor *path; I64 complete; };
class ReferenceSelection { ProvenanceNode *node; I64 type,known; };
U0 ReferenceCursorFree(ProvenanceCursor *path){ProvenanceCursor *next;while(path){next=path->next;Free(path);path=next;}}
U0 ReferencePlaceCursor(ReferenceCursor *output,Node *place,Local *via,Node *origin){ReferenceCursor result;Node *current=place;ProvenanceCursor *step;I64 kind;MemSet(&result,0,sizeof(ReferenceCursor));while(current){if(origin && (current==origin || (origin->kind==N_LOAD && current==origin->a))){result.complete=1;break;}if((current->kind==N_LOCAL || current->kind==N_LOCAL_ADDRESS) && current->local_ref==via && via){result.complete=1;break;}kind=PlaceProjectionKind(current);if(kind>0 && kind<5){step=CAlloc(sizeof(ProvenanceCursor));step->type=PlaceProjectionType(current);step->kind=kind;if(kind==1)step->key=current->field_key;step->next=result.path;result.path=step;if(kind==1 && !step->key)break;}else if(current->kind!=N_LOAD)break;current=PlaceProjectionParent(current);}*output=result;return;}
U0 ReferenceSelectionJoin(ReferenceCheck *check,ReferenceSelection *result,ProvenanceNode *node,I64 mode){ProvenanceNode *selected=node,*fresh;ProvenanceEdge *edge;ReferenceLoan target,source;if(!mode){fresh=ProvenanceNodeNew(check->graph,result->type,node->root,0);fresh->opaque=node->opaque;fresh->summary_base=node->summary_base;if(!fresh->summary_base && node->summary_kind)fresh->summary_base=node;for(edge=node->edges;edge;edge=edge->next)if(!ProvenanceEdgeNew(fresh,edge->kind,edge->key,edge->target,0))Error("invalid internal selected graph");selected=ReferenceGraphIntern(check->graph,fresh);}if(node->opaque)result->known=0;if(!result->node)result->node=selected;else{MemSet(&target,0,sizeof(ReferenceLoan));MemSet(&source,0,sizeof(ReferenceLoan));target.provenance=result->node;source.provenance=selected;ReferenceProvenanceJoin(check,&target,&source);result->node=target.provenance;}}
U0 ReferenceSelectFallback(ReferenceCheck *check,ReferenceSelection *result,Local *root,I64 mode){ProvenanceNode *node=ReferenceGraphValueNode(check->graph,result->type,root,mode,1);ReferenceSelectionJoin(check,result,node,1);result->known=0;}
U0 ReferenceSelectGraphMode(ReferenceSelection *output,ReferenceCheck *check,ReferenceLoan *source,ProvenanceCursor *path,I64 complete,I64 type,Bool copy_value){ReferenceSelection result;ProvenanceQueryState *first,*tail,*current,*next;ProvenanceNode *node;ProvenanceCursor *cursor;ProvenanceEdge *edge;MemSet(&result,0,sizeof(ReferenceSelection));result.type=type;result.known=1;if(!source->provenance){if(!source->provenance_known)ReferenceSelectFallback(check,&result,source->root,source->exclusive);*output=result;return;}if(!complete){ReferenceSelectFallback(check,&result,source->root,ReferenceRootMode(source));*output=result;return;}first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->cursor=path;first->exclusive=source->exclusive;current=tail=first;while(current){node=current->node;cursor=current->cursor;if(!cursor){if(node->type==type)ReferenceSelectionJoin(check,&result,node,current->exclusive);else ReferenceSelectFallback(check,&result,source->root,current->exclusive & ReferenceRootMode(source));}else{if(node->opaque || node->type!=cursor->type || (node->root && !(copy_value && cursor->kind==2 && ReferenceBorrowedSlice(node->type))))ReferenceSelectFallback(check,&result,source->root,current->exclusive & node->exclusive & ReferenceRootMode(source));if(node->type==cursor->type)for(edge=node->edges;edge;edge=edge->next)if(edge->kind==cursor->kind && (cursor->kind!=1 || edge->key==cursor->key))tail=ProvenanceQueryAppend(first,tail,edge->target,cursor->next,current->exclusive & edge->exclusive);}current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}*output=result;return;}
U0 ReferenceSelectGraph(ReferenceSelection *output,ReferenceCheck *check,ReferenceLoan *source,ProvenanceCursor *path,I64 complete,I64 type){ReferenceSelectGraphMode(output,check,source,path,complete,type,FALSE);}
U0 ReferenceSelectLoanMode(ReferenceCheck *check,ReferenceLoan *target,ReferenceLoan *source,Node *place,Local *via,Node *origin,Bool payload,Bool copy_value){ReferenceCursor cursor;ReferencePlaceCursor(&cursor,place,via,origin);I64 type=target->provenance_type;ReferenceSelection selected;if(payload && IsReference(type))type=Shape(type)->element;ReferenceSelectGraphMode(&selected,check,source,cursor.path,cursor.complete,type,copy_value);ReferenceCursorFree(cursor.path);if(payload && selected.node && IsReference(target->provenance_type))selected.node=ReferenceGraphParent(check->graph,target->provenance_type,3,0,selected.node);target->provenance=selected.node;target->provenance_known=selected.known;}
U0 ReferenceSelectLoan(ReferenceCheck *check,ReferenceLoan *target,ReferenceLoan *source,Node *place,Local *via,Node *origin,Bool payload){ReferenceSelectLoanMode(check,target,source,place,via,origin,payload,FALSE);}
ReferenceLoan *ReferenceNewSelected(ReferenceCheck *check,ReferenceLoan *source,Local *parent,I64 exclusive,I64 indirect,Node *expression,ReferenceLoan *next,Node *place,Local *via,Node *origin,Bool payload){ReferenceLoan selected,scoped=*source,*old=next,*loan;Bool copy_value=AggregateKind(expression->type)==A_SLICE && (expression->kind==N_LOCAL || expression->kind==N_LOAD || expression->kind==N_MOVE);MemSet(&selected,0,sizeof(ReferenceLoan));selected.physical_provenance=source->physical_provenance;selected.root=source->root;selected.exclusive=exclusive;selected.provenance_type=expression->type;scoped.exclusive&=exclusive;if(expression->kind==N_AGG_LITERAL && expression->op==1){scoped.provenance=NULL;scoped.provenance_known=0;selected.physical_provenance=NULL;}if(expression->kind==N_SLICE && expression->op==A_ARRAY && ReferenceBorrowedSlice(expression->type))ReferenceSliceElementGraph(check,&selected,&scoped,expression,place,via);else ReferenceSelectLoanMode(check,&selected,&scoped,place,via,origin,payload,copy_value);if(copy_value && selected.provenance_known && !selected.provenance)return next;if(NestedReference(expression->type) && selected.provenance && selected.provenance_known && selected.provenance->root==source->root && !selected.provenance->edges)indirect=0;while(old && old->expression==expression && !old->holder && old->owner_pin==check->pending_owner){if(old->root==source->root && old->parent==parent && old->exclusive==exclusive && old->indirect==indirect){ReferenceProvenanceJoin(check,old,&selected);return next;}old=old->next;}loan=ReferenceNew(check,source->root,parent,exclusive,indirect,expression,next);loan->physical_provenance=selected.physical_provenance;loan->provenance=selected.provenance;loan->provenance_known=selected.provenance_known;return loan;}
Bool ReferenceComputedGraph(ReferenceCheck *check,ReferenceLoan *loan,Node *place,Node *origin,Node *expression,I64 exclusive){ReferenceLoan source=*loan,target;Bool copy_value=AggregateKind(expression->type)==A_SLICE && (expression->kind==N_LOCAL || expression->kind==N_LOAD || expression->kind==N_MOVE);source.exclusive&=exclusive;target=source;target.provenance_type=expression->type;ReferenceSelectLoanMode(check,&target,&source,place,NULL,origin,loan->indirect && NestedReference(expression->type) && !(expression->kind==3 || expression->kind==18 || expression->kind==29),copy_value);if(copy_value && target.provenance_known && !target.provenance)return FALSE;if(expression->kind==N_AGG_LITERAL && expression->op==1)loan->physical_provenance=NULL;loan->provenance=target.provenance;loan->provenance_type=target.provenance_type;loan->provenance_known=target.provenance_known;if(NestedReference(expression->type) && target.provenance && target.provenance_known && target.provenance->root==loan->root && !target.provenance->edges)loan->indirect=0;return TRUE;}
Bool ReferencePathMayAccess(ReferenceLoan *source,ProvenanceCursor *path,I64 complete){ProvenanceQueryState *first,*tail,*current,*next;ProvenanceNode *node;ProvenanceCursor *cursor;ProvenanceEdge *edge;Bool found=FALSE;if(!complete)return TRUE;if(!source->provenance)return !source->provenance_known;first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->cursor=path;current=tail=first;while(current && !found){node=current->node;cursor=current->cursor;if(node->root==source->root && node->root)found=TRUE;else if(node->opaque || (cursor && node->type!=cursor->type))found=TRUE;else for(edge=node->edges;edge;edge=edge->next){if(!cursor)tail=ProvenanceQueryAppend(first,tail,edge->target,NULL,0);else if(edge->kind==cursor->kind && (cursor->kind!=1 || edge->key==cursor->key))tail=ProvenanceQueryAppend(first,tail,edge->target,cursor->next,0);}current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}return found;}
Bool ReferencePayloadMayAccess(ReferenceLoan *source,Node *place,Local *via){ReferenceCursor cursor;Bool found;if(!source->indirect || source->root==via)return TRUE;ReferencePlaceCursor(&cursor,place,via,NULL);found=ReferencePathMayAccess(source,cursor.path,cursor.complete);ReferenceCursorFree(cursor.path);return found;}
U0 ReferenceInstalledGraph(ReferenceLoan *output,ReferenceCheck *check,ReferenceLoan *source,I64 type,Node *destination,Bool opaque){ReferenceLoan result=*source;Node *place=destination;Local *via;ReferenceCursor cursor;ProvenanceCursor *path,*reverse=NULL,*step,*copy;ProvenanceNode *leaf;I64 leaf_type=source->provenance_type;Bool complete;result.provenance_type=type;if(!source->provenance && source->provenance_known){*output=result;return;}if(opaque){if(destination->kind==N_AGG_LITERAL && !destination->op)place=destination->a;else place=NULL;}via=BorrowRoot(place);ReferencePlaceCursor(&cursor,place,via,NULL);path=cursor.path;if(path && path->kind==3 && IsReference(path->type) && Shape(path->type)->element==type)path=path->next;complete=cursor.complete!=0;if(path && path->type!=type)complete=FALSE;if(!path && (!via || (via->type!=type && (!IsReference(via->type) || Shape(via->type)->element!=type))))complete=FALSE;leaf=source->provenance;if(opaque){leaf_type=Shape(destination->type)->element;leaf=ReferenceGraphValueNode(check->graph,leaf_type,source->root,ReferenceRootMode(source),1);}else if(!leaf && !source->provenance_known)leaf=ReferenceGraphValueNode(check->graph,leaf_type,source->root,ReferenceRootMode(source),1);if(complete && leaf){for(step=path;step;step=step->next){copy=CAlloc(sizeof(ProvenanceCursor));*copy=*step;copy->next=reverse;reverse=copy;}for(step=reverse;step;step=step->next)leaf=ReferenceGraphParent(check->graph,step->type,step->kind,step->key,leaf);ReferenceCursorFree(reverse);if(leaf->type!=type)complete=FALSE;}if(!complete)leaf=ReferenceGraphValueNode(check->graph,type,source->root,ReferenceRootMode(source),1);result.provenance=leaf;result.provenance_known=1;if(leaf)result.provenance_known=!leaf->opaque;ReferenceCursorFree(cursor.path);*output=result;return;}
U0 ReferenceReceiverGraph(ReferenceLoan *output,ReferenceCheck *check,ReferenceLoan *source,I64 type){ProvenanceCursor element;ReferenceSelection selected;ReferenceLoan result=*source;result.provenance_type=type;if(!result.provenance && source->provenance_known){*output=result;return;}if(!result.provenance)result.provenance=ReferenceGraphValueNode(check->graph,source->provenance_type,source->root,ReferenceRootMode(source),1);if(ReferenceBorrowedSlice(type)){MemSet(&element,0,sizeof(ProvenanceCursor));element.type=source->provenance_type;element.kind=2;ReferenceSelectGraph(&selected,check,source,&element,1,Shape(type)->element);result.provenance=NULL;result.provenance_known=selected.known;if(selected.node)result.provenance=ReferenceGraphParent(check->graph,type,2,0,selected.node);}else if(IsReference(type) && Shape(type)->element==source->provenance_type){result.provenance=ReferenceGraphParent(check->graph,type,3,0,result.provenance);result.provenance_known=1;}else{result.provenance=ReferenceGraphValueNode(check->graph,type,source->root,ReferenceRootMode(source),1);result.provenance_known=0;}*output=result;}

I64 ReferencePathAuthorityModes(ReferenceLoan *source,ProvenanceCursor *path,I64 complete,Bool copying){ProvenanceQueryState *first,*current,*tail,*next;ProvenanceNode *node;ProvenanceCursor *cursor;ProvenanceEdge *edge;I64 modes=0;if(!complete)return 4;if(!source->provenance){if(source->provenance_known)return 0;return 4;}first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->cursor=path;first->exclusive=source->exclusive;current=tail=first;while(current){node=current->node;cursor=current->cursor;if(!cursor){if(copying){if(node->opaque)modes|=4;else if(IsReference(node->type) || AggregateKind(node->type)==3){if(ReferenceMode(node->type) && node->root==source->root && node->root){if(current->exclusive & node->exclusive)modes|=1;else modes|=2;}}else for(edge=node->edges;edge;edge=edge->next)tail=ProvenanceQueryAppend(first,tail,edge->target,NULL,current->exclusive & edge->exclusive);}}else if(node->opaque || node->type!=cursor->type)modes|=4;else{if(node->root==source->root && node->root){if(current->exclusive & node->exclusive)modes|=1;else modes|=2;}for(edge=node->edges;edge;edge=edge->next)if(edge->kind==cursor->kind && (cursor->kind!=1 || edge->key==cursor->key))tail=ProvenanceQueryAppend(first,tail,edge->target,cursor->next,current->exclusive & edge->exclusive);}current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}return modes;}
I64 ReferencePathWriteModes(ReferenceLoan *source,ProvenanceCursor *path,I64 complete){return ReferencePathAuthorityModes(source,path,complete,FALSE);}
I64 ReferencePathCopyModes(ReferenceLoan *source,ProvenanceCursor *path,I64 complete){return ReferencePathAuthorityModes(source,path,complete,TRUE);}
U0 ReferenceRequirePayloadWrite(ReferenceCheck *check,Node *place,Local *via){ReferenceCursor cursor;ReferenceLoan *source;Bool shared=FALSE;if(!ReferenceThroughStored(place))return;ReferencePlaceCursor(&cursor,place,via,NULL);for(source=check->loans;source;source=source->next)if(source->holder==via && source->indirect==1 && source->root && source->root!=via)if(ReferencePathWriteModes(source,cursor.path,cursor.complete)&2)shared=TRUE;ReferenceCursorFree(cursor.path);if(shared)ErrorAt(place->token,"cannot mutate or move through a shared reference");}
U0 ReferenceRequirePayloadCopy(ReferenceCheck *check,Node *place,Local *via){ReferenceCursor cursor;ReferenceLoan *source;Bool shared=FALSE;ReferencePlaceCursor(&cursor,place,via,NULL);for(source=check->loans;source;source=source->next)if(source->holder==via && source->root)if(ReferencePathCopyModes(source,cursor.path,cursor.complete)&2)shared=TRUE;ReferenceCursorFree(cursor.path);if(shared)ErrorAt(place->token,"cannot copy or move an exclusive reference through a shared path");}
U0 ReferenceRequireComputedAuthority(ReferenceCheck *check,Node *place,Node *origin,Bool copying){ReferenceCursor cursor;Local *via;ReferenceLoan *source,*candidate;Node *boundary=origin,*current=origin,*parent;Bool shared=FALSE;if(!origin)return;via=BorrowRoot(place);if(via){if(copying)ReferenceRequirePayloadCopy(check,place,via);else ReferenceRequirePayloadWrite(check,place,via);return;}while(current && current->kind==N_LOAD){parent=ReferencePlaceSource(current->a);if(!parent || parent==current)break;for(candidate=check->loans;candidate;candidate=candidate->next)if(!candidate->holder && !candidate->owner_pin && candidate->expression==parent && candidate->root)boundary=parent;current=parent;}ReferencePlaceCursor(&cursor,place,NULL,boundary);for(source=check->loans;source;source=source->next)if(!source->holder && !source->owner_pin && source->expression==boundary && source->root)if(ReferencePathAuthorityModes(source,cursor.path,cursor.complete,copying)&2)shared=TRUE;ReferenceCursorFree(cursor.path);if(shared){if(copying)ErrorAt(place->token,"cannot copy or move an exclusive reference through a shared path");ErrorAt(place->token,"cannot mutate or move through a shared reference");}}

U0 ReferencePhysicalJoin(ReferenceCheck *check,ReferenceLoan *loan,ReferenceLoan *source){ReferenceLoan left,right;if(!loan->physical_provenance || !source->physical_provenance || !loan->root){loan->physical_provenance=NULL;return;}if(loan->physical_provenance==source->physical_provenance)return;MemSet(&left,0,sizeof(ReferenceLoan));left.root=loan->root;left.exclusive=1;left.provenance_type=loan->root->type;left.provenance=loan->physical_provenance;left.provenance_known=1;right=left;right.provenance=source->physical_provenance;ReferenceProvenanceJoin(check,&left,&right);loan->physical_provenance=left.provenance;}
U0 ReferencePhysicalCapture(ReferenceCheck *check,Node *place,Local *via,Node *expression){ReferenceCursor cursor;ProvenanceCursor *step,*next,*reversed=NULL;ProvenanceNode *node=NULL;ReferenceLoan *loan;I64 type;Bool valid;ReferencePlaceCursor(&cursor,place,via,NULL);valid=cursor.complete!=0;for(step=cursor.path;step;step=step->next)if(step->kind==3 || (step->kind==2 && AggregateKind(step->type)==3))valid=FALSE;if(valid){type=place->type;if(Pointer(type))type-=100000;node=ReferenceGraphValueNode(check->graph,type,via,1,0);for(step=cursor.path;step;step=next){next=step->next;step->next=reversed;reversed=step;}cursor.path=reversed;for(step=reversed;step;step=step->next)node=ReferenceGraphParent(check->graph,step->type,step->kind,step->key,node);}ReferenceCursorFree(cursor.path);for(loan=check->loans;loan;loan=loan->next)if(!loan->holder && loan->owner_pin==check->pending_owner && loan->expression==expression && loan->root==via && !loan->indirect){loan->physical_provenance=node;loan->provenance=ReferenceGraphValueNode(check->graph,expression->type,via,loan->exclusive,0);loan->provenance_known=1;}}
Bool ReferencePhysicalMayOverlap(ReferenceCheck *check,ReferenceLoan *loan,Node *place,Local *via){ReferenceCursor cursor;ReferenceLoan source,*item;ProvenanceGraph scratch;ProvenanceNode *candidate;Bool found=FALSE,known=FALSE;if(!loan->physical_provenance || !via || ReferenceThroughStored(place))return TRUE;ReferencePlaceCursor(&cursor,place,via,NULL);if(!cursor.complete){ReferenceCursorFree(cursor.path);return TRUE;}if(via==loan->root){source=*loan;source.provenance=loan->physical_provenance;source.provenance_known=1;found=ReferencePathMayAccess(&source,cursor.path,1);}else if(IsReference(via->type)){for(item=check->loans;item;item=item->next)if(item->holder==via && item->root==loan->root && !item->indirect){known=TRUE;MemSet(&scratch,0,sizeof(ProvenanceGraph));candidate=ReferencePhysicalSelected(&scratch,item,place,via);if(!candidate || ProvenanceAddressOverlap(loan->physical_provenance,candidate,loan->root))found=TRUE;ProvenanceGraphFree(&scratch);}if(!known)found=TRUE;}else found=TRUE;ReferenceCursorFree(cursor.path);return found;}

Bool ReferencePhysicalAccessOverlap(ReferenceCheck *check,ReferenceLoan *loan,Node *place,Local *via,Bool owner_slot){ReferenceCursor cursor;I64 type;Bool found=FALSE;if(!owner_slot || !loan->physical_provenance || !via || via!=loan->root)return ReferencePhysicalMayOverlap(check,loan,place,via);type=place->type;if(Pointer(type))type-=100000;if(AggregateKind(type)!=A_OWNER)return ReferencePhysicalMayOverlap(check,loan,place,via);ReferencePlaceCursor(&cursor,place,via,NULL);if(!cursor.complete){ReferenceCursorFree(cursor.path);return TRUE;}found=ProvenanceOwnerSlotOverlap(loan->physical_provenance,cursor.path,type);ReferenceCursorFree(cursor.path);return found;}

ProvenanceNode *ReferencePhysicalProjectGraph(ProvenanceGraph *graph,ProvenanceNode *source,Local *root,I64 expected,ProvenanceCursor *path,I64 type){ProvenanceCursor *step,*copy,*slow,*fast,*reversed=NULL;ProvenanceQueryState *first,*current,*tail,*next;ProvenanceNode *node,*before,*result,*copies,*projected;ProvenanceEdge *edge;Bool valid=TRUE,found=FALSE;if(!source || !path)return source;if(path->type!=expected)return NULL;slow=fast=path;while(fast && fast->next){slow=slow->next;fast=fast->next->next;if(slow==fast)return NULL;}for(step=path;step;step=step->next)if(step->kind<1 || step->kind>4 || step->kind==3 || (step->kind==2 && AggregateKind(step->type)==A_SLICE))return NULL;first=CAlloc(sizeof(ProvenanceQueryState));first->node=source;current=tail=first;while(current && valid){node=current->node;if(node->opaque)valid=FALSE;if(node->root){if(node->root!=root || node->type!=expected)valid=FALSE;found=TRUE;}for(edge=node->edges;edge;edge=edge->next)tail=ProvenanceQueryAppend(first,tail,edge->target,NULL,0);current=current->next;}for(current=first;current;current=next){next=current->next;Free(current);}if(!valid || !found)return NULL;before=graph->nodes;result=ProvenanceGraphCopy(graph,source);copies=graph->nodes;projected=ProvenanceNodeNew(graph,type,root,1);for(step=path;step;step=step->next){copy=CAlloc(sizeof(ProvenanceCursor));copy->type=step->type;copy->kind=step->kind;copy->key=step->key;copy->next=reversed;reversed=copy;}for(step=reversed;step;step=step->next)projected=ReferenceGraphParent(graph,step->type,step->kind,step->key,projected);ReferenceCursorFree(reversed);for(node=copies;node!=before;node=node->next)if(node->root==root && node->type==expected){node->root=NULL;for(edge=projected->edges;edge;edge=edge->next)if(!ProvenanceEdgeNew(node,edge->kind,edge->key,edge->target,1))Error("invalid internal physical projection");}return result;}
ProvenanceNode *ReferencePhysicalSelected(ProvenanceGraph *graph,ReferenceLoan *source,Node *place,Local *via){ReferenceCursor cursor;ProvenanceNode *result;I64 type;if(source->indirect || !via || !IsReference(via->type))return source->physical_provenance;ReferencePlaceCursor(&cursor,place,via,NULL);result=source->physical_provenance;if(!cursor.complete)result=NULL;else if(cursor.path){if(cursor.path->kind!=3 || cursor.path->type!=via->type || ReferenceThroughStored(place))result=NULL;else{type=place->type;if(Pointer(type))type-=100000;result=ReferencePhysicalProjectGraph(graph,result,source->root,Shape(via->type)->element,cursor.path->next,type);}}ReferenceCursorFree(cursor.path);return result;}

// Handwritten mirror of typed acquisition-layer routing.
I64 ReferenceAcquisitionLayer(Node *place,Local *via,Node *expression,I64 fallback){ReferenceCursor cursor;ProvenanceCursor *step;I64 layer=fallback;Bool seen=FALSE,copying=expression->kind==N_LOCAL || expression->kind==N_LOAD || expression->kind==N_MOVE,address=expression->kind==N_AGG_LITERAL && !expression->op;ReferencePlaceCursor(&cursor,place,via,NULL);if(cursor.complete)for(step=cursor.path;step;step=step->next){if(step->kind==2 && ReferenceBorrowedSlice(step->type)){seen=TRUE;if(copying)layer=1;}if(step->kind==3){if(address && seen)layer=1;if(NestedReference(step->type)){seen=TRUE;if(copying)layer=1;}}}ReferenceCursorFree(cursor.path);return layer;}

U0 ReferenceSliceElementGraph(ReferenceCheck *check,ReferenceLoan *target,ReferenceLoan *source,Node *expression,Node *place,Local *via){ReferenceCursor cursor;ProvenanceCursor element,*path,*tail;ReferenceSelection selected;I64 array_type=place->type;ReferencePlaceCursor(&cursor,place,via,NULL);if(Pointer(array_type))array_type-=T_PTR;MemSet(&element,0,sizeof(ProvenanceCursor));element.type=array_type;element.kind=2;path=cursor.path;if(!path)path=&element;else{tail=path;while(tail->next)tail=tail->next;tail->next=&element;}ReferenceSelectGraph(&selected,check,source,path,cursor.complete,Shape(expression->type)->element);if(cursor.path){tail=cursor.path;while(tail->next!=&element)tail=tail->next;tail->next=NULL;}ReferenceCursorFree(cursor.path);target->provenance=NULL;target->provenance_known=selected.known;if(selected.node)target->provenance=ReferenceGraphParent(check->graph,expression->type,2,0,selected.node);}
