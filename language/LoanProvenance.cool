// Manual bootstrap counterpart of production typed loan metadata.
U0 ReferenceGraphFree(ProvenanceGraph *graph){if(graph){ProvenanceGraphFree(graph);Free(graph);}}
U0 ReferenceCheckFree(ReferenceCheck *check){ReferenceRelease(check,NULL);ReferenceGraphFree(check->graph);Free(check);}
U0 ReferenceChecksAbort(){ReferenceCheck *check;while(reference_checks){check=reference_checks;reference_checks=check->next;ReferenceCheckFree(check);}}
ProvenanceNode *ReferenceGraphValueNode(ProvenanceGraph *graph,I64 type,Local *root,I64 mode,I64 opaque){ProvenanceNode *n=graph->nodes;while(n){if(n->opaque==opaque && n->type==type && n->root==root && n->exclusive==mode && !n->edges)return n;n=n->next;}n=ProvenanceNodeNew(graph,type,root,mode);n->opaque=opaque;return n;}
ProvenanceNode *ReferenceGraphLeaf(ProvenanceGraph *graph,I64 type,Local *root,I64 mode){I64 kind=AggregateKind(type),opaque=0;if(kind==A_STRUCT || kind==A_ARRAY || kind==A_ENUM || kind==A_OWNER || (kind==6 && Borrowed(Shape(type)->element)))opaque=1;return ReferenceGraphValueNode(graph,type,root,mode,opaque);}
ProvenanceNode *ReferenceGraphParent(ProvenanceGraph *graph,I64 type,I64 kind,I64 key,ProvenanceNode *child){ProvenanceNode *n=graph->nodes;ProvenanceEdge *edge;while(n){edge=n->edges;if(!n->opaque && n->type==type && !n->root && edge && !edge->next && edge->kind==kind && edge->key==key && edge->target==child && edge->exclusive==1)return n;n=n->next;}n=ProvenanceNodeNew(graph,type,NULL,1);if(!ProvenanceEdgeNew(n,kind,key,child,1))Error("invalid internal loan projection");return n;}
Bool ReferenceGraphSame(ProvenanceNode *a,ProvenanceNode *b){ProvenanceEdge *x,*y;I64 count=0;if(a->type!=b->type || a->root!=b->root || a->exclusive!=b->exclusive || a->opaque!=b->opaque || a->summary_base!=b->summary_base)return FALSE;for(x=a->edges;x;x=x->next){y=b->edges;while(y && !(x->kind==y->kind && x->key==y->key && x->exclusive==y->exclusive && x->target==y->target))y=y->next;if(!y)return FALSE;count++;}for(y=b->edges;y;y=y->next)count--;return count==0;}
ProvenanceNode *ReferenceGraphIntern(ProvenanceGraph *graph,ProvenanceNode *fresh){ProvenanceNode *old;ProvenanceEdge *edge,*next;if(graph->nodes!=fresh)Error("invalid internal graph intern head");for(old=fresh->next;old;old=old->next)if(ReferenceGraphSame(fresh,old)){graph->nodes=fresh->next;edge=fresh->edges;while(edge){next=edge->next;Free(edge);edge=next;}Free(fresh);return old;}return fresh;}
I64 ReferenceRootMode(ReferenceLoan *source){ProvenanceQueryState *first,*tail,*current,*next;ProvenanceNode *n;ProvenanceEdge *edge;I64 mode=0;if(!source->provenance){if(source->provenance_known)return 0;return source->exclusive;}first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->exclusive=source->exclusive;tail=first;current=first;while(current){n=current->node;if(n->root==source->root)mode|=current->exclusive & n->exclusive;for(edge=n->edges;edge;edge=edge->next)tail=ProvenanceQueryAppend(first,tail,edge->target,NULL,current->exclusive & edge->exclusive);current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}return mode;}
U0 ReferenceProvenanceJoin(ReferenceCheck *check,ReferenceLoan *loan,ReferenceLoan *source){
 ProvenanceNode *left=loan->provenance,*right=source->provenance,*joined;ProvenanceEdge *edge;I64 type=loan->provenance_type;
 if(!type && left)type=left->type;
 if((!right && !source->provenance_known) || (right && right->type!=type))right=ReferenceGraphValueNode(check->graph,type,source->root,ReferenceRootMode(source),1);
 if((!left && !loan->provenance_known) || (left && left->type!=type))left=ReferenceGraphValueNode(check->graph,type,loan->root,ReferenceRootMode(loan),1);
 loan->provenance=left;if(left)loan->provenance_known=!left->opaque;if(!right)return;
 if(!left && loan->provenance_known){loan->provenance=right;loan->provenance_known=!right->opaque;return;}
 if(!left || left==right || left->type!=right->type)return;
 joined=ProvenanceNodeNew(check->graph,left->type,left->root,left->exclusive);if(!joined->root){joined->root=right->root;joined->exclusive=right->exclusive;}else if(right->root)joined->exclusive|=right->exclusive;
 joined->opaque=left->opaque | right->opaque;joined->summary_base=left->summary_base;if(!joined->summary_base && left->summary_kind)joined->summary_base=left;if(!joined->summary_base)joined->summary_base=right->summary_base;if(!joined->summary_base && right->summary_kind)joined->summary_base=right;
 for(edge=left->edges;edge;edge=edge->next)ProvenanceEdgeNew(joined,edge->kind,edge->key,edge->target,edge->exclusive);for(edge=right->edges;edge;edge=edge->next)ProvenanceEdgeNew(joined,edge->kind,edge->key,edge->target,edge->exclusive);
 loan->provenance=ReferenceGraphIntern(check->graph,joined);loan->provenance_known=!loan->provenance->opaque;
}
ReferenceLoan *ReferenceNewFrom(ReferenceCheck *check,ReferenceLoan *source,Local *parent,I64 exclusive,I64 indirect,Node *expression,ReferenceLoan *next){ReferenceLoan *old=next,*loan;while(old && old->expression==expression && !old->holder){if(old->root==source->root && old->parent==parent && old->exclusive==exclusive && old->indirect==indirect){ReferenceProvenanceJoin(check,old,source);return next;}old=old->next;}loan=ReferenceNew(check,source->root,parent,exclusive,indirect,expression,next);if(loan->provenance_type==source->provenance_type){loan->provenance=source->provenance;loan->provenance_known=source->provenance_known;}return loan;}
U0 ReferenceAggregateProvenance(ReferenceCheck *check,ReferenceLoan *loan,Node *aggregate,Node *item){I64 kind=AggregateKind(aggregate->type),edge=0,key=0;if(!loan->provenance)return;if(kind==A_STRUCT || kind==A_ENUM){edge=1;key=item->field_key;}if(kind==A_ARRAY)edge=2;if(kind==A_OWNER)edge=4;if(!edge || (edge==1 && !key))return;loan->provenance=ReferenceGraphParent(check->graph,aggregate->type,edge,key,loan->provenance);loan->provenance_type=aggregate->type;loan->provenance_known=1;}
ProvenanceGraph *ReferenceLoansCopyGraph(ReferenceLoan *loans){I64 count=0,i;ReferenceLoan *loan;ProvenanceGraph *graph;ProvenanceNode **sources,**targets;Bool valid;for(loan=loans;loan;loan=loan->next)count++;if(!count)return NULL;sources=CAlloc(count*8);targets=CAlloc(count*8);i=0;for(loan=loans;loan;loan=loan->next)sources[i++]=loan->provenance;graph=CAlloc(sizeof(ProvenanceGraph));valid=ProvenanceGraphCopyRoots(graph,sources,targets,count);if(valid){i=0;for(loan=loans;loan;loan=loan->next)loan->provenance=targets[i++];}Free(sources);Free(targets);if(!valid){ReferenceGraphFree(graph);Error("invalid internal persistent loan graph");}return graph;}
class ReferenceTypeState { I64 type; ProvenanceNode *node; ReferenceTypeState *next; };
ProvenanceNode *ReferenceTypeNode(ReferenceCheck *check,I64 type,Local *root,ReferenceTypeState **states,Bool shared_origin){
 ReferenceTypeState *state;ProvenanceNode *node,*child;AggregateType *shape;Field *field;I64 kind,mode;
 if(!TrackedBorrow(type))return NULL;for(state=*states;state;state=state->next)if(state->type==type)return state->node;
 node=ProvenanceNodeNew(check->graph,type,NULL,1);state=ScratchAllocate(sizeof(ReferenceTypeState));state->type=type;state->node=node;state->next=*states;*states=state;shape=Shape(type);
 if(shape->kind==6 || shape->kind==A_SLICE){mode=shape->count;if(shape->kind==A_SLICE)mode=1;if(!shared_origin || !mode)node->root=root;node->exclusive=mode;child=ReferenceTypeNode(check,shape->element,root,states,shared_origin);kind=3;if(shape->kind==A_SLICE)kind=2;if(child && !ProvenanceEdgeNew(node,kind,0,child,mode))Error("invalid internal reference type summary");}
 else if(shape->kind==A_ARRAY || shape->kind==A_OWNER){child=ReferenceTypeNode(check,shape->element,root,states,shared_origin);kind=2;if(shape->kind==A_OWNER)kind=4;if(child && !ProvenanceEdgeNew(node,kind,0,child,1))Error("invalid internal payload type summary");}
 else if(shape->kind==A_STRUCT || shape->kind==A_ENUM){Layout(type);for(field=shape->fields;field;field=field->next){child=ReferenceTypeNode(check,field->type,root,states,shared_origin);if(child && !ProvenanceEdgeNew(node,1,field,child,1))Error("invalid internal field type summary");}}
 else {node->root=root;node->exclusive=ReferenceMode(type);node->opaque=1;}return node;
}
ProvenanceNode *ReferenceTypeSummary(ReferenceCheck *check,I64 type,Local *root){ReferenceTypeState *states=NULL,*next;ProvenanceNode *cached,*node;for(cached=check->graph->nodes;cached;cached=cached->next)if(cached->summary_kind==1 && cached->type==type && cached->summary_root==root)return cached;node=ReferenceTypeNode(check,type,root,&states,FALSE);while(states){next=states->next;ScratchRelease(states);states=next;}if(node){node->summary_root=root;node->summary_kind=1;node->summary_mode=1;}return node;}
U0 ReferenceParameterGraph(ReferenceCheck *check,ReferenceLoan *loan,I64 type,Bool payload){ProvenanceNode *child;loan->provenance_type=type;if(payload && IsReference(type)){child=ReferenceTypeSummary(check,Shape(type)->element,loan->root);loan->provenance=NULL;if(child)loan->provenance=ReferenceGraphParent(check->graph,type,3,0,child);}else if(!IsReference(type))loan->provenance=ReferenceTypeSummary(check,type,loan->root);else loan->provenance=ReferenceGraphLeaf(check->graph,type,loan->root,loan->exclusive);loan->provenance_known=1;if(loan->provenance)loan->provenance_known=!loan->provenance->opaque;}
ProvenanceNode *ReferenceSharedOriginSummary(ReferenceCheck *check,I64 type,Local *root){ReferenceTypeState *states=NULL,*next;ProvenanceNode *old,*node;for(old=check->graph->nodes;old;old=old->next)if(old->summary_kind==4 && old->type==type && old->summary_root==root)return old;node=ReferenceTypeNode(check,type,root,&states,TRUE);while(states){next=states->next;ScratchRelease(states);states=next;}if(node){node->summary_root=root;node->summary_kind=4;node->summary_mode=0;}return node;}
ProvenanceNode *ReferenceBoundedSummary(ReferenceCheck *check,I64 type,Local *root,I64 mode,Bool payload){I64 kind=2,value_type=type;ProvenanceNode *old,*base,*result;ProvenanceEdge *edge;if(payload)kind=3;for(old=check->graph->nodes;old;old=old->next)if(old->summary_kind==kind && old->summary_root==root && old->type==type && old->summary_mode==mode)return old;if(payload)value_type=Shape(type)->element;if(!mode)base=ReferenceSharedOriginSummary(check,value_type,root);else base=ReferenceTypeSummary(check,value_type,root);if(!base)return NULL;if(payload){result=ProvenanceNodeNew(check->graph,type,NULL,1);if(!ProvenanceEdgeNew(result,3,0,base,mode))Error("invalid internal call payload summary");}else{result=ProvenanceNodeNew(check->graph,type,base->root,base->exclusive & mode);result->opaque=base->opaque;for(edge=base->edges;edge;edge=edge->next)if(!ProvenanceEdgeNew(result,edge->kind,edge->key,edge->target,edge->exclusive & mode))Error("invalid internal call value summary");}result->summary_base=base;result->summary_root=root;result->summary_kind=kind;result->summary_mode=mode;return result;}
U0 ReferenceCallGraph(ReferenceLoan *output,ReferenceCheck *check,ReferenceLoan *source,I64 type,I64 indirect){ReferenceLoan result=*source;I64 bound;result.provenance_type=type;if(!source->provenance && source->provenance_known){*output=result;return;}bound=source->exclusive & ReferenceRootMode(source);if(NestedReference(type) && !indirect)result.provenance=ReferenceGraphLeaf(check->graph,type,source->root,bound);else result.provenance=ReferenceBoundedSummary(check,type,source->root,bound,NestedReference(type) && indirect);result.provenance_known=1;if(result.provenance)result.provenance_known=!result.provenance->opaque;*output=result;return;}
ReferenceLoan *ReferenceNewCall(ReferenceCheck *check,ReferenceLoan *source,Local *parent,I64 exclusive,I64 indirect,Node *expression,ReferenceLoan *next){ReferenceLoan scoped=*source,value,*old=next,*loan;scoped.exclusive&=exclusive;ReferenceCallGraph(&value,check,&scoped,expression->type,indirect);while(old && old->expression==expression && !old->holder){if(old->root==source->root && old->parent==parent && old->exclusive==exclusive && old->indirect==indirect){ReferenceProvenanceJoin(check,old,&value);return next;}old=old->next;}loan=ReferenceNew(check,source->root,parent,exclusive,indirect,expression,next);loan->provenance=value.provenance;loan->provenance_type=value.provenance_type;loan->provenance_known=value.provenance_known;return loan;}
class ReferenceCursor { ProvenanceCursor *path; I64 complete; };
class ReferenceSelection { ProvenanceNode *node; I64 type,known; };
U0 ReferenceCursorFree(ProvenanceCursor *path){ProvenanceCursor *next;while(path){next=path->next;Free(path);path=next;}}
U0 ReferencePlaceCursor(ReferenceCursor *output,Node *place,Local *via,Node *origin){ReferenceCursor result;Node *current=place;ProvenanceCursor *step;I64 kind;MemSet(&result,0,sizeof(ReferenceCursor));while(current){if(origin && (current==origin || (origin->kind==N_LOAD && current==origin->a))){result.complete=1;break;}if((current->kind==N_LOCAL || current->kind==N_LOCAL_ADDRESS) && current->local_ref==via && via){result.complete=1;break;}kind=PlaceProjectionKind(current);if(kind>0 && kind<5){step=CAlloc(sizeof(ProvenanceCursor));step->type=PlaceProjectionType(current);step->kind=kind;if(kind==1)step->key=current->field_key;step->next=result.path;result.path=step;if(kind==1 && !step->key)break;}else if(current->kind!=N_LOAD)break;current=PlaceProjectionParent(current);}*output=result;return;}
U0 ReferenceSelectionJoin(ReferenceCheck *check,ReferenceSelection *result,ProvenanceNode *node,I64 mode){ProvenanceNode *selected=node,*fresh;ProvenanceEdge *edge;ReferenceLoan target,source;if(!mode){fresh=ProvenanceNodeNew(check->graph,result->type,node->root,0);fresh->opaque=node->opaque;fresh->summary_base=node->summary_base;if(!fresh->summary_base && node->summary_kind)fresh->summary_base=node;for(edge=node->edges;edge;edge=edge->next)if(!ProvenanceEdgeNew(fresh,edge->kind,edge->key,edge->target,0))Error("invalid internal selected graph");selected=ReferenceGraphIntern(check->graph,fresh);}if(node->opaque)result->known=0;if(!result->node)result->node=selected;else{MemSet(&target,0,sizeof(ReferenceLoan));MemSet(&source,0,sizeof(ReferenceLoan));target.provenance=result->node;source.provenance=selected;ReferenceProvenanceJoin(check,&target,&source);result->node=target.provenance;}}
U0 ReferenceSelectFallback(ReferenceCheck *check,ReferenceSelection *result,Local *root,I64 mode){ProvenanceNode *node=ReferenceGraphValueNode(check->graph,result->type,root,mode,1);ReferenceSelectionJoin(check,result,node,1);result->known=0;}
U0 ReferenceSelectGraph(ReferenceSelection *output,ReferenceCheck *check,ReferenceLoan *source,ProvenanceCursor *path,I64 complete,I64 type){ReferenceSelection result;ProvenanceQueryState *first,*tail,*current,*next;ProvenanceNode *node;ProvenanceCursor *cursor;ProvenanceEdge *edge;MemSet(&result,0,sizeof(ReferenceSelection));result.type=type;result.known=1;if(!source->provenance){if(!source->provenance_known)ReferenceSelectFallback(check,&result,source->root,source->exclusive);*output=result;return;}if(!complete){ReferenceSelectFallback(check,&result,source->root,ReferenceRootMode(source));*output=result;return;}first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->cursor=path;first->exclusive=source->exclusive;current=tail=first;while(current){node=current->node;cursor=current->cursor;if(!cursor){if(node->type==type)ReferenceSelectionJoin(check,&result,node,current->exclusive);else ReferenceSelectFallback(check,&result,source->root,current->exclusive & ReferenceRootMode(source));}else{if(node->opaque || node->type!=cursor->type || node->root)ReferenceSelectFallback(check,&result,source->root,current->exclusive & node->exclusive & ReferenceRootMode(source));if(node->type==cursor->type)for(edge=node->edges;edge;edge=edge->next)if(edge->kind==cursor->kind && (cursor->kind!=1 || edge->key==cursor->key))tail=ProvenanceQueryAppend(first,tail,edge->target,cursor->next,current->exclusive & edge->exclusive);}current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}*output=result;return;}
U0 ReferenceSelectLoan(ReferenceCheck *check,ReferenceLoan *target,ReferenceLoan *source,Node *place,Local *via,Node *origin,Bool payload){ReferenceCursor cursor;ReferencePlaceCursor(&cursor,place,via,origin);I64 type=target->provenance_type;ReferenceSelection selected;if(payload && IsReference(type))type=Shape(type)->element;ReferenceSelectGraph(&selected,check,source,cursor.path,cursor.complete,type);ReferenceCursorFree(cursor.path);if(payload && selected.node && IsReference(target->provenance_type))selected.node=ReferenceGraphParent(check->graph,target->provenance_type,3,0,selected.node);target->provenance=selected.node;target->provenance_known=selected.known;}
ReferenceLoan *ReferenceNewSelected(ReferenceCheck *check,ReferenceLoan *source,Local *parent,I64 exclusive,I64 indirect,Node *expression,ReferenceLoan *next,Node *place,Local *via,Node *origin,Bool payload){ReferenceLoan selected,scoped=*source,*old=next,*loan;MemSet(&selected,0,sizeof(ReferenceLoan));selected.root=source->root;selected.exclusive=exclusive;selected.provenance_type=expression->type;scoped.exclusive&=exclusive;if(expression->kind==N_AGG_LITERAL && expression->op==1){scoped.provenance=NULL;scoped.provenance_known=0;}ReferenceSelectLoan(check,&selected,&scoped,place,via,origin,payload);while(old && old->expression==expression && !old->holder){if(old->root==source->root && old->parent==parent && old->exclusive==exclusive && old->indirect==indirect){ReferenceProvenanceJoin(check,old,&selected);return next;}old=old->next;}loan=ReferenceNew(check,source->root,parent,exclusive,indirect,expression,next);loan->provenance=selected.provenance;loan->provenance_known=selected.provenance_known;return loan;}
U0 ReferenceComputedGraph(ReferenceCheck *check,ReferenceLoan *loan,Node *place,Node *origin,Node *expression,I64 exclusive){ReferenceLoan source=*loan,target;source.exclusive&=exclusive;target=source;target.provenance_type=expression->type;ReferenceSelectLoan(check,&target,&source,place,NULL,origin,loan->indirect && NestedReference(expression->type));loan->provenance=target.provenance;loan->provenance_type=target.provenance_type;loan->provenance_known=target.provenance_known;}
Bool ReferencePathMayAccess(ReferenceLoan *source,ProvenanceCursor *path,I64 complete){ProvenanceQueryState *first,*tail,*current,*next;ProvenanceNode *node;ProvenanceCursor *cursor;ProvenanceEdge *edge;Bool found=FALSE;if(!complete)return TRUE;if(!source->provenance)return !source->provenance_known;first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->cursor=path;current=tail=first;while(current && !found){node=current->node;cursor=current->cursor;if(node->root==source->root && node->root)found=TRUE;else if(node->opaque || (cursor && node->type!=cursor->type))found=TRUE;else for(edge=node->edges;edge;edge=edge->next){if(!cursor)tail=ProvenanceQueryAppend(first,tail,edge->target,NULL,0);else if(edge->kind==cursor->kind && (cursor->kind!=1 || edge->key==cursor->key))tail=ProvenanceQueryAppend(first,tail,edge->target,cursor->next,0);}current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}return found;}
Bool ReferencePayloadMayAccess(ReferenceLoan *source,Node *place,Local *via){ReferenceCursor cursor;Bool found;if(!source->indirect || source->root==via)return TRUE;ReferencePlaceCursor(&cursor,place,via,NULL);found=ReferencePathMayAccess(source,cursor.path,cursor.complete);ReferenceCursorFree(cursor.path);return found;}
U0 ReferenceInstalledGraph(ReferenceLoan *output,ReferenceCheck *check,ReferenceLoan *source,I64 type,Node *destination,Bool opaque){ReferenceLoan result=*source;Node *place=destination;Local *via;ReferenceCursor cursor;ProvenanceCursor *path,*reverse=NULL,*step,*copy;ProvenanceNode *leaf;I64 leaf_type=source->provenance_type;Bool complete;result.provenance_type=type;if(!source->provenance && source->provenance_known){*output=result;return;}if(opaque){if(destination->kind==N_AGG_LITERAL && !destination->op)place=destination->a;else place=NULL;}via=BorrowRoot(place);ReferencePlaceCursor(&cursor,place,via,NULL);path=cursor.path;if(path && path->kind==3 && IsReference(path->type) && Shape(path->type)->element==type)path=path->next;complete=cursor.complete!=0;if(path && path->type!=type)complete=FALSE;if(!path && (!via || (via->type!=type && (!IsReference(via->type) || Shape(via->type)->element!=type))))complete=FALSE;leaf=source->provenance;if(opaque){leaf_type=Shape(destination->type)->element;leaf=ReferenceGraphValueNode(check->graph,leaf_type,source->root,ReferenceRootMode(source),1);}else if(!leaf && !source->provenance_known)leaf=ReferenceGraphValueNode(check->graph,leaf_type,source->root,ReferenceRootMode(source),1);if(complete && leaf){for(step=path;step;step=step->next){copy=CAlloc(sizeof(ProvenanceCursor));*copy=*step;copy->next=reverse;reverse=copy;}for(step=reverse;step;step=step->next)leaf=ReferenceGraphParent(check->graph,step->type,step->kind,step->key,leaf);ReferenceCursorFree(reverse);if(leaf->type!=type)complete=FALSE;}if(!complete)leaf=ReferenceGraphValueNode(check->graph,type,source->root,ReferenceRootMode(source),1);result.provenance=leaf;result.provenance_known=1;if(leaf)result.provenance_known=!leaf->opaque;ReferenceCursorFree(cursor.path);*output=result;return;}
U0 ReferenceReceiverGraph(ReferenceLoan *output,ReferenceCheck *check,ReferenceLoan *source,I64 type){ReferenceLoan result=*source;result.provenance_type=type;if(!result.provenance && source->provenance_known){*output=result;return;}if(!result.provenance)result.provenance=ReferenceGraphValueNode(check->graph,source->provenance_type,source->root,ReferenceRootMode(source),1);if(IsReference(type) && Shape(type)->element==source->provenance_type){result.provenance=ReferenceGraphParent(check->graph,type,3,0,result.provenance);result.provenance_known=1;}else{result.provenance=ReferenceGraphValueNode(check->graph,type,source->root,ReferenceRootMode(source),1);result.provenance_known=0;}*output=result;}

I64 ReferencePathWriteModes(ReferenceLoan *source,ProvenanceCursor *path,I64 complete){ProvenanceQueryState *first,*current,*tail,*next;ProvenanceNode *node;ProvenanceCursor *cursor;ProvenanceEdge *edge;I64 modes=0;if(!complete)return 4;if(!source->provenance){if(source->provenance_known)return 0;return 4;}first=CAlloc(sizeof(ProvenanceQueryState));first->node=source->provenance;first->cursor=path;first->exclusive=source->exclusive;current=tail=first;while(current){node=current->node;cursor=current->cursor;if(!cursor){}else if(node->opaque || node->type!=cursor->type)modes|=4;else if(node->root==source->root && node->root){if(current->exclusive & node->exclusive)modes|=1;else modes|=2;}else for(edge=node->edges;edge;edge=edge->next){if(edge->kind==cursor->kind && (cursor->kind!=1 || edge->key==cursor->key))tail=ProvenanceQueryAppend(first,tail,edge->target,cursor->next,current->exclusive & edge->exclusive);}current=current->next;}current=first;while(current){next=current->next;Free(current);current=next;}return modes;}
U0 ReferenceRequirePayloadWrite(ReferenceCheck *check,Node *place,Local *via){ReferenceCursor cursor;ReferenceLoan *source;Bool shared=FALSE;if(!ReferenceThroughStored(place))return;ReferencePlaceCursor(&cursor,place,via,NULL);for(source=check->loans;source;source=source->next)if(source->holder==via && source->indirect==1 && source->root && source->root!=via)if(ReferencePathWriteModes(source,cursor.path,cursor.complete)&2)shared=TRUE;ReferenceCursorFree(cursor.path);if(shared)ErrorAt(place->token,"cannot mutate or move through a shared reference");}
