ReferenceLoan *ReferenceNew(ReferenceCheck *check,Local *root,Local *parent,I64 exclusive,I64 indirect,Node *expression,ReferenceLoan *next){
    ReferenceLoan *loan,*old=next;
    while(old && old->expression==expression && !old->holder){if(old->root==root && old->parent==parent && old->exclusive==exclusive && old->indirect==indirect)return next;old=old->next;}
    loan=CAlloc(sizeof(ReferenceLoan));if(root){if(!check->graph)check->graph=CAlloc(sizeof(ProvenanceGraph));loan->provenance_type=root->type;if(expression)loan->provenance_type=expression->type;loan->provenance=ReferenceGraphLeaf(check->graph,loan->provenance_type,root,exclusive);loan->provenance_known=!loan->provenance->opaque;}loan->root=root;loan->parent=parent;loan->exclusive=exclusive;loan->indirect=indirect;loan->expression=expression;loan->next=next;return loan;
}
Node *ReferencePlaceSource(Node *place){
    if(!place)return NULL;if(place->kind==N_INDEX_ADDRESS && place->op==A_SLICE)return place->a;if(place->kind==N_OWN_ADDRESS && IsReference(place->a->type))return place->a;
