Bool IsReference(I64 type) { return AggregateKind(type)==6; }
I64 ReferenceType(Token *token) {
    I64 exclusive=0;
    if(Is("mut")){pos++;exclusive=1;}
    return SequenceType(6,ParseType(),exclusive,token);
}
Node *ReferenceExpression(Token *token) {
    I64 exclusive=Is("mut");if(exclusive)pos++;return ReferenceForPlace(Primary(),exclusive,token);
}
Node *ReferenceForPlace(Node *place,I64 exclusive,Token *token){
    Node *address=NULL,*result;
    if(exclusive && !place->mutable) ErrorAt(token,"exclusive borrow requires a mutable place");
    if(Borrowed(place->type) && !ReferenceStorage(place->type)) ErrorAt(token,"nested borrowed storage is not yet supported by scoped references");
    if(place->kind==N_LOCAL){address=NewNode(N_LOCAL_ADDRESS,token);address->slot=place->slot;address->local_ref=place->local_ref;address->type=T_PTR+place->type;}
    else {if(place->kind!=N_LOAD)ErrorAt(token,"reference operand must be a stable place");address=place->a;}
    if(!BorrowRoot(address) && !ReferencePlaceSource(address))ErrorAt(token,"reference requires a tracked local or parameter root");
    result=NewNode(N_AGG_LITERAL,token);result->type=SequenceType(6,place->type,exclusive,token);
    result->storage=Storage(result->type);result->a=address;result->origin_source=address;return result;
}
Node *ReferenceLoad(Node *value,Token *token){
    Node *address=NewNode(N_OWN_ADDRESS,token), *load=NewNode(N_LOAD,token);
    address->a=value;address->type=T_PTR+Shape(value->type)->element;
    load->a=address;load->origin_source=value;load->type=Shape(value->type)->element;load->mutable=Shape(value->type)->count;
    if(Aggregate(load->type))load->storage=Storage(load->type);return load;
}
Bool ContainsReference(I64 type){
    AggregateType *shape;Field *field;
    if(IsReference(type))return TRUE;if(!Aggregate(type))return FALSE;
    Layout(type);shape=Shape(type);
    if(shape->kind==A_ARRAY || shape->kind==A_SLICE)return ContainsReference(shape->element);
    if(shape->kind==A_OWNER)return FALSE;
    for(field=shape->fields;field;field=field->next)if(ContainsReference(field->type))return TRUE;
    return FALSE;
}
Bool TrackedBorrow(I64 type){return Borrowed(type)!=0;}
Bool ReferenceStorage(I64 type){
    AggregateType *shape;Field *field;
    if(IsReference(type))return !Borrowed(Shape(type)->element);
    if(!Aggregate(type))return TRUE;Layout(type);shape=Shape(type);
    if(shape->kind==A_SLICE)return !Borrowed(shape->element);if(shape->kind==A_OWNER)return TRUE;
    if(shape->kind==A_ARRAY)return ReferenceStorage(shape->element);
    for(field=shape->fields;field;field=field->next)if(!ReferenceStorage(field->type))return FALSE;
    return TRUE;
}
I64 ReferenceMode(I64 type){return BorrowTypeProperty(type,TRUE);}
U0 ValidateReferenceStorage(I64 type,Token *token){
    if(IsReference(type)){if(Borrowed(Shape(type)->element) && !ReferenceStorage(Shape(type)->element))ErrorAt(token,"nested borrowed storage is not yet supported by scoped references");}
    else if(ContainsReference(type) && !ReferenceStorage(type))ErrorAt(token,"stored references require single-layer aggregate storage");
}
U0 ReferenceMatchBinding(Node *binding){
    Local *local;if(!TrackedBorrow(binding->type))return;
    local=AllocateLocal();local->type=binding->type;local->slot=binding->slot;local->depth=depth;
    local->all_next=functions[current_fun].all_locals;functions[current_fun].all_locals=local;binding->local_ref=local;
}
ReferenceLoan *ReferenceHolder(ReferenceCheck *check,Local *holder,Local *root){
    ReferenceLoan *loan;for(loan=check->loans;loan;loan=loan->next)if(holder && loan->holder==holder && loan->root==root)return loan;return NULL;
}
Bool NestedReference(I64 type){return IsReference(type) && Borrowed(Shape(type)->element);}
Bool ReferenceThroughStored(Node *place){Node *current=place;I64 kind;while(current){kind=PlaceProjectionKind(current);if(kind==2 && current->op==A_SLICE)return TRUE;if(kind==3)return current->a->kind==N_LOAD;current=PlaceProjectionParent(current);}return FALSE;}
Bool ReferenceMatches(ReferenceCheck *check,Node *place,Local *via,Local *root,Bool writing){
    ReferenceLoan *loan;Bool through;I64 layer=0;
    if(via==root)return TRUE;through=ReferenceThroughStored(place);
    if(!IsReference(via->type) && AggregateKind(via->type)!=A_SLICE && !through)return FALSE;
    if(place->kind==N_LOCAL_ADDRESS || place->kind==N_ASSIGN)return FALSE;
    if(NestedReference(via->type) && through)layer=1;
    for(loan=check->loans;loan;loan=loan->next)if(loan->holder==via && loan->indirect==layer && loan->root==root && (!writing || loan->exclusive) && ReferencePayloadMayAccess(loan,place,via))return TRUE;
    return FALSE;
}
// Query-local visited queue follows every parent and clears marks on all exits.
Bool ReferenceAncestor(ReferenceCheck *check,Local *holder,Local *via,Local *root){
    Local *current,*tail,*parent,*next;ReferenceLoan *loan;Bool found=FALSE;
    if(!holder || !via)return FALSE;
    current=tail=via;via->reference_visit=1;via->reference_next=NULL;
    while(current){
        if(current==holder){found=TRUE;break;}
        for(loan=check->loans;loan;loan=loan->next)if(loan->holder==current && loan->root==root && loan->parent && !loan->parent->reference_visit){
            parent=loan->parent;parent->reference_visit=1;parent->reference_next=NULL;tail->reference_next=parent;tail=parent;
        }
        current=current->reference_next;
    }
    current=via;while(current){next=current->reference_next;current->reference_visit=0;current->reference_next=NULL;current=next;}
    return found;
}
extern U0 ReferenceAccess(ReferenceCheck *check,Node *place,Bool writing);
U0 ReferenceHandleAccess(ReferenceCheck *check,Node *place){Local *via=BorrowRoot(place);ReferenceLoan *loan;if(!via || place->kind!=N_LOCAL || !IsReference(via->type)){ReferenceAccess(check,place,FALSE);return;}for(loan=check->loans;loan;loan=loan->next)if(loan->root==via && loan->exclusive && ReferencePhysicalMayOverlap(check,loan,place,via) && !ReferenceAncestor(check,loan->holder,via,via) && !(loan->holder==NULL && loan->expression==ReferencePlaceSource(place)))ErrorAt(place->token,"access conflicts with a live scoped reference");}
extern U0 ReferenceAccessMode(ReferenceCheck *check,Node *place,Bool writing,Bool owner_slot);
U0 ReferenceAccess(ReferenceCheck *check,Node *place,Bool writing){ReferenceAccessMode(check,place,writing,FALSE);}
U0 ReferenceAccessMode(ReferenceCheck *check,Node *place,Bool writing,Bool owner_slot){
    Local *via=BorrowRoot(place);ReferenceLoan *loan;Node *origin=ReferencePlaceSource(place);if(writing && !via && origin && origin->kind!=N_LOCAL)ReferenceRequireComputedAuthority(check,place,origin,FALSE);if(!via)return;
