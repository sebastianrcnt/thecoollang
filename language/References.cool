    ReferenceLoan *loan;for(loan=before;loan;loan=loan->next)if(loan->root==root && (exclusive || loan->exclusive) && (!physical || !loan->physical_provenance || ProvenanceAddressOverlap(loan->physical_provenance,physical,root)) && !ReferenceAncestor(check,loan->holder,via,root) && !(loan->holder==NULL && loan->expression==origin))ErrorAt(token,"access conflicts with a live scoped reference");
}
extern U0 ReferenceAcquireMode(ReferenceCheck *check,Node *place,I64 exclusive,Token *token,Node *expression,Bool owner_slot);
U0 ReferenceAcquire(ReferenceCheck *check,Node *place,I64 exclusive,Token *token,Node *expression){ReferenceAcquireMode(check,place,exclusive,token,expression,FALSE);}
