U0 ReferenceAcquireMode(ReferenceCheck *check,Node *place,I64 exclusive,Token *token,Node *expression,Bool owner_slot){
    Local *via=BorrowRoot(place);ReferenceLoan *source,*before,selected_source;Node *origin;I64 layer=0,mode,indirect;
    Bool nested=NestedReference(expression->type),found=FALSE,address,bridge,through,physical,preserve;
    origin=ReferencePlaceSource(place);
