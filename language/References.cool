        for(source=check->loans;source;source=source->next)if(origin && source->expression==origin && !source->holder && (!(expression->kind==N_LOCAL || expression->kind==N_LOAD || expression->kind==N_MOVE) || !NestedReference(origin->type) || nested || source->indirect)){
