    if(node->kind==N_BIND && TrackedBorrow(node->type)){ReferenceValue(check,node->a);link=&check->loans;while(*link!=saved){loan=*link;if(loan->expression==node->a){loan->holder=node->local_ref;link=&loan->next;}else{*link=loan->next;Free(loan);}}loan=ReferenceNew(check,NULL,NULL,0,0,node,check->loans);loan->holder=node->local_ref;check->loans=loan;return;}
    if(node->kind==N_ASSIGN){ReferenceValue(check,node->a);ReferenceAccess(check,node,TRUE);if(TrackedBorrow(node->type))ReferenceAssign(check,node->local_ref,node->a,saved);}
    else if(node->kind==N_STORE){ReferenceWriteCapability(node->a);ReferenceAddressMode(check,node->a,FALSE);ReferenceValue(check,node->b);ReferenceAccess(check,node->a,TRUE);if(TrackedBorrow(node->type)){ReferenceStore(check,node->a,node->b,saved);}}
    else if(node->kind==N_IF || node->kind==N_WHILE || node->kind==N_FOR){ReferenceValue(check,node->a);ReferenceRelease(check,saved);ReferenceStatement(check,node->b);ReferenceStatement(check,node->c);}
    else ReferenceValue(check,node->a);
    if(node->kind==N_RETURN && IsReference(check->function->result))ReferenceCheckReturn(check,node->a,saved);
    if(node->kind!=N_DEFER)ReferenceRelease(check,saved);
}
U0 AnalyzeReferences(Function *function){ReferenceCheck *check=CAlloc(sizeof(ReferenceCheck));check->function=function;check->next=reference_checks;reference_checks=check;ReferenceParameters(check);ReferenceStatement(check,function->body);reference_checks=check->next;ReferenceCheckFree(check);}
Node *RawReferenceExpression(){
    Token *token=At();I64 type;Node *pointer,*anchor,*result;pos++;
    if(!unsafe_depth)ErrorAt(token,"borrow_raw requires unsafe");
    Need('[',"expected '[' after borrow_raw");type=ParseType();Need(']',"expected ']'");
    if(!IsReference(type))ErrorAt(token,"borrow_raw requires a reference result type");ValidateReferenceStorage(type,token);
    Need('(',"expected '('");pointer=Expr(1);Need(',',"expected anchor argument");anchor=Expr(1);Need(')',"expected ')'");
    if(pointer->type!=T_PTR+Shape(type)->element)ErrorAt(token,"borrow_raw pointer element type mismatch");
    if(anchor->kind!=N_LOCAL || !IsReference(anchor->type))ErrorAt(token,"borrow_raw anchor must be a named reference");
    if(Shape(type)->count>Shape(anchor->type)->count)ErrorAt(token,"exclusive reference requires an exclusive anchor");
    result=NewNode(N_AGG_LITERAL,token);result->type=type;result->storage=Storage(type);result->op=1;result->a=pointer;result->origin_source=anchor;return result;
}
Node *ReferencePointerCast(Node *value,I64 type,Token *token){
    Node *result;if(!unsafe_depth)ErrorAt(token,"reference pointer casts require unsafe");
    if(type!=T_PTR+Shape(value->type)->element)ErrorAt(token,"reference pointer cast element type mismatch");
    result=NewNode(N_OWN_ADDRESS,token);result->a=value;result->type=type;result->op=1;return result;
}

// Slice descriptors and their elements have separate physical/payload loans.
U0 ReferenceSliceValue(ReferenceCheck *check,Node *node,Bool writing){
    if(node->kind==N_LOCAL){ReferenceAccess(check,node,FALSE);return;}
    if(node->kind==N_LOAD){
        ReferenceAddressMode(check,node->a,FALSE);ReferenceAccess(check,node->a,FALSE);
        if(BorrowRoot(node->a))ReferenceAcquire(check,node->a,writing,node->token,node);
        else ReferenceProjection(check,node,writing);
        return;
    }
    ReferenceValue(check,node);
}
Bool ReferenceLength(ReferenceCheck *check,Node *node){
    Local *via;ReferenceLoan *loan;
    if(AggregateKind(node->type)!=A_SLICE)return FALSE;
    if(node->kind==N_LOCAL){
        via=node->local_ref;
        for(loan=check->loans;loan;loan=loan->next)if(loan->root==via && loan->exclusive && !ReferenceAncestor(check,loan->holder,via,via))ErrorAt(node->token,"access conflicts with a live scoped reference");
        return TRUE;
    }
    if(node->kind==N_LOAD){ReferenceAddressMode(check,node->a,FALSE);ReferenceAccess(check,node->a,FALSE);return TRUE;}
    return FALSE;
}

U0 ReferenceWriteCapability(Node *place){Node *current=place;while(current){if(PlaceProjectionKind(current)==3 && !Shape(current->a->type)->count)ErrorAt(current->token,"cannot mutate or move through a shared reference");current=PlaceProjectionParent(current);}}

// Handwritten mirrors of typed acquisition routing and caller lifetime checks.

U0 ReferenceCheckReturn(ReferenceCheck *check,Node *value,ReferenceLoan *stop){ReferenceLoan *loan;Local *root;Bool found=FALSE;for(loan=check->loans;loan!=stop;loan=loan->next)if(loan->expression==value && !loan->holder && loan->root){root=loan->root;found=TRUE;if(!root->reference_external || root->depth || !root->place_region || (root->place_region&~check->function->borrow_contract))ErrorAt(value->token,"returned borrow may outlive local storage or violate its borrows contract");}if(!found)ErrorAt(value->token,"returned borrow may outlive local storage or violate its borrows contract");}
