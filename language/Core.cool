class Local { U8 *name; I64 type, slot, mutable, depth, region, moved, loop_level; Local *next, *all_next, *repl_next; I64 repl_mark; U8 *sources; };
class Node { I64 kind, type, value, op, slot, storage, offset, mutable, field_key; Token *token; U8 *name; Node *a, *b, *c, *next, *origin_source; Local *local_ref; };
class ReplNode { Node value; ReplNode *next; };
ReplNode *repl_nodes;
Local *repl_allocated_locals;
class DropSlot { I64 slot, type; DropSlot *next; };
class ByteAllocation { ByteAllocation *next; };
class Function {
    U8 *name, *package; I64 result, argc, slots, begin, end, public, foreign, exported, generic_count, origin, signature, borrow_contract, has_contract; Local *all_locals,*allocated_locals; ReplNode *nodes; DropSlot *drops;
    U8 *generic_names[8]; I64 generic_args[8];
    U8 *bytecode, *machine; ByteAllocation *byte_allocations; I64 code_count, code_capacity, registers, calls, machine_size;
    U8 *arg_names[32]; I64 arg_types[32]; Node *body; Token *token;
};
#define MAX_FUNCTIONS 4096
Function *functions;
I64 nfun;
Local *locals;
I64 depth, loop_depth, current_fun, unsafe_depth;
U8 *LiteralString(U8 *text) {
    U64 hash=5381;I64 i=0,bucket;ReplLiteral *entry;
    if(!allow_redefinition || current_fun!=0)return text;
    while(text[i])hash=hash*33+text[i++];bucket=hash&1023;
    for(entry=repl_literals[bucket];entry;entry=entry->next)if(Eq(entry->text,text))return entry->text;
    entry=CAlloc(sizeof(ReplLiteral));entry->text=StrNew(text);entry->next=repl_literals[bucket];repl_literals[bucket]=entry;return entry->text;
}
Local *AllocateLocal() {
    Local *local=CAlloc(sizeof(Local));
    if(allow_redefinition){if(current_fun==0){local->repl_next=repl_allocated_locals;repl_allocated_locals=local;}else{local->repl_next=functions[current_fun].allocated_locals;functions[current_fun].allocated_locals=local;}}
    return local;
}
Node *AllocateNode() {
    ReplNode *allocation;
    if(!allow_redefinition)return CAlloc(sizeof(Node));
    allocation=CAlloc(sizeof(ReplNode));
    if(current_fun==0){allocation->next=repl_nodes;repl_nodes=allocation;}else{allocation->next=functions[current_fun].nodes;functions[current_fun].nodes=allocation;}
    return &allocation->value;
}
Node *NewNode(I64 kind, Token *t) { Node *n = AllocateNode(); n->kind = kind; n->token = t; n->slot = -1; return n; }
I64 FindFunIn(U8 *package, U8 *name) { I64 i; for (i = 0; i < nfun; i++) if (!functions[i].origin && Eq(functions[i].package, package) && Eq(functions[i].name, name)) return i; return -1; }
I64 FindFun(U8 *name) { return FindFunIn("__main", name); }
class Alias { U8 *file, *name, *path; Alias *next; };
Alias *aliases;
U8 *ResolveAlias(Token *t, U8 *name) {
    Alias *a = aliases;
    while (a) { if (Eq(a->file, t->file) && Eq(a->name, name)) return a->path; a = a->next; }
    ErrorAt(t, "unknown imported package alias"); return NULL;
}
U0 AddAlias(Token *t, U8 *name, U8 *path) {
    Alias *a = aliases;
    while (a) { if (Eq(a->file, t->file) && Eq(a->name, name)) ErrorAt(t, "duplicate import alias"); a = a->next; }
    a = CAlloc(sizeof(Alias)); a->file = t->file; a->name = name; a->path = path; a->next = aliases; aliases = a;
}
Local *FindLocal(U8 *name) { Local *l = locals; while (l) { if (Eq(l->name, name)) return l; l = l->next; } return NULL; }
extern I64 TypeSlots(I64 type);
extern Bool Owned(I64 type);
U0 RegisterDrop(I64 slot, I64 type) { DropSlot *d; if (!Owned(type)) return; d = CAlloc(sizeof(DropSlot)); d->slot = slot; d->type = type; d->next = functions[current_fun].drops; functions[current_fun].drops = d; }
Local *AddLocal(U8 *name, I64 type, Bool mutable) {
    Local *l = locals, *res;
    while (l && l->depth == depth) { if (Eq(l->name, name)) Error("duplicate local declaration"); l = l->next; }
    res = AllocateLocal(); res->name = name; if(allow_redefinition && current_fun==0)res->name=StrNew(name); res->type = type; res->mutable = mutable; res->depth = depth; res->loop_level = loop_depth;
    res->slot = functions[current_fun].slots; functions[current_fun].slots += TypeSlots(type); if (functions[current_fun].slots > 65536) Error("function storage limit exceeded"); res->next = locals; locals = res; RegisterDrop(res->slot, type); res->all_next = functions[current_fun].all_locals; functions[current_fun].all_locals = res; return res;
}
Bool Integer(I64 type) { return type == T_INT || type == T_I32 || (T_U8 <= type <= T_U64); }
Bool Pointer(I64 type) { return type >= T_PTR; }
class Field { U8 *name; I64 type, offset, public, tag; Field *next; };
class AggregateType { U8 *name, *package; I64 kind, element, count, size, align, state, begin, end, public, generic_count, origin; U8 *generic_names[8]; I64 generic_args[8]; Token *token; Token diagnostic; Field *fields; };
#define MAX_TYPES 4096
AggregateType aggregate_types[MAX_TYPES];
I64 naggregates;
Bool Aggregate(I64 type) { return T_AGG <= type < T_AGG + naggregates; }
AggregateType *Shape(I64 type) { return &aggregate_types[type - T_AGG]; }
extern U0 Layout(I64 type);
I64 Storage(I64 type) { I64 slot = functions[current_fun].slots; functions[current_fun].slots += TypeSlots(type); if (functions[current_fun].slots > 65536) Error("function storage limit exceeded"); RegisterDrop(slot, type); return slot; }
I64 AggregateKind(I64 type) { if (!Aggregate(type)) return 0; return Shape(type)->kind; }

Bool Floating(I64 type) { return type == T_F64 || type == T_F32; }
Bool Numeric(I64 type) { return Integer(type) || Floating(type); }
Bool Unsigned(I64 type) { return type == T_U8 || type == T_U16 || type == T_U32 || type == T_U64; }
I64 Width(I64 type) {
    if (type == T_I8 || type == T_U8) return 8;
    if (type == T_I16 || type == T_U16) return 16;
    if (type == T_I32 || type == T_U32) return 32;
    return 64;
}
I64 ByteSize(I64 type) { if (Aggregate(type)) { Layout(type); return Shape(type)->size; } if (type == T_VOID) return 0; if (type == T_BOOL) return 1; if (type == T_F32) return 4; if (type == T_F64 || Pointer(type)) return 8; return Width(type) / 8; }
I64 TypeSlots(I64 type) { I64 size = ByteSize(type); if (!size) return 1; return (size + 7) / 8; }
Bool Fits(I64 v, I64 type) {
    I64 width = Width(type);
    if (Unsigned(type)) { if (v < 0) return FALSE; if (width == 64) return TRUE; return v < (1 << width); }
    if (width == 64) return TRUE;
    return -(1 << (width - 1)) <= v < (1 << (width - 1));
}
U0 Coerce(Node *n, I64 type) {
    Node *child;
    if (n->type == type) return;
    if (n->type == T_NULL && Pointer(type)) { n->type = type; return; }
    if (Pointer(n->type) && type == T_PTR) { child = AllocateNode(); MemCpy(child, n, sizeof(Node)); child->next = NULL; n->kind = N_CAST; n->a = child; n->type = type; return; }
    if ((n->type == T_F32 && type == T_F64) || (n->kind == N_INT && Integer(n->type) && Floating(type) && -16777216 <= n->value <= 16777216)) {
        child = AllocateNode(); MemCpy(child, n, sizeof(Node)); child->next = NULL;
        n->kind = N_CAST; n->a = child; n->type = type; return;
    }
    if (Integer(n->type) && Integer(type)) {
        if (n->kind == N_INT && !(Unsigned(n->type) && n->value < 0 && type != T_U64) && Fits(n->value, type)) { n->type = type; return; }
        if ((Unsigned(type) == Unsigned(n->type) && Width(type) > Width(n->type)) || (!Unsigned(type) && Unsigned(n->type) && Width(type) > Width(n->type))) {
            child = AllocateNode(); MemCpy(child, n, sizeof(Node)); child->next = NULL;
            n->kind = N_CAST; n->a = child; n->type = type; return;
        }
    }
    ErrorAt(n->token, "incompatible types; use an explicit cast for narrowing conversions");
}

