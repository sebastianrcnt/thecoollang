// LLVM IR emission shares the typed nodes with the interpreter.
class EDeferred { Node *call; I64 *args; EDeferred *next; };
class EScope { EDeferred *calls; EScope *parent; };
Text *ir, *globals;
I64 reg_id, label_id, string_id, loop_break, loop_continue, active_label;
EScope *scope, *loop_scope;
Bool terminated;
U0 IR(U8 *s) { Append(ir, s); }
U0 RI(I64 n) { Number(ir, n); }
U0 Reg(I64 r) { IR("%r"); RI(r); }
I64 Fresh() { return ++reg_id; }
I64 Label() { return ++label_id; }
U0 AtLabel(I64 label) { active_label = label; IR("L"); RI(label); IR(":\n"); terminated = FALSE; }
U0 Jump(I64 label) { IR("  br label %L"); RI(label); IR("\n"); terminated = TRUE; }
I64 Constant(I64 value) { I64 r = Fresh(); IR("  "); Reg(r); IR(" = add i64 0, "); RI(value); IR("\n"); return r; }
I64 Truth(I64 r) { I64 b = Fresh(); IR("  %b"); RI(b); IR(" = icmp ne i64 "); Reg(r); IR(", 0\n"); return b; }
U0 Branch(I64 value, I64 yes, I64 no) {
    I64 b = Truth(value); IR("  br i1 %b"); RI(b); IR(", label %L"); RI(yes); IR(", label %L"); RI(no); IR("\n"); terminated = TRUE;
}
I64 Truncate(I64 r, I64 type) {
    I64 n, width;
    if (!Integer(type) || Width(type) == 64) return r;
    width = Width(type);
    n = Fresh(); IR("  %t"); RI(n); IR(" = trunc i64 "); Reg(r); IR(" to i"); RI(width); IR("\n  "); Reg(n);
    if (Unsigned(type)) IR(" = zext i"); else IR(" = sext i");
    RI(width); IR(" %t"); RI(n); IR(" to i64\n"); return n;
}
I64 LocalRead(I64 r, I64 type) {
    I64 n;
    if (type != T_F32) return Truncate(r, type);
    n = Fresh(); IR("  %raw"); RI(n); IR(" = trunc i64 "); Reg(r); IR(" to i32\n  %single"); RI(n); IR(" = bitcast i32 %raw"); RI(n); IR(" to float\n  %double"); RI(n); IR(" = fpext float %single"); RI(n); IR(" to double\n  "); Reg(n); IR(" = bitcast double %double"); RI(n); IR(" to i64\n"); return n;
}
I64 LocalWrite(I64 r, I64 type) {
    I64 n;
    if (type != T_F32) return r;
    n = Fresh(); IR("  %double"); RI(n); IR(" = bitcast i64 "); Reg(r); IR(" to double\n  %single"); RI(n); IR(" = fptrunc double %double"); RI(n); IR(" to float\n  %raw"); RI(n); IR(" = bitcast float %single"); RI(n); IR(" to i32\n  "); Reg(n); IR(" = zext i32 %raw"); RI(n); IR(" to i64\n"); return n;
}
I64 SlotAddress(I64 slot) { I64 r = Fresh(); IR("  "); Reg(r); IR(" = ptrtoint ptr %v"); RI(slot); IR(" to i64\n"); return r; }
U0 EmitCopy(I64 destination, I64 source, I64 type) { IR("  call void @cool_copy(i64 "); Reg(destination); IR(", i64 "); Reg(source); IR(", i64 "); RI(ByteSize(type)); IR(")\n"); }
U0 EmitWrite(I64 destination, I64 source, I64 type) {
    if (Aggregate(type)) { EmitCopy(destination, source, type); return; }
    IR("  call void @cool_store(i64 "); Reg(destination); IR(", i64 "); RI(type); IR(", i64 "); Reg(source); IR(")\n");
}
I64 EmitRead(I64 address, I64 type, I64 storage) {
    I64 r;
    if (Aggregate(type)) { r = SlotAddress(storage); EmitCopy(r, address, type); return r; }
    r = Fresh(); IR("  "); Reg(r); IR(" = call i64 @cool_load(i64 "); Reg(address); IR(", i64 "); RI(type); IR(")\n"); return r;
}
I64 OffsetAddress(I64 address, I64 offset) { I64 r = Fresh(); IR("  "); Reg(r); IR(" = add i64 "); Reg(address); IR(", "); RI(offset); IR("\n"); return r; }
I64 EmitLength(I64 address, I64 count, I64 kind) {
    I64 r = Fresh(); IR("  "); Reg(r); IR(" = call i64 @cool_length(i64 "); Reg(address); IR(", i64 "); RI(count); IR(", i64 "); RI(kind == A_SLICE); IR(")\n"); return r;
}
extern I64 EmitExpr(Node *n);
I64 *EmitArgs(Node *n) {
    I64 *args = CAlloc((n->value + 1) * 8), i = 0; Node *a = n->a;
    while (a) { args[i++] = EmitExpr(a); a = a->next; } return args;
}
I64 EmitCall(Node *n, I64 *args) {
    I64 r, i, destination;
    if (n->slot == -1) {
        IR("  call void @cool_print(i64 "); Reg(args[0]); IR(", i64 "); RI(n->a->type); IR(", i64 "); RI(Eq(n->name, "println")); IR(")\n"); return Constant(0);
    }
    if (n->slot == -3) { r = Fresh(); IR("  "); Reg(r); IR(" = call i64 @cool_alloc(i64 "); Reg(args[0]); IR(")\n"); return r; }
    if (n->slot == -4) { IR("  call void @cool_free(i64 "); Reg(args[0]); IR(")\n"); return Constant(0); }
    if (n->slot == -5) { IR("  call void @cool_copy(i64 "); Reg(args[0]); IR(", i64 "); Reg(args[1]); IR(", i64 "); Reg(args[2]); IR(")\n"); return Constant(0); }
    if (n->slot == -2) { IR("  call void @cool_assert(i64 "); Reg(args[0]); IR(")\n"); return Constant(0); }
    if (Aggregate(n->type)) destination = SlotAddress(n->storage);
    r = Fresh(); IR("  "); Reg(r); IR(" = call i64 @__cool_fn"); RI(n->slot); IR("(");
    if (Aggregate(n->type)) { IR("i64 "); Reg(destination); }
    for (i = 0; i < n->value; i++) { if (i || Aggregate(n->type)) IR(", "); IR("i64 "); Reg(args[i]); }
    IR(")\n"); return r;
}
U0 EmitCleanup(EScope *until) {
    EScope *s = scope; EDeferred *d;
    while (s != until) { d = s->calls; while (d) { EmitCall(d->call, d->args); d = d->next; } s = s->parent; }
}
I64 EmitExpr(Node *n) {
    I64 a, b, r, casted, op, yes, no, end, id, i, ch, predecessor, *args; U8 *instruction = NULL, *hex = "0123456789ABCDEF"; Node *item;
    if (n->kind == N_INT) return Constant(n->value);
    if (n->kind == N_STRING) {
        id = ++string_id; Append(globals, "@s"); Number(globals, id); Append(globals, " = private constant ["); Number(globals, StrLen(n->name) + 1); Append(globals, " x i8] c\"");
        for (i = 0; n->name[i]; i++) { ch = n->name[i]; Char(globals, '\\'); Char(globals, hex[ch >> 4]); Char(globals, hex[ch & 15]); }
        Append(globals, "\\00\"\n"); r = Fresh(); IR("  "); Reg(r); IR(" = ptrtoint ptr @s"); RI(id); IR(" to i64\n"); return r;
    }
    if (n->kind == N_AGG_LITERAL) {
        r = SlotAddress(n->storage); IR("  call void @cool_zero(i64 "); Reg(r); IR(", i64 "); RI(ByteSize(n->type)); IR(")\n");
        for (item = n->a; item; item = item->next) { a = EmitExpr(item); b = OffsetAddress(r, item->offset); EmitWrite(b, a, item->type); } return r;
    }
    if (n->kind == N_LOCAL) { if (Aggregate(n->type)) return EmitRead(SlotAddress(n->slot), n->type, n->storage); r = Fresh(); IR("  "); Reg(r); IR(" = load i64, ptr %v"); RI(n->slot); IR("\n"); return LocalRead(r, n->type); }
    if (n->kind == N_LOCAL_ADDRESS) { r = Fresh(); IR("  "); Reg(r); IR(" = ptrtoint ptr %v"); RI(n->slot); IR(" to i64\n"); return r; }
    if (n->kind == N_CALL) { args = EmitArgs(n); r = EmitCall(n, args); Free(args); return r; }
    a = EmitExpr(n->a);
    if (n->kind == N_LOAD) return EmitRead(a, n->type, n->storage);
    if (n->kind == N_FIELD_ADDRESS) return OffsetAddress(a, n->value);
    if (n->kind == N_LENGTH) return EmitLength(a, Shape(n->a->type)->count, AggregateKind(n->a->type));
    if (n->kind == N_INDEX_ADDRESS) {
        b = EmitExpr(n->b); r = Fresh(); IR("  "); Reg(r); IR(" = call i64 @cool_index(i64 "); Reg(a); IR(", i64 "); Reg(b); IR(", i64 "); RI(n->value); IR(", i64 "); RI(ByteSize(n->type-T_PTR)); IR(", i64 "); RI(n->op == A_SLICE); IR(")\n"); return r;
    }
    if (n->kind == N_SLICE) {
        b = EmitExpr(n->b); if (n->c) casted = EmitExpr(n->c); else casted = EmitLength(a, n->value, n->op);
        r = SlotAddress(n->storage); IR("  call void @cool_slice(i64 "); Reg(r); IR(", i64 "); Reg(a); IR(", i64 "); Reg(b); IR(", i64 "); Reg(casted); IR(", i64 "); RI(n->value); IR(", i64 "); RI(ByteSize(Shape(n->type)->element)); IR(", i64 "); RI(n->op == A_SLICE); IR(")\n"); return r;
    }
    if (n->kind == N_ADDRESS) {
        b = EmitExpr(n->b); casted = Fresh(); IR("  "); Reg(casted); IR(" = mul i64 "); Reg(b); IR(", "); RI(ByteSize(n->type - T_PTR)); IR("\n");
        r = Fresh(); IR("  "); Reg(r); if (n->op == '-') IR(" = sub i64 "); else IR(" = add i64 "); Reg(a); IR(", "); Reg(casted); IR("\n"); return r;
    }
    if (n->kind == N_CAST) {
        if (!Floating(n->type) && !Floating(n->a->type)) return Truncate(a, n->type);
        r = Fresh(); IR("  "); Reg(r); IR(" = call i64 @cool_cast(i64 "); Reg(a); IR(", i64 "); RI(n->a->type); IR(", i64 "); RI(n->type); IR(")\n"); return r;
    }
    op = n->op;
    if (n->kind == N_UNARY && Floating(n->type)) {
        r = Fresh(); IR("  "); Reg(r); IR(" = xor i64 "); Reg(a); IR(", -9223372036854775808\n"); return r;
    }
    if (n->kind == N_UNARY) {
        r = Fresh(); IR("  "); Reg(r);
        if (op == '!') { IR(" = xor i64 "); Reg(a); IR(", 1\n"); }
        else if (op == '~') { IR(" = xor i64 "); Reg(a); IR(", -1\n"); }
        else { IR(" = sub i64 0, "); Reg(a); IR("\n"); }
        return Truncate(r, n->type);
    }
    if (op == K_AND || op == K_OR) {
        yes = Label(); no = Label(); end = Label();
        if (op == K_AND) Branch(a, yes, no); else Branch(a, no, yes);
        AtLabel(yes); b = EmitExpr(n->b); predecessor = active_label; Jump(end);
        AtLabel(no); Jump(end); AtLabel(end); r = Fresh();
        IR("  "); Reg(r); IR(" = phi i64 [ "); Reg(b); IR(", %L"); RI(predecessor);
        IR(" ], [ "); RI(op == K_OR); IR(", %L"); RI(no); IR(" ]\n"); return r;
    }
    b = EmitExpr(n->b); r = Fresh();
    if (Floating(n->a->type)) {
        IR("  %fa"); RI(r); IR(" = bitcast i64 "); Reg(a); IR(" to double\n  %fb"); RI(r); IR(" = bitcast i64 "); Reg(b); IR(" to double\n");
        switch (op) {
            case '+': instruction = "fadd"; break; case '-': instruction = "fsub"; break;
            case '*': instruction = "fmul"; break; case '/': instruction = "fdiv"; break;
            case K_EQ: instruction = "fcmp oeq"; break; case K_NE: instruction = "fcmp une"; break;
            case '<': instruction = "fcmp olt"; break; case '>': instruction = "fcmp ogt"; break;
            case K_LE: instruction = "fcmp ole"; break; case K_GE: instruction = "fcmp oge"; break;
        }
        IR("  %fr"); RI(r); IR(" = "); IR(instruction); IR(" double %fa"); RI(r); IR(", %fb"); RI(r); IR("\n  "); Reg(r);
        if (n->type == T_BOOL) { IR(" = zext i1 %fr"); RI(r); IR(" to i64\n"); }
        else { IR(" = bitcast double %fr"); RI(r); IR(" to i64\n"); }
        if (n->type == T_F32) {
            casted = Fresh(); IR("  "); Reg(casted); IR(" = call i64 @cool_cast(i64 "); Reg(r); IR(", i64 11, i64 12)\n"); return casted;
        }
        return r;
    }
    if (op == '/' || op == '%' || op == K_SHL || op == K_SHR) {
        IR("  "); Reg(r); IR(" = call i64 @");
        if (op == '/' || op == '%') IR("cool_div"); else IR("cool_shift");
        IR("(i64 "); Reg(a); IR(", i64 "); Reg(b); IR(", i64 "); RI(op == '%' || op == K_SHR); IR(", i64 "); RI(Unsigned(n->a->type)); IR(", i64 "); RI(Width(n->a->type)); IR(")\n"); return Truncate(r, n->type);
    }
    switch (op) {
        case '+': instruction = "add"; break; case '-': instruction = "sub"; break;
        case '*': instruction = "mul"; break; case '&': instruction = "and"; break;
        case '|': instruction = "or"; break; case '^': instruction = "xor"; break;
    }
    if (instruction) {
        IR("  "); Reg(r); IR(" = "); IR(instruction); IR(" i64 "); Reg(a); IR(", "); Reg(b); IR("\n"); return Truncate(r, n->type);
    }
    switch (op) {
        case K_EQ: instruction = "eq"; break; case K_NE: instruction = "ne"; break;
        case '<': instruction = "slt"; break; case '>': instruction = "sgt"; break;
        case K_LE: instruction = "sle"; break; case K_GE: instruction = "sge"; break;
    }
    if (Unsigned(n->a->type)) {
        if (op == '<') instruction = "ult"; if (op == '>') instruction = "ugt";
        if (op == K_LE) instruction = "ule"; if (op == K_GE) instruction = "uge";
    }
    IR("  %b"); RI(r); IR(" = icmp "); IR(instruction); IR(" i64 "); Reg(a); IR(", "); Reg(b); IR("\n  ");
    Reg(r); IR(" = zext i1 %b"); RI(r); IR(" to i64\n"); return r;
}
U0 EmitStmt(Node *n) {
    Node *s; EScope *saved, *saved_loop; EDeferred *d; I64 r, value, yes, no, end, cond, update, saved_break, saved_continue; Bool left_done;
    if (!n || terminated) return;
    switch (n->kind) {
        case N_BLOCK:
            saved = scope; scope = CAlloc(sizeof(EScope)); scope->parent = saved;
            s = n->a;
            while (s && !terminated) {
                if (s->kind == N_DEFER) { d = CAlloc(sizeof(EDeferred)); d->call = s->a; d->args = EmitArgs(s->a); d->next = scope->calls; scope->calls = d; }
                else EmitStmt(s);
                s = s->next;
            }
            if (!terminated) EmitCleanup(saved);
            scope = saved; break;
        case N_STORE:
            r = EmitExpr(n->a); value = EmitExpr(n->b); EmitWrite(r, value, n->type); break;
        case N_BIND: case N_ASSIGN:
            if (Aggregate(n->type)) { r = EmitExpr(n->a); EmitCopy(SlotAddress(n->slot), r, n->type); break; }
            r = LocalWrite(EmitExpr(n->a), n->type); IR("  store i64 "); Reg(r); IR(", ptr %v"); RI(n->slot); IR("\n"); break;
        case N_EXPR: EmitExpr(n->a); break;
        case N_RETURN:
            r = Constant(0); if (n->a) r = EmitExpr(n->a);
            if (n->a && Aggregate(n->a->type)) { value = Fresh(); IR("  "); Reg(value); IR(" = add i64 0, %result\n"); EmitCopy(value, r, n->a->type); r = value; }
            EmitCleanup(NULL); IR("  ret i64 "); Reg(r); IR("\n"); terminated = TRUE; break;
        case N_IF:
            r = EmitExpr(n->a); yes = Label(); no = Label(); end = Label(); Branch(r, yes, no);
            AtLabel(yes); EmitStmt(n->b); left_done = terminated; if (!terminated) Jump(end);
            AtLabel(no); EmitStmt(n->c);
            if (left_done && terminated) break;
            if (!terminated) Jump(end); AtLabel(end); break;
        case N_FOR: case N_WHILE:
            cond = Label(); yes = Label(); end = Label(); update = Label(); Jump(cond); AtLabel(cond);
            r = EmitExpr(n->a); Branch(r, yes, end); AtLabel(yes);
            saved_break = loop_break; saved_continue = loop_continue; saved_loop = loop_scope;
            loop_break = end; loop_continue = cond; if (n->kind == N_FOR) loop_continue = update; loop_scope = scope; EmitStmt(n->b);
            loop_break = saved_break; loop_continue = saved_continue; loop_scope = saved_loop;
            if (n->kind == N_FOR) { if (!terminated) Jump(update); AtLabel(update); EmitStmt(n->c); }
            if (!terminated) Jump(cond); AtLabel(end); break;
        case N_BREAK: EmitCleanup(loop_scope); Jump(loop_break); break;
        case N_CONTINUE: EmitCleanup(loop_scope); Jump(loop_continue); break;
    }
}
#include "ForeignLLVM.cool"
U0 EmitLLVM(U8 *output) {
    I64 i, j, k, parameter, offset, main = FindFun("main"); Function *f; Text *all;
    if (main < 0) Error("no main function");
    if (functions[main].argc || (functions[main].result != T_VOID && functions[main].result != T_I32 && functions[main].result != T_INT)) ErrorAt(functions[main].token, "invalid main signature");
    ir = TextNew(); globals = TextNew();
    IR("; Generated by the Cool-written frontend. No C transpilation.\n");
    IR("declare void @cool_zero(i64, i64)\ndeclare i64 @cool_length(i64, i64, i64)\ndeclare i64 @cool_index(i64, i64, i64, i64, i64)\ndeclare void @cool_slice(i64, i64, i64, i64, i64, i64, i64)\n");
    IR("declare i64 @cool_alloc(i64)\ndeclare void @cool_free(i64)\ndeclare void @cool_copy(i64, i64, i64)\ndeclare i64 @cool_load(i64, i64)\ndeclare void @cool_store(i64, i64, i64)\n");
    IR("declare i64 @cool_cast(i64, i64, i64)\n");
    IR("declare void @cool_print(i64, i64, i64)\ndeclare void @cool_assert(i64)\ndeclare i64 @cool_div(i64, i64, i64, i64, i64)\ndeclare i64 @cool_shift(i64, i64, i64, i64, i64)\n");
    for (i = 0; i < nfun; i++) {
        f = &functions[i];
        if (f->foreign) {
            for (k = 0; k < i; k++) if (functions[k].foreign && Eq(functions[k].name, f->name)) goto foreign_already_declared;
            ForeignDeclaration(f);
        }
foreign_already_declared:;
    }
    for (i = 0; i < nfun; i++) {
        f = &functions[i]; reg_id = 0; terminated = FALSE; scope = NULL;
        IR("define i64 @__cool_fn"); RI(i); IR("(");
        if (Aggregate(f->result)) IR("i64 %result");
        for (j = 0; j < f->argc; j++) { if (j || Aggregate(f->result)) IR(", "); IR("i64 %a"); RI(j); }
        IR(") {\nentry:\n");
        IR("  %frame = alloca ["); RI(f->slots+1); IR(" x i64], align 8\n");
        for (j = 0; j < f->slots; j++) { IR("  %v"); RI(j); IR(" = getelementptr i64, ptr %frame, i64 "); RI(j); IR("\n"); }
        offset = 0;
        for (j = 0; !f->foreign && j < f->argc; j++) {
            parameter = Fresh(); IR("  "); Reg(parameter); IR(" = add i64 0, %a"); RI(j); IR("\n");
            if (Aggregate(f->arg_types[j])) EmitCopy(SlotAddress(offset), parameter, f->arg_types[j]);
            else { parameter = LocalWrite(parameter, f->arg_types[j]); IR("  store i64 "); Reg(parameter); IR(", ptr %v"); RI(offset); IR("\n"); }
            offset += TypeSlots(f->arg_types[j]);
        }
        if (f->foreign) { ForeignWrapper(f); terminated = TRUE; } else EmitStmt(f->body); if (!terminated) IR("  ret i64 0\n"); IR("}\n");
    }
    IR("define i32 @main() {\nentry:\n  %exit = call i64 @__cool_fn"); RI(main); IR("()\n  %status = trunc i64 %exit to i32\n  ret i32 %status\n}\n");
    all = TextNew(); if (globals->len) Append(all, globals->data); Append(all, ir->data);
    if (!FileWrite(output, all->data, all->len)) Error("failed to write LLVM IR");
}
