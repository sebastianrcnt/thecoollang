Bool Alpha(I64 ch) { return ('a' <= ch <= 'z') || ('A' <= ch <= 'Z') || ch == '_'; }
Bool Digit(I64 ch) { return '0' <= ch <= '9'; }
U0 LexSource(U8 *src, U8 *file) {
    I64 i = 0, line = 1, col = 1, start, ch, next, base, d, ok, comment_start, digits;
    Token *t; Text *text; Bool emitted, integer_overflow; U8 *number;
    if (!tokens) tokens = CAlloc(MAX_TOKENS * sizeof(Token));
    while (src[i]) {
        emitted = FALSE;
        ch = src[i]; next = src[i + 1];
        if (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n') {
            i++; col++; if (ch == '\n') { line++; col = 1; } goto lex_next;
        }
        if (ch == '/' && next == '/') { comment_start=i;while (src[i] && src[i] != '\n') { i++; col++; } CompletionExcluded(file,comment_start,i+1);goto lex_next; }
        if (ch == '/' && next == '*') {
            comment_start=i;i += 2; col += 2;
            while (src[i] && !(src[i] == '*' && src[i + 1] == '/')) {
                if (src[i] == '\n') { line++; col = 0; } i++; col++;
            }
            if (!src[i]) { tokens[ntok].file = file; tokens[ntok].line = line; tokens[ntok].col = col; ErrorAt(&tokens[ntok], "unterminated comment"); }
            i += 2; col += 2; CompletionExcluded(file,comment_start,i);goto lex_next;
        }
        if (ntok >= MAX_TOKENS - 2) {tokens[ntok].file=file;tokens[ntok].line=line;tokens[ntok].col=col;ErrorAt(&tokens[ntok],"token limit exceeded");}
        t = &tokens[ntok++]; t->val = 0; t->text = NULL; t->raw=NULL; t->kind=0; t->file = file; t->package = lex_package; t->line = line; t->col = col; start = i; t->start = i; emitted = TRUE;
        if (Alpha(ch)) {
            do { i++; col++; } while (Alpha(src[i]) || Digit(src[i]));
            t->kind = K_ID; t->text = Slice(src, start, i); goto lex_next;
        }
        if (Digit(ch)) {
            t->kind = K_INT; base = 10;
            if (ch == '0' && (next == 'x' || next == 'b')) { base = 16; if (next == 'b') base = 2; i += 2; col += 2; }
            start = i; digits=0;integer_overflow=FALSE;
            while (src[i]) {
                ch = src[i]; d = -1;
                if (Digit(ch)) d = ch - '0';
                if ('a' <= ch <= 'f') d = ch - 'a' + 10;
                if ('A' <= ch <= 'F') d = ch - 'A' + 10;
                if (ch == '_') { i++; col++; goto digit_next; }
                if (d < 0 || d >= base) break;
                if (t->val(U64) > (0xFFFFFFFFFFFFFFFF - d)(U64) / base(U64)) integer_overflow=TRUE;
                digits++;if(!integer_overflow)t->val = t->val * base + d; i++; col++;
digit_next:;
            }
            if (base == 10 && ((src[i] == '.' && Digit(src[i+1])) || src[i] == 'e' || src[i] == 'E')) {
                if (src[i] == '.') { i++; col++; while (Digit(src[i])) { i++; col++; } }
                if (src[i] == 'e' || src[i] == 'E') {
                    i++; col++; if (src[i] == '+' || src[i] == '-') { i++; col++; }
                    if (!Digit(src[i])) ErrorAt(t, "expected exponent digits");
                    while (Digit(src[i])) { i++; col++; }
                }
                number=Slice(src,t->start,i);t->val = NativeParseFloat(number, &ok);Free(number);
                if (!ok) ErrorAt(t, "floating literal out of range or invalid");
                t->kind = K_FLOAT;
            }
            if(integer_overflow && t->kind==K_INT)ErrorAt(t,"integer literal exceeds u64 range");
            if (digits == 0 || Alpha(src[i]) || Digit(src[i])) ErrorAt(t, "invalid integer literal");
            goto lex_next;
        }
        if (ch == '"') {
            text = TextNew(); lex_pending=text; i++; col++;
            while (src[i] && src[i] != '"') {
                ch = src[i++]; col++;
                if (ch == '\n') ErrorAt(t, "newline in string literal");
                if (ch == '\\') {
                    ch = src[i++]; col++;
                    if (ch == 'n') ch = '\n'; else if (ch == 't') ch = '\t'; else if (ch == 'r') ch = '\r';
                    else if (ch != '\\' && ch != '"') ErrorAt(t, "unsupported string escape");
                }
                Char(text, ch);
            }
            if (!src[i]) ErrorAt(t, "unterminated string literal");
            Reserve(text, 0); t->text = text->data; Free(text);lex_pending=NULL;t->kind = K_STRING; i++; col++; goto lex_next;
        }
        t->kind = ch; i++; col++;
        if (ch == '=' && next == '>') t->kind = K_FAT_ARROW;
        if (ch == '=' && next == '=') t->kind = K_EQ;
        if (ch == '!' && next == '=') t->kind = K_NE;
        if (ch == '<' && next == '=') t->kind = K_LE;
        if (ch == '>' && next == '=') t->kind = K_GE;
        if (ch == '&' && next == '&') t->kind = K_AND;
        if (ch == '|' && next == '|') t->kind = K_OR;
        if (ch == '-' && next == '>') t->kind = K_ARROW;
        if (ch == '<' && next == '<') t->kind = K_SHL;
        if (ch == '>' && next == '>') t->kind = K_SHR;
        if (t->kind >= K_EQ) { i++; col++; }
lex_next:
        if (emitted) { t->end = i; t->raw = Slice(src, t->start, i); }
    }
    tokens[ntok].start=i;tokens[ntok].end=i;tokens[ntok].kind = 0; tokens[ntok].file = file; tokens[ntok].line = line; tokens[ntok].col = col;
}

U0 ValidateInput(U8 *source,I64 size,U8 *file){
    I64 i=0,line=1,column=1,first,width,part,next,second;Bool invalid;U8 *message;Token token;
    while(i<size){
        first=source[i];width=1;invalid=FALSE;message="invalid UTF-8 in input";
        if(!first){invalid=TRUE;message="embedded NUL byte in input";}
        else if(first>=128){
            if(first>=194 && first<=223)width=2;
            else if(first>=224 && first<=239)width=3;
            else if(first>=240 && first<=244)width=4;
            else invalid=TRUE;
            if(width>size-i)invalid=TRUE;
            if(!invalid){
                for(part=1;part<width;part++){next=source[i+part];if(next<128 || next>191)invalid=TRUE;}
                second=source[i+1];
                if((first==224 && second<160) || (first==237 && second>=160) || (first==240 && second<144) || (first==244 && second>=144))invalid=TRUE;
            }
        }
        if(invalid){MemSet(&token,0,sizeof(Token));token.file=file;token.start=i;token.end=i+1;token.line=line;token.col=column;ErrorAt(&token,message);}
        if(first==10){line++;column=1;}else column+=width;i+=width;
    }
}
