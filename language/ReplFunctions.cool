// Disposal compares ownership with the opposite side of the transaction.
// Call only after user frames have returned/unwound; callers use stable IDs.
U0 FreeFunctionChanges(Function *discard,Function *retain) {
    Local *local,*next_local;BorrowSource *edge,*next_edge;ReplNode *node,*next_node;DropSlot *drop,*next_drop;
    if(discard->machine!=retain->machine){NativeJitFree(discard->machine,discard->machine_size);discard->machine=NULL;discard->machine_size=0;}
    if(discard->bytecode!=retain->bytecode || discard->byte_allocations!=retain->byte_allocations)FreeBytecode(discard);
    if(discard->allocated_locals!=retain->allocated_locals){
        for(local=discard->allocated_locals;local;local=next_local){next_local=local->repl_next;for(edge=local->sources;edge;edge=next_edge){next_edge=edge->next;Free(edge);}Free(local);}
        discard->allocated_locals=discard->all_locals=NULL;
    }
    if(discard->nodes!=retain->nodes){for(node=discard->nodes;node;node=next_node){next_node=node->next;Free(node);}discard->nodes=NULL;discard->body=NULL;}
    if(discard->drops!=retain->drops){for(drop=discard->drops;drop;drop=next_drop){next_drop=drop->next;Free(drop);}discard->drops=NULL;}
}
U0 ReplRollbackFunctions() {
    Function empty,*retained;I64 i;MemSet(&empty,0,sizeof(Function));
    Free(jit_offsets);Free(jit_patches);jit_offsets=jit_patches=NULL;
    if(machine){Free(machine->data);Free(machine);machine=NULL;}
    for(i=1;i<nfun;i++){retained=&empty;if(i<repl_saved_nfun)retained=&repl_snapshot[i];FreeFunctionChanges(&functions[i],retained);}
}
U0 ReplCommitFunctions() {I64 i;for(i=1;i<repl_saved_nfun;i++)FreeFunctionChanges(&repl_snapshot[i],&functions[i]);}

U0 ReplRevalidateBorrowProjections(){
 I64 i,count,tail=0,front=0,edge_count=0,edge=0,link,caller;
 I64 *affected,*queue,*heads,*callers,*links;Bool changed=FALSE,fallback=FALSE;
 Function *old,*current;ReplNode *allocation;Node *node;
 if(!allow_redefinition || !repl_snapshot)return;
 for(i=1;i<repl_saved_nfun;i++){old=&repl_snapshot[i];current=&functions[i];if(old->body!=current->body && ReferenceSliceProjection(old)>=0 && ReferenceSliceProjection(old)!=ReferenceSliceProjection(current))changed=TRUE;}
 if(!changed)return;count=repl_saved_nfun;
 affected=ScratchAllocate(count*8);queue=ScratchAllocate(count*8);heads=ScratchAllocate(count*8);
 for(i=1;i<count;i++){
  heads[i]=-1;old=&repl_snapshot[i];current=&functions[i];
  if(old->body!=current->body && ReferenceSliceProjection(old)>=0 && ReferenceSliceProjection(old)!=ReferenceSliceProjection(current)){affected[i]=1;queue[tail++]=i;}
  if(current->body && current->body==old->body && !current->generic_count){
   if(!current->nodes)fallback=TRUE;
   for(allocation=current->nodes;allocation;allocation=allocation->next){node=&allocation->value;if(node->kind==N_CALL){if(node->slot>=count)fallback=TRUE;if(node->slot>0 && node->slot<count)edge_count++;}}
  }
 }
 callers=ScratchAllocate(edge_count*8);links=ScratchAllocate(edge_count*8);
 for(i=1;i<count;i++){
  current=&functions[i];if(current->body && current->body==repl_snapshot[i].body && !current->generic_count){
   for(allocation=current->nodes;allocation;allocation=allocation->next){node=&allocation->value;if(node->kind==N_CALL && node->slot>0 && node->slot<count){callers[edge]=i;links[edge]=heads[node->slot];heads[node->slot]=edge++;}}
  }
 }
 while(front<tail){link=heads[queue[front++]];while(link>=0){caller=callers[link];if(!affected[caller]){affected[caller]=1;queue[tail++]=caller;}link=links[link];}}
 for(i=1;i<count;i++){current=&functions[i];if((fallback || affected[i]) && current->body && current->body==repl_snapshot[i].body && !current->generic_count)AnalyzeReferences(current);}
}
