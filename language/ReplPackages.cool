// Native package parsing, aligned with compiler/20-repl-packages.cool.
class ReplPackage { U8 *name,*fingerprint;ReplPackage *next; };
ReplPackage *repl_packages,*repl_saved_packages;
ReplPackage *ReplFindPackage(ReplPackage *head,U8 *name){ReplPackage *item=head;while(item){if(Eq(item->name,name))return item;item=item->next;}return NULL;}
U0 ReplPackagesRestore(){ReplPackage *item;Alias *alias;while(repl_packages!=repl_saved_packages){item=repl_packages;repl_packages=item->next;Free(item->fingerprint);Free(item);}while(aliases!=repl_aliases){alias=aliases;aliases=alias->next;Free(alias);}lex_package="__main";}
U0 ReplReadPackages(U8 *manifest,Token *token){
    ReplPackage *previous=repl_packages,*existing,*package;I64 size=0,at=0,field,begin;U8 *fields[4],*source,*data=ScratchOwn(FileRead(manifest,&size,NULL));
    if(!data)ErrorAt(token,"cannot read resolved package manifest");
    while(data[at]){
        for(field=0;field<4;field++){begin=at;while(data[at] && data[at]!='\t' && data[at]!='\n')at++;if((field<3 && data[at]!='\t') || (field==3 && data[at]!='\n'))ErrorAt(token,"invalid resolved package manifest");fields[field]=ScratchOwn(Slice(data,begin,at++));}
        existing=ReplFindPackage(repl_packages,fields[0]);if(existing && !Eq(existing->fingerprint,fields[1]))ErrorAt(token,"loaded package changed; start a new session");
        if(!ReplFindPackage(previous,fields[0])){
            if(!existing){package=CAlloc(sizeof(ReplPackage));package->name=LiteralString(fields[0]);package->fingerprint=StrNew(fields[1]);package->next=repl_packages;repl_packages=package;}
            source=ScratchOwn(FileRead(fields[3],&size,NULL));if(!source)ErrorAt(token,"cannot read resolved package source");lex_package=LiteralString(fields[0]);LexSource(source,LiteralString(fields[2]));
        }
    }ScratchRelease(data);
}
U0 ReplLoadImports(I64 start){
    I64 end=ntok,nesting=0,at,path_index;Bool reserved=FALSE;Token *token;U8 *path,*response;
    for(at=start;at<end;at++){
        token=&tokens[at];if(!nesting && token->kind==K_ID && Eq(token->text,"import")){
            path_index=at+1;if(tokens[path_index].kind==K_ID)path_index++;if(tokens[path_index].kind!=K_STRING)ErrorAt(token,"expected import path string");path=tokens[path_index].text;
            if(!Eq(path,"std/io") && !Eq(path,"std/mem")){response=NativeReplResolve(path);if(response[0]!='o' || response[1]!='k' || response[2]!='\t')ErrorAt(token,response+6);if(!reserved){ntok=end+1;reserved=TRUE;}ReplReadPackages(response+3,token);}
        }
        if(token->kind=='{')nesting++;if(token->kind=='}')nesting--;
    }
    if(reserved){if(ntok>end+1){pos=end+1;ParseProgram();}else ntok=end;}
    lex_package="__main";pos=start;
}
