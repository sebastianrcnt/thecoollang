extern U0 EmitClearFunctions();
// Destructors are generated from concrete layouts, not interpreted by a C compiler.
U0 EmitDrop(I64 address, I64 type) {
    if (!Owned(type)) return;
    IR("  call void @__cool_drop"); RI(type); IR("(i64 "); Reg(address); IR(")\n");
}
U0 DropFieldIR(Field *field) {
    IR("  %field"); RI(field->tag); IR(" = add i64 %address, "); RI(field->offset); IR("\n  call void @__cool_drop"); RI(field->type); IR("(i64 %field"); RI(field->tag); IR(")\n");
}
U0 DropFieldsReverseIR(Field *field) {
    I64 count=0,index=0;Field *item;Field **fields;
    for(item=field;item;item=item->next)if(Owned(item->type))count++;
    if(!count)return;
    fields=CAlloc(count*8)(Field **);
    for(item=field;item;item=item->next)if(Owned(item->type))fields[index++]=item;
    while(index>0){index--;DropFieldIR(fields[index]);}
    Free(fields(U8 *));
}
U0 EmitDropFunctions() {
    I64 i, type; AggregateType *a; Field *field;
    EmitClearFunctions();
    for (i = 0; i < naggregates; i++) {
        type = T_AGG+i; a = Shape(type); if (a->generic_count || !Owned(type)) goto drop_next;
        IR("define void @__cool_drop");RI(type);IR("(i64 %address) {\nentry:\n  call void @cool_drop_enqueue(i64 %address, ptr @__cool_drop_body");RI(type);IR(")\n  ret void\n}\n");
        IR("define void @__cool_drop_body"); RI(type); IR("(i64 %address) {\nentry:\n  %cell = inttoptr i64 %address to ptr\n");
        if (a->kind == A_OWNER) {
            IR("  %owned = load i64, ptr %cell\n  %alive = icmp ne i64 %owned, 0\n  br i1 %alive, label %drop, label %done\ndrop:\n  store i64 0, ptr %cell\n");
            if (Owned(a->element)) { IR("  call void @cool_drop_defer_free(i64 %owned)\n  call void @__cool_drop"); RI(a->element); IR("(i64 %owned)\n"); }
            else IR("  call void @cool_owner_free(i64 %owned)\n");
            IR("  br label %done\ndone:\n  ret void\n");
        } else if (a->kind == A_ARRAY) {
            IR("  br label %loop\nloop:\n  %index = phi i64 [");RI(a->count);IR(", %entry], [%item, %body]\n  %more = icmp ne i64 %index, 0\n  br i1 %more, label %body, label %done\nbody:\n  %item = sub i64 %index, 1\n  %offset = mul i64 %item, ");RI(ByteSize(a->element));
            IR("\n  %element = add i64 %address, %offset\n  call void @__cool_drop");RI(a->element);IR("(i64 %element)\n  br label %loop\ndone:\n  ret void\n");
        } else if (a->kind == A_ENUM) {
            IR("  %tag = load i64, ptr %cell\n  switch i64 %tag, label %done [\n");
            for (field = a->fields; field; field = field->next) if (Owned(field->type)) { IR("    i64 "); RI(field->tag); IR(", label %variant"); RI(field->tag); IR("\n"); }
            IR("  ]\n");
            for (field = a->fields; field; field = field->next) if (Owned(field->type)) { IR("variant"); RI(field->tag); IR(":\n"); DropFieldIR(field); IR("  br label %done\n"); }
            IR("done:\n  ret void\n");
        } else {
            DropFieldsReverseIR(a->fields);
            IR("  ret void\n");
        }
        IR("}\n");
    drop_next:;
    }
}

U0 ClearFieldIR(Field *field) {
    IR("  %field"); RI(field->tag); IR(" = add i64 %address, "); RI(field->offset); IR("\n  call void @__cool_clear"); RI(field->type); IR("(i64 %field"); RI(field->tag); IR(")\n");
}
U0 EmitClearFunctions() {
    I64 i, type; AggregateType *a; Field *field;
    for (i = 0; i < naggregates; i++) {
        type = T_AGG+i; a = Shape(type); if (a->generic_count || !Owned(type)) goto drop_next;
        IR("define void @__cool_clear"); RI(type); IR("(i64 %address) {\nentry:\n  %cell = inttoptr i64 %address to ptr\n");
        if (a->kind==A_OWNER || !Borrowed(type)) {
            IR("  call void @cool_zero(i64 %address, i64 ");RI(ByteSize(type));IR(")\n  ret void\n");
        } else if (a->kind == A_ARRAY) {
            IR("  br label %loop\nloop:\n  %index = phi i64 [0, %entry], [%next, %body]\n  %more = icmp ult i64 %index, "); RI(a->count); IR("\n  br i1 %more, label %body, label %done\nbody:\n  %offset = mul i64 %index, "); RI(ByteSize(a->element));
            IR("\n  %element = add i64 %address, %offset\n  call void @__cool_clear"); RI(a->element); IR("(i64 %element)\n  %next = add i64 %index, 1\n  br label %loop\ndone:\n  ret void\n");
        } else if (a->kind == A_ENUM) {
            IR("  %tag = load i64, ptr %cell\n  switch i64 %tag, label %done [\n");
            for (field = a->fields; field; field = field->next) if (Owned(field->type)) { IR("    i64 "); RI(field->tag); IR(", label %variant"); RI(field->tag); IR("\n"); }
            IR("  ]\n");
            for (field = a->fields; field; field = field->next) if (Owned(field->type)) { IR("variant"); RI(field->tag); IR(":\n"); ClearFieldIR(field); IR("  br label %done\n"); }
            IR("done:\n  ret void\n");
        } else {
            for (field = a->fields; field; field = field->next) if (Owned(field->type)) ClearFieldIR(field);
            IR("  ret void\n");
        }
        IR("}\n");
    drop_next:;
    }
}
