#include "Core.cool"
#include "Lexer.cool"
#include "Editor.cool"
#include "Types.cool"
#include "Borrow.cool"
#include "Ownership.cool"
#include "Completion.cool"
#include "Parser.cool"
#include "References.cool"
#include "Methods.cool"
#include "Interpreter.cool"
#include "LLVM.cool"
#include "Bytecode.cool"
#include "JIT.cool"
#include "Repl.cool"
#include "Format.cool"
U0 ReadSource(U8 *file) {
    I64 size; U8 *src = FileRead(file, &size, NULL);
    if (!src) { Out("cannot read source\n"); NativeExit(2); }
    LexSource(src, file);
}
U0 ReadBundle(U8 *file) {
    I64 size, i = 0, start; U8 *data = FileRead(file, &size, NULL), *path;
    if (!data) NativeExit(2);
    while (data[i]) {
        start = i; while (data[i] && data[i] != '\t') i++;
        if (!data[i]) NativeExit(2);
        lex_package = Slice(data, start, i++); start = i;
        while (data[i] && data[i] != '\n') i++;
        path = Slice(data, start, i); if (data[i]) i++;
        ReadSource(path);
    }
}
U0 ScanMetadataFiles() {
    I64 i,nesting=0,at;U8 *file=NULL;
    for(i=0;i<ntok;i++){
        if(!file || !Eq(file,tokens[i].file)){file=tokens[i].file;nesting=0;}
        if(!nesting && tokens[i].kind==K_ID && Eq(tokens[i].text,"package") && tokens[i+1].kind==K_ID){Out(file);Out("\tpackage\t");Out(tokens[i+1].text);Out("\n");}
        if(!nesting && tokens[i].kind==K_ID && Eq(tokens[i].text,"import")){
            at=i+1;if(tokens[at].kind==K_ID)at++;
            if(tokens[at].kind!=K_STRING)ErrorAt(&tokens[at],"expected import path string");
            Out(file);Out("\timport\t");Out(tokens[at].text);Out("\n");
        }
        if(tokens[i].kind=='{')nesting++;if(tokens[i].kind=='}')nesting--;
    }
}
U0 LanguageMain() {
    U8 *mode;
    if (NativeArgCount() == 2 && (Eq(NativeArg(1), "repl") || Eq(NativeArg(1), "repl-quiet"))) { Repl(Eq(NativeArg(1), "repl")); return; }
    if (NativeArgCount() < 3) { Out("usage: language.BIN check|run|llvm[-bundle] source [output.ll]\n"); NativeExit(2); }
    mode = NativeArg(1);
    if(Eq(mode,"editor-complete-bundle")){if(NativeArgCount()!=5)NativeExit(2);editor_diagnostics=TRUE;CompletionBegin(NativeArg(3),NativeArg(4));ReadBundle(NativeArg(2));CompletionPrepare(NativeArg(3),NativeArg(4));ParseProgram();return;}
    if(Eq(mode,"editor-index-bundle")){editor_diagnostics=editor_index=TRUE;ReadBundle(NativeArg(2));EditorPrepare();ParseProgram();EditorProgram();return;}
    if(Eq(mode,"diagnostics-bundle") || Eq(mode,"editor-scan-bundle")){editor_diagnostics=TRUE;ReadBundle(NativeArg(2));if(Eq(mode,"editor-scan-bundle"))ScanMetadataFiles();else ParseProgram();return;}
    if(Eq(mode,"scan-bundle")){ReadBundle(NativeArg(2));ScanMetadataFiles();return;}
    if (Eq(mode, "fmt")) { if (NativeArgCount() != 4) NativeExit(2); FormatFile(NativeArg(2), NativeArg(3)); return; }
    if (Eq(mode, "auto") || Eq(mode, "auto-bundle")) execution_mode = 3;
    if (Eq(mode, "bytecode") || Eq(mode, "bytecode-bundle")) execution_mode = 1;
    if (Eq(mode, "jit") || Eq(mode, "jit-bundle")) execution_mode = 2;
    if (Eq(mode, "symbols") || Eq(mode, "test-bundle") || Eq(mode, "jit-test-bundle") || Eq(mode, "auto-bundle") || Eq(mode, "jit-bundle") || Eq(mode, "bytecode-bundle") || Eq(mode, "check-bundle") || Eq(mode, "run-bundle") || Eq(mode, "llvm-bundle")) ReadBundle(NativeArg(2));
    else ReadSource(NativeArg(2));
    if (Eq(mode, "scan")) {
        I64 i, nesting = 0;
        for (i = 0; i < ntok; i++) {
            if (!nesting && tokens[i].kind == K_ID && Eq(tokens[i].text, "package") && tokens[i+1].kind == K_ID) {
                Out("package\t"); Out(tokens[i+1].text); Out("\n");
            }
            if (!nesting && tokens[i].kind == K_ID && Eq(tokens[i].text, "import")) {
                I64 at = i + 1; if (tokens[at].kind == K_ID) at++;
                if (tokens[at].kind != K_STRING) ErrorAt(&tokens[at], "expected import path string");
                Out("import\t"); Out(tokens[at].text); Out("\n");
            }
            if (tokens[i].kind == '{') nesting++;
            if (tokens[i].kind == '}') nesting--;
        }
        return;
    }
    ParseProgram();
    if (Eq(mode, "symbols")) {
        I64 si, sj; Text *line; Field *field;
        for (si = 0; si < naggregates; si++) {
            line = TextNew(); Append(line, "@type\t"); Number(line, T_AGG+si); Char(line, '\t'); AppendType(line, T_AGG+si); Char(line, '\n'); Out(line->data);
            if (aggregate_types[si].kind == A_STRUCT && aggregate_types[si].public && !aggregate_types[si].generic_count && !aggregate_types[si].origin) {
                line = TextNew(); Append(line, "@struct\t"); Append(line, aggregate_types[si].package); Append(line, "\tpub struct "); Append(line, aggregate_types[si].name); Append(line, " { ");
                for (field = aggregate_types[si].fields; field; field = field->next) if (field->public) { Append(line, "pub "); Append(line, field->name); Append(line, ": "); AppendType(line, field->type); Append(line, "; "); }
                Append(line, "}\n"); Out(line->data);
            }
        }
        for (si = 0; si < nfun; si++) {
            if (functions[si].origin) goto symbol_next;
            if (functions[si].generic_count) {
                if (functions[si].public) { line = TextNew(); Append(line, "@struct\t"); Append(line, functions[si].package); Append(line, "\tpub fn "); Append(line, functions[si].name); Char(line, '[');
                    for (sj = 0; sj < functions[si].generic_count; sj++) { if (sj) Append(line, ", "); Append(line, functions[si].generic_names[sj]); } Append(line, "] ");
                    for (sj = functions[si].signature; sj < functions[si].begin; sj++) { Append(line, tokens[sj].raw); Char(line, ' '); } Append(line, ";\n"); Out(line->data); }
                goto symbol_next;
            }
            line = TextNew(); Append(line, functions[si].package); Char(line, '\t'); Append(line, functions[si].name); Char(line, '\t');
            Number(line, functions[si].public); Char(line, '\t'); Number(line, functions[si].result); Char(line, '\t');
            for (sj = 0; sj < functions[si].argc; sj++) { if (sj) Char(line, ','); Append(line, functions[si].arg_names[sj]); Char(line, ':'); Number(line, functions[si].arg_types[sj]); }
            Char(line, '\n'); Out(line->data);
symbol_next:;
        }
        return;
    }
    if (Eq(mode, "test-bundle") || Eq(mode, "jit-test-bundle")) {
        I64 ti, tests = 0, values[1]; Node *call; Text *summary;
        execution_mode = 1; if (Eq(mode, "jit-test-bundle")) execution_mode = 2;
        for (ti = 0; ti < nfun; ti++) {
            if (!functions[ti].generic_count && !functions[ti].origin && Eq(functions[ti].package, "__main") && StrLen(functions[ti].name) >= 5 && functions[ti].name[0] == 't' && functions[ti].name[1] == 'e' && functions[ti].name[2] == 's' && functions[ti].name[3] == 't' && functions[ti].name[4] == '_') {
                if (functions[ti].argc || functions[ti].result) ErrorAt(functions[ti].token, "test functions must take no arguments and return void");
                call = NewNode(N_CALL, functions[ti].token); call->slot = ti; Invoke(call, values);
                Out("PASS "); Out(functions[ti].name); Out("\n"); tests++;
            }
        }
        if (!tests) Error("no test_ functions found");
        summary = TextNew(); Number(summary, tests); Append(summary, " tests passed\n"); Out(summary->data); return;
    }
    if (execution_mode || Eq(mode, "run") || Eq(mode, "run-bundle")) { NativeSetProgramArgs(3); NativeExit(RunMain()); }
    if (Eq(mode, "llvm") || Eq(mode, "llvm-bundle")) { if (NativeArgCount() != 4) NativeExit(2); EmitLLVM(NativeArg(3)); return; }
    if (!Eq(mode, "check") && !Eq(mode, "check-bundle")) { Out("unknown command\n"); NativeExit(2); }
}
LanguageMain;
