#include "Core.cool"
#include "Lexer.cool"
#include "Parser.cool"
#include "Interpreter.cool"
#include "LLVM.cool"
#include "Bytecode.cool"
#include "JIT.cool"
U0 ReadSource(U8 *file) {
    I64 size; U8 *src = FileRead(file, &size, NULL);
    if (!src) { Out("cannot read source\n"); NativeExit(2); }
    LexSource(src, file);
}
U0 ReadBundle(U8 *file) {
    I64 size, i = 0, start; U8 *data = FileRead(file, &size, NULL), *path;
    if (!data) NativeExit(2);
    while (data[i]) {
        start = i; while (data[i] && data[i] != '\t') i++;
        if (!data[i]) NativeExit(2);
        lex_package = Slice(data, start, i++); start = i;
        while (data[i] && data[i] != '\n') i++;
        path = Slice(data, start, i); if (data[i]) i++;
        ReadSource(path);
    }
}
U0 LanguageMain() {
    U8 *mode;
    if (NativeArgCount() < 3 || NativeArgCount() > 4) { Out("usage: language.BIN check|run|llvm[-bundle] source [output.ll]\n"); NativeExit(2); }
    mode = NativeArg(1);
    if (Eq(mode, "bytecode") || Eq(mode, "bytecode-bundle")) execution_mode = 1;
    if (Eq(mode, "jit") || Eq(mode, "jit-bundle")) execution_mode = 2;
    if (Eq(mode, "jit-bundle") || Eq(mode, "bytecode-bundle") || Eq(mode, "check-bundle") || Eq(mode, "run-bundle") || Eq(mode, "llvm-bundle")) ReadBundle(NativeArg(2));
    else ReadSource(NativeArg(2));
    if (Eq(mode, "scan")) {
        I64 i, nesting = 0;
        for (i = 0; i < ntok; i++) {
            if (!nesting && tokens[i].kind == K_ID && Eq(tokens[i].text, "package") && tokens[i+1].kind == K_ID) {
                Out("package\t"); Out(tokens[i+1].text); Out("\n");
            }
            if (!nesting && tokens[i].kind == K_ID && Eq(tokens[i].text, "import")) {
                I64 at = i + 1; if (tokens[at].kind == K_ID) at++;
                if (tokens[at].kind != K_STRING) ErrorAt(&tokens[at], "expected import path string");
                Out("import\t"); Out(tokens[at].text); Out("\n");
            }
            if (tokens[i].kind == '{') nesting++;
            if (tokens[i].kind == '}') nesting--;
        }
        return;
    }
    ParseProgram();
    if (execution_mode || Eq(mode, "run") || Eq(mode, "run-bundle")) NativeExit(RunMain());
    if (Eq(mode, "llvm") || Eq(mode, "llvm-bundle")) { if (NativeArgCount() != 4) NativeExit(2); EmitLLVM(NativeArg(3)); return; }
    if (!Eq(mode, "check") && !Eq(mode, "check-bundle")) { Out("unknown command\n"); NativeExit(2); }
}
LanguageMain;
