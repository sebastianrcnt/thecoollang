class Frame { I64 *values, flow, result; };
class Deferred { Node *call; I64 *args; Deferred *next; };
I64 call_depth, execution_mode;
extern U0 CompileBytecode(Function *f);
extern I64 RunBytecode(Function *f, I64 *registers);
extern I64 RunNative(Function *f, I64 *registers);
extern I64 Eval(Node *n, Frame *frame);
extern U0 Execute(Node *n, Frame *frame);
I64 Normalize(I64 v, I64 type) {
    I64 width = Width(type);
    if (!Integer(type) || width == 64) return v;
    if (Unsigned(type)) return v & ((1 << width) - 1);
    return (v << (64 - width)) >> (64 - width);
}
U0 UnsignedNumber(Text *text, U64 value) {
    U8 digits[32]; I64 i = 0;
    do { digits[i++] = '0' + value % 10; value /= 10; } while (value);
    while (i) Char(text, digits[--i]);
}
I64 ConvertNumber(I64 value, I64 from, I64 to, Token *t) {
    I64 ok, result;
    if (!Floating(from) && !Floating(to)) return Normalize(value, to);
    result = NativeNumericCast(value, from, to, &ok); if (!ok) ErrorAt(t, "floating conversion out of range"); return result;
}
I64 Arithmetic(Node *n, I64 a, I64 b) {
    I64 op = n->op, result = 0; Bool unsigned = Unsigned(n->a->type); F64 x, y, z = 0.0;
    if (Floating(n->a->type)) {
        x = AsFloat(a); y = AsFloat(b);
        switch (op) {
            case '+': z = x + y; break; case '-': z = x - y; break;
            case '*': z = x * y; break; case '/': z = x / y; break;
            case K_EQ: return x == y; case K_NE: return x != y;
            case '<': return x < y; case '>': return x > y;
            case K_LE: return x <= y; case K_GE: return x >= y;
        }
        return ConvertNumber(AsBits(z), T_F64, n->type, n->token);
    }
    if ((op == '/' || op == '%') && (!b || (!unsigned && a == (-0x7FFFFFFFFFFFFFFF - 1) && b == -1))) ErrorAt(n->token, "invalid integer division");
    if ((op == K_SHL || op == K_SHR) && (b < 0 || b >= Width(n->a->type))) ErrorAt(n->token, "shift count outside operand width");
    switch (op) {
        case '+': result = a + b; break; case '-': result = a - b; break;
        case '*': result = a * b; break;
        case '/': if (unsigned) result = a(U64) / b(U64); else result = a / b; break;
        case '%': if (unsigned) result = a(U64) % b(U64); else result = a % b; break;
        case '&': result = a & b; break; case '|': result = a | b; break; case '^': result = a ^ b; break;
        case K_SHL: result = a << b; break;
        case K_SHR: if (unsigned) result = a(U64) >> b; else result = a >> b; break;
        case K_EQ: result = a == b; break; case K_NE: result = a != b; break;
        case '<': if (unsigned) result = a(U64) < b(U64); else result = a < b; break;
        case '>': if (unsigned) result = a(U64) > b(U64); else result = a > b; break;
        case K_LE: if (unsigned) result = a(U64) <= b(U64); else result = a <= b; break;
        case K_GE: if (unsigned) result = a(U64) >= b(U64); else result = a >= b; break;
        case K_AND: result = a && b; break; case K_OR: result = a || b; break;
    }
    return Normalize(result, n->type);
}
I64 Invoke(Node *n, I64 *args) {
    Function *f; Frame *frame; Text *text; I64 i, result, ok;
    if (n->slot == -1) {
        if (n->a->type == T_STRING) Out(args[0](U8 *));
        else if (Floating(n->a->type)) NativePrintFloat(args[0]);
        else if (n->a->type == T_BOOL) { if (args[0]) Out("true"); else Out("false"); }
        else { text = TextNew(); if (Unsigned(n->a->type)) UnsignedNumber(text, args[0]); else Number(text, args[0]); Out(text->data); Free(text->data); Free(text); }
        if (Eq(n->name, "println")) Out("\n"); return 0;
    }
    if (n->slot == -3) { if (args[0] < 0) ErrorAt(n->token, "allocation size exceeds host range"); return CAlloc(args[0]); }
    if (n->slot == -4) { Free(args[0](U8 *)); return 0; }
    if (n->slot == -5) { if (args[2] < 0) ErrorAt(n->token, "copy size exceeds host range"); MemCpy(args[0](U8 *), args[1](U8 *), args[2]); return 0; }
    if (n->slot == -2) { if (!args[0]) ErrorAt(n->token, "assertion failed"); return 0; }
    f = &functions[n->slot];
    if (f->foreign) {
        result = NativeForeignCall(f->name, f->result, f->arg_types, args, f->argc, &ok);
        if (!ok) ErrorAt(n->token, "could not resolve foreign function or unsupported C ABI");
        return result;
    }
    if (++call_depth > 1024) ErrorAt(n->token, "call depth limit exceeded");
    f = &functions[n->slot]; frame = CAlloc(sizeof(Frame)); if (execution_mode && !f->bytecode) CompileBytecode(f);
    frame->values = CAlloc((f->slots + f->registers + 1) * 8);
    for (i = 0; i < f->argc; i++) NativeMemoryWrite(&frame->values[i], f->arg_types[i], args[i]);
    f->calls++;
    if (execution_mode == 2 || (execution_mode == 3 && f->calls >= 4)) result = RunNative(f, frame->values);
    else if (execution_mode) result = RunBytecode(f, frame->values);
    else { Execute(f->body, frame); result = frame->result; } Free(frame->values); Free(frame); call_depth--; return result;
}
I64 *Arguments(Node *n, Frame *frame) {
    I64 i = 0, *args = CAlloc((n->value + 1) * 8); Node *a = n->a;
    while (a) { args[i++] = Eval(a, frame); a = a->next; } return args;
}
I64 Eval(Node *n, Frame *frame) {
    I64 a, b, op, result = 0, *args;
    if (n->kind == N_INT) return n->value;
    if (n->kind == N_STRING) return n->name;
    if (n->kind == N_LOCAL) return NativeMemoryRead(&frame->values[n->slot], n->type);
    if (n->kind == N_LOCAL_ADDRESS) return &frame->values[n->slot];
    if (n->kind == N_CALL) { args = Arguments(n, frame); result = Invoke(n, args); Free(args); return result; }
    if (n->kind == N_ADDRESS) {
        a = Eval(n->a, frame); b = Eval(n->b, frame) * ByteSize(n->type - T_PTR); if (n->op == '-') return a - b; return a + b;
    }
    if (n->kind == N_LOAD) { a = Eval(n->a, frame); if (!a) ErrorAt(n->token, "null pointer dereference"); return NativeMemoryRead(a, n->type); }
    if (n->kind == N_CAST) return ConvertNumber(Eval(n->a, frame), n->a->type, n->type, n->token);
    a = Eval(n->a, frame); op = n->op;
    if (n->kind == N_UNARY) { if (Floating(n->type)) return AsBits(-AsFloat(a)); if (op == '!') return !a; if (op == '-') return Normalize(-a, n->type); return Normalize(~a, n->type); }
    if (op == K_AND && !a) return 0;
    if (op == K_OR && a) return 1;
    b = Eval(n->b, frame);
    return Arithmetic(n, a, b);
}
U0 Execute(Node *n, Frame *frame) {
    Node *s; I64 address, value; Deferred *deferred = NULL, *d;
    if (!n) return;
    switch (n->kind) {
        case N_BLOCK:
            s = n->a;
            while (s && !frame->flow) {
                if (s->kind == N_DEFER) {
                    d = CAlloc(sizeof(Deferred)); d->call = s->a; d->args = Arguments(s->a, frame); d->next = deferred; deferred = d;
                } else Execute(s, frame);
                s = s->next;
            }
            while (deferred) { d = deferred; Invoke(d->call, d->args); deferred = d->next; Free(d->args); Free(d); }
            break;
        case N_STORE:
            address = Eval(n->a, frame); value = Eval(n->b, frame); if (!address) ErrorAt(n->token, "null pointer dereference"); NativeMemoryWrite(address, n->type, value); break;
        case N_BIND: case N_ASSIGN: NativeMemoryWrite(&frame->values[n->slot], n->type, Eval(n->a, frame)); break;
        case N_EXPR: Eval(n->a, frame); break;
        case N_RETURN: if (n->a) frame->result = Eval(n->a, frame); frame->flow = 1; break;
        case N_IF: if (Eval(n->a, frame)) Execute(n->b, frame); else Execute(n->c, frame); break;
        case N_FOR: case N_WHILE:
            while (Eval(n->a, frame)) {
                Execute(n->b, frame);
                if (frame->flow == 1) break;
                if (frame->flow == 2) { frame->flow = 0; break; }
                frame->flow = 0;
                if (n->kind == N_FOR) Execute(n->c, frame);
            }
            break;
        case N_BREAK: frame->flow = 2; break;
        case N_CONTINUE: frame->flow = 3; break;
    }
}
I64 RunMain() {
    I64 id = FindFun("main"), args[1]; Node *call;
    if (id < 0) Error("no main function");
    if (functions[id].argc || (functions[id].result != T_VOID && functions[id].result != T_I32 && functions[id].result != T_INT)) ErrorAt(functions[id].token, "main must take no arguments and return void, i32 or i64");
    call = NewNode(N_CALL, functions[id].token); call->slot = id; return Invoke(call, args);
}
