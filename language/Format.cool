// Token-preserving formatter; comments and original literal spelling are retained.
Text *formatted;
I64 format_indent;
U0 FIndent() { I64 i; if (!formatted->len || formatted->data[formatted->len-1] == '\n') for (i = 0; i < format_indent * 4; i++) Char(formatted, ' '); }
U0 FSpace() { if (formatted->len && formatted->data[formatted->len-1] != ' ' && formatted->data[formatted->len-1] != '\n') Char(formatted, ' '); }
U0 FLine() {
    while (formatted->len && formatted->data[formatted->len-1] == ' ') formatted->len--;
    if (formatted->len && formatted->data[formatted->len-1] != '\n') Char(formatted, '\n');
    if (formatted->data) formatted->data[formatted->len] = 0;
}
U0 FComments(U8 *src, I64 start, I64 end) {
    I64 i = start, begin;
    while (i < end) {
        if (src[i] == '/' && (src[i+1] == '/' || src[i+1] == '*')) {
            begin = i;
            if (src[i+1] == '/') { while (i < end && src[i] != '\n') i++; }
            else { i += 2; while (i + 1 < end && !(src[i] == '*' && src[i+1] == '/')) i++; i += 2; }
            FLine(); FIndent(); Append(formatted, Slice(src, begin, i)); FLine();
        } else i++;
    }
}
Bool FAtom(I64 kind) { return kind == K_ID || kind == K_INT || kind == K_STRING || kind == K_FLOAT; }
U0 FormatFile(U8 *path, U8 *output) {
    U8 *source; I64 size, i, last = 0, kind, prev = 0, parens = 0, brackets = 0, count, second, j; Token *t, *a, *b;
    source = FileRead(path, &size, NULL); if (!source) NativeExit(2);
    ValidateInput(source,size,path);
    LexSource(source, path); count = ntok; formatted = TextNew();
    for (i = 0; i < count; i++) {
        t = &tokens[i]; kind = t->kind; FComments(source, last, t->start); last = t->end;
        if (kind == '}') { FLine(); if (format_indent) format_indent--; }
        FIndent();
        if (kind == '{') { FSpace(); Append(formatted, "{"); format_indent++; FLine(); }
        else if (kind == '}') { Append(formatted, "}"); if (tokens[i+1].kind != ';' && tokens[i+1].kind != ',' && !(tokens[i+1].kind == K_ID && Eq(tokens[i+1].text, "else"))) FLine(); }
        else if (kind == ';') { Append(formatted, ";"); if (parens) FSpace(); else FLine(); }
        else if (kind == ',') { Append(formatted, ","); FSpace(); }
        else if (kind == ':') { Append(formatted, ":"); if (!brackets) FSpace(); }
        else if (kind == '(') {
            if (prev == K_ID && (Eq(tokens[i-1].text, "match") || Eq(tokens[i-1].text, "for") || Eq(tokens[i-1].text, "if") || Eq(tokens[i-1].text, "while") || Eq(tokens[i-1].text, "return"))) FSpace();
            Append(formatted, "("); parens++;
        }
        else if (kind == ')') { Append(formatted, ")"); parens--; }
        else if (kind == '.' || kind == '[' || kind == ']') { Append(formatted, t->raw); if (kind == '[') brackets++; if (kind == ']') brackets--; }
        else if (FAtom(kind)) {
            if (FAtom(prev) || prev == '}' || prev == ')') FSpace();
            Append(formatted, t->raw);
        } else if ((kind == '-' || kind == '!' || kind == '~') && !FAtom(prev) && prev != ')' && prev != ']') Append(formatted, t->raw);
        else { FSpace(); Append(formatted, t->raw); FSpace(); }
        prev = kind;
    }
    FComments(source, last, size); FLine(); Reserve(formatted, 0);
    // Refuse output if formatting would alter even one lexical token.
    second = ntok; LexSource(formatted->data, path);
    if (ntok - second != count) Error("formatter changed token count");
    for (j = 0; j < count; j++) {
        a = &tokens[j]; b = &tokens[second+j];
        if (a->kind != b->kind || !Eq(a->raw, b->raw)) ErrorAt(a, "formatter changed token spelling");
    }
    if (!FileWrite(output, formatted->data, formatted->len)) Error("cannot write formatted source");
}
