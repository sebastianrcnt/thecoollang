I64 TypeName(U8 *s) {
    if (Eq(s, "void")) return T_VOID;
    if (Eq(s, "i64")) return T_INT;
    if (Eq(s, "i32")) return T_I32;
    if (Eq(s, "u8")) return T_U8;
    if (Eq(s, "i8")) return T_I8;
    if (Eq(s, "i16")) return T_I16;
    if (Eq(s, "u16")) return T_U16;
    if (Eq(s, "u32")) return T_U32;
    if (Eq(s, "u64") || Eq(s, "usize")) return T_U64;
    if (Eq(s, "isize")) return T_INT;
    if (Eq(s, "f64")) return T_F64;
    if (Eq(s, "f32")) return T_F32;
    if (Eq(s, "bool")) return T_BOOL;
    if (Eq(s, "string")) return T_STRING;
    return -1;
}
I64 ParseType() {
    I64 t, count, kind; Token *token = At(); U8 *name, *package = token->package;
    if (Take('&')) return ReferenceType(At());
    if (Is("own")) { pos++; Need('[', "expected '[' after own"); t = ParseType(); Need(']', "expected ']' after owned type"); return SequenceType(A_OWNER, t, 0, token); }
    if (Take('*')) { t = ParseType(); if (t >= 100*T_PTR) Error("pointer nesting limit exceeded"); return T_PTR+t; }
    if (Take('[')) {
        kind = A_ARRAY; count = 0;
        if (Take(']')) kind = A_SLICE;
        else { count = At()->val; Need(K_INT, "array length must be an integer literal"); Need(']', "expected ']'"); }
        return SequenceType(kind, ParseType(), count, token);
    }
    name = Ident(); t = BindingType(name); if (t >= 0) return t; t = TypeName(name); if (t >= 0) return t;
    if (FindType(package, name) < 0 && Take('.')) { package = ResolveAlias(token, name); name = Ident(); }
    t = FindType(package, name); if (t < 0) ErrorAt(token, "unsupported or unknown type");
    if (!Eq(package, token->package) && !Shape(t)->public) ErrorAt(token, "type is private to its package");
    EditorTypeReference(name,t);
    if (Shape(t)->generic_count) t = InstantiateType(t);
    return t;
}
I64 Prec(I64 k) {
    if (k == K_OR) return 1;
    if (k == K_AND) return 2;
    if (k == '|') return 3;
    if (k == '^') return 4;
    if (k == '&') return 5;
    if (k == K_EQ || k == K_NE) return 6;
    if (k == '<' || k == '>' || k == K_LE || k == K_GE) return 7;
    if (k == K_SHL || k == K_SHR) return 8;
    if (k == '+' || k == '-') return 9;
    if (k == '*' || k == '/' || k == '%') return 10;
    return 0;
}
extern Node *Expr(I64 min);
extern Node *Primary();
extern I64 SpecializeFunction(I64 template_id, I64 *types, I64 count);
Node *AggregateAddress(Node *n) {
    Node *address;
    if (n->kind == N_LOCAL) { address = NewNode(N_LOCAL_ADDRESS, n->token); address->slot = n->slot; address->type = T_PTR+n->type; address->mutable = n->mutable; address->local_ref = n->local_ref; return address; }
    if (n->kind == N_LOAD) return n->a;
    return n;
}
Node *AggregateLiteral(I64 type, Token *token) {
    Node *n = NewNode(N_AGG_LITERAL, token), *item, *tail = NULL, *prior; Field *field; I64 count = 0, element;
    Layout(type); ValidateBorrowedElements(type); n->type = type; n->storage = Storage(type); Need('{', "expected aggregate initializer");
    if (!Take('}')) {
        do {
            if (Shape(type)->kind == A_SLICE) Error("slice literals must be empty; borrow an array with [low:high]");
            if (Shape(type)->kind == A_STRUCT) { field = FindField(type, Ident(), token); Need(':', "expected ':' after field name"); element = field->type; }
            else element = Shape(type)->element;
            item = Expr(1); Coerce(item, element); Transfer(item);
            if (Shape(type)->kind == A_STRUCT) { item->offset = field->offset; item->field_key = field; } else item->offset = count*ByteSize(element);
            if (Shape(type)->kind == A_STRUCT) { for (prior = n->a; prior; prior = prior->next) if (prior->field_key == item->field_key) ErrorAt(token, "duplicate initializer field"); }
            if (tail) tail->next = item; else n->a = item; tail = item; count++;
            if (At()->kind == '}') break;
            Need(',', "expected ',' between initializers");
        } while (At()->kind != '}');
        Need('}', "expected '}' after initializer");
        if (count != Shape(type)->count) ErrorAt(token, "aggregate initializer must supply every element");
    } else if (Shape(type)->kind == A_STRUCT) {
        for (field = Shape(type)->fields; field; field = field->next) FindField(type, field->name, token);
    }
    return n;
}
Node *EnumLiteral(I64 type, Token *token) {
    Field *variant; Node *n, *tag, *payload;
    Layout(type); ValidateBorrowedElements(type); Need('.', "enum construction requires a variant"); variant = FindField(type, Ident(), token);
    n = NewNode(N_AGG_LITERAL, token); n->type = type; n->storage = Storage(type);
    tag = NewNode(N_INT, token); tag->type = T_INT; tag->value = variant->tag; n->a = tag;
    if (variant->type) { Need('(', "variant requires a payload"); payload = Expr(1); Coerce(payload, variant->type); Transfer(payload); Need(')', "expected ')' after payload"); payload->offset = 8; tag->next = payload; }
    else if (Take('(')) Need(')', "unit variant takes no arguments");
    return n;
}
Node *Atom() {
    Token *t = At(); Node *n, *tail = NULL, *arg; Local *l; I64 id, k, count = 0, ty, type_args[8], type_count = 0; U8 *name, *package; Bool qualified = FALSE;
    package = t->package;
    if(Is("borrow_raw"))return RawReferenceExpression();
    if (Is("move")) {
        pos++; n = Primary(); if (!Owned(n->type)) return n;
        if (n->kind == N_CALL || n->kind == N_NEW || n->kind == N_AGG_LITERAL || n->kind == N_MOVE) return n;
        l = BorrowRoot(n); if (l && Owned(l->type)) { if (l->moved) ErrorAt(t, "use of moved value"); if (l->loop_level < loop_depth) ErrorAt(t, "cannot move an outer owner inside a loop"); l->moved = TRUE; }
        if (n->kind == N_LOCAL) { arg = NewNode(N_LOCAL_ADDRESS, t); arg->slot = n->slot; arg->type = T_PTR+n->type; arg->local_ref = n->local_ref; }
        else if (n->kind == N_LOAD) arg = n->a; else ErrorAt(t, "move requires a place or a fresh value");
        tail = NewNode(N_MOVE, t); tail->a = arg; tail->type = n->type; tail->storage = Storage(n->type); return tail;
    }
    if (Is("new")) {
        pos++; Need('[', "expected '[' after new"); ty = ParseType(); Need(']', "expected ']'"); ValidateBorrowedElements(ty);
        if (Borrowed(ty)) ErrorAt(t, "owned storage cannot contain borrowed references");
        n = NewNode(N_NEW, t); n->type = SequenceType(A_OWNER, ty, 0, t); n->storage = Storage(n->type);
        Need('(', "expected '(' after new type"); if (!Take(')')) { n->a = Expr(1); Coerce(n->a, ty); Transfer(n->a); Need(')', "expected ')' after new initializer"); } return n;
    }
    if (At()->kind == '[') { ty = ParseType(); return AggregateLiteral(ty, t); }
    if (Is("sizeof")) { pos++; Need('(', "expected '('"); ty = ParseType(); Need(')', "expected ')'"); n = NewNode(N_INT, t); n->type = T_U64; n->value = ByteSize(ty); return n; }
    if (Is("null")) { pos++; n = NewNode(N_INT, t); n->type = T_NULL; return n; }
    if (Is("cast") && tokens[pos+1].kind == '[') {
        pos += 2; ty = ParseType(); Need(']', "expected ']' after cast type"); Need('(', "expected '(' after cast type");
        n = NewNode(N_CAST, t); n->a = Expr(1); n->type = ty; Need(')', "expected ')' after cast operand");
        if(IsReference(n->a->type))return ReferencePointerCast(n->a,ty,t);
        if (Pointer(ty) || Pointer(n->a->type)) {
            if (!unsafe_depth) ErrorAt(t, "pointer casts require unsafe");
            if (!(Pointer(ty) || ty == T_U64 || ty == T_INT || ty == T_STRING) || !(Pointer(n->a->type) || Integer(n->a->type) || n->a->type == T_NULL || n->a->type == T_STRING)) ErrorAt(t, "invalid pointer cast");
        } else if (!Numeric(ty) || !Numeric(n->a->type)) ErrorAt(t, "invalid cast");
        return n;
    }
    if (Take('&')) {
        if(!Is("raw")) return ReferenceExpression(t);
        if (Is("raw")) pos++;
        if (!unsafe_depth) ErrorAt(t, "taking an address requires unsafe");
        n = NewNode(N_LOCAL_ADDRESS, t); n->a = Primary();
        if (!n->a->mutable) ErrorAt(t, "cannot take a mutable address of let binding or parameter");
        if (n->a->kind == N_LOAD) return n->a->a;
        if (n->a->kind != N_LOCAL) ErrorAt(t, "address operand must be a local variable or projection");
        n->slot = n->a->slot; n->type = T_PTR + n->a->type; return n;
    }
    if (Take('*')) {
        n = NewNode(N_LOAD, t); n->a = Primary();
        if(IsReference(n->a->type)) return ReferenceLoad(n->a,t);
        if (AggregateKind(n->a->type) == A_OWNER) { arg = NewNode(N_OWN_ADDRESS, t); arg->a = n->a; arg->type = T_PTR+Shape(n->a->type)->element; n->a = arg; }
        else { if (!unsafe_depth) ErrorAt(t, "pointer dereference requires unsafe"); if (!Pointer(n->a->type) || n->a->type == T_PTR) ErrorAt(t, "dereference requires a typed pointer"); }
        n->type = n->a->type - T_PTR; n->mutable = TRUE; if (Aggregate(n->type)) n->storage = Storage(n->type); return n;
    }
    if (Take(K_INT)) { n = NewNode(N_INT, t); n->value = t->val; n->type = T_INT; if (t->val < 0) n->type = T_U64; return n; }
    if (Take(K_FLOAT)) { n = NewNode(N_INT, t); n->value = t->val; n->type = T_F64; return n; }
    if (Take(K_STRING)) { n = NewNode(N_STRING, t); n->name = LiteralString(t->text); n->type = T_STRING; return n; }
    if (Is("true") || Is("false")) { n = NewNode(N_INT, t); n->type = T_BOOL; n->value = Is("true"); pos++; return n; }
    if (Take('(')) { n = Expr(1); Need(')', "expected ')'"); return n; }
    if (t->kind == '-' || t->kind == '!' || t->kind == '~') {
        k = t->kind; pos++; n = NewNode(N_UNARY, t); n->op = k; n->a = Primary(); n->type = n->a->type;
        if (k == '!' && n->type != T_BOOL) ErrorAt(t, "logical negation requires bool");
        if ((k == '~' && !Integer(n->type)) || (k == '-' && !Numeric(n->type))) ErrorAt(t, "integer operand required");
        if (k == '-' && n->a->kind == N_INT && !Floating(n->type)) { if (n->a->type == T_U64 && n->a->value != (-0x7FFFFFFFFFFFFFFF - 1)) ErrorAt(t, "negative literal exceeds i64 range"); n->kind = N_INT; n->value = -n->a->value; if (n->a->type == T_U64) n->type = T_INT; }
        return n;
    }
    name = Ident();
    if (!FindLocal(name) && FindType(package, name) < 0 && Take('.')) { package = ResolveAlias(t, name); name = Ident(); qualified = TRUE; }
    ty = FindType(package, name); EditorTypeReference(name,ty);
    if (ty >= 0 && Shape(ty)->generic_count) ty = InstantiateType(ty);
    if (ty >= 0 && AggregateKind(ty) == A_ENUM) { if (qualified && !Shape(ty)->public) ErrorAt(t, "type is private to its package"); return EnumLiteral(ty, t); }
    if (ty < 0 && (qualified || !FindLocal(name)) && At()->kind == '[') type_count = TypeArguments(type_args);
    if (ty >= 0 && At()->kind == '{') { if (qualified && !Shape(ty)->public) ErrorAt(t, "type is private to its package"); return AggregateLiteral(ty, t); }
    if (Take('(')) {
        n = NewNode(N_CALL, t); n->name = name;
        if (!Take(')')) {
            do { arg = Expr(1); if (tail) tail->next = arg; else n->a = arg; tail = arg; count++; }
            while (Take(','));
            Need(')', "expected ')' after arguments");
        }
        n->value = count;
        if (!qualified && Eq(name, "len")) {
            if (count != 1 || (AggregateKind(n->a->type) != A_ARRAY && AggregateKind(n->a->type) != A_SLICE)) ErrorAt(t, "len expects an array or slice");
            n->kind = N_LENGTH; n->type = T_U64; return n;
        }
        ty = -1; if (!qualified) ty = TypeName(name);
        if (ty >= 0) {
            if (count != 1 || ty == T_VOID || ty == T_STRING || !Numeric(n->a->type) || !Numeric(ty)) ErrorAt(t, "cast expects one numeric operand and a numeric target");
            n->kind = N_CAST; n->type = ty; return n;
        }
        if (qualified && Eq(package, "std/io") && (Eq(name, "print") || Eq(name, "println"))) {
            if (count != 1 || n->a->type == T_VOID || Aggregate(n->a->type)) ErrorAt(t, "print/println expects one scalar value");
            n->slot = -1; n->type = T_VOID; return n;
        }
        if (qualified && Eq(package, "std/mem")) {
            if (Eq(name, "owner_count")) { if (count) Error("owner_count takes no arguments"); n->slot = -6; n->type = T_U64; return n; }
            if (Eq(name, "alloc")) {
                if (count != 1) ErrorAt(t, "mem.alloc requires a byte count");
                Coerce(n->a, T_U64); n->slot = -3; n->type = T_PTR + T_U8; return n;
            }
            if (Eq(name, "free")) {
                if (!unsafe_depth) ErrorAt(t, "manual free requires unsafe");
                if (count != 1 || !Pointer(n->a->type)) ErrorAt(t, "mem.free requires a pointer");
                n->slot = -4; n->type = T_VOID; return n;
            }
            if (Eq(name, "copy")) {
                if (!unsafe_depth) ErrorAt(t, "raw memory copy requires unsafe");
                if (count != 3 || !Pointer(n->a->type) || !Pointer(n->a->next->type)) ErrorAt(t, "mem.copy requires destination, source, byte count");
                Coerce(n->a->next->next, T_U64); n->slot = -5; n->type = T_VOID; return n;
            }
            ErrorAt(t, "unknown std/mem function");
        }
        if (!qualified && Eq(name, "assert")) {
            if (count != 1 || n->a->type != T_BOOL) ErrorAt(t, "assert expects one bool");
            n->slot = -2; n->type = T_VOID; return n;
        }
        id = FindFunIn(package, name);
        if (id < 0) ErrorAt(t, "unknown function");
        if (allow_redefinition && id == 0) ErrorAt(t, "internal session function is not callable");
        if (functions[id].foreign && !unsafe_depth) ErrorAt(t, "foreign calls require unsafe");
        if (qualified && !functions[id].public) ErrorAt(t, "function is private to its package");
        id = SpecializeFunction(id, type_args, type_count);
        if (count != functions[id].argc) ErrorAt(t, "wrong argument count");
        arg = n->a;
        for (k = 0; k < count; k++) { Coerce(arg, functions[id].arg_types[k]); Transfer(arg); arg = arg->next; }
        n->slot = id; n->type = functions[id].result; if (Aggregate(n->type)) n->storage = Storage(n->type); return n;
    }
    l = NULL; if (!qualified) l = FindLocal(name);
    if (!l) ErrorAt(t, "unknown variable (functions require explicit calls)");
    if (l->moved) ErrorAt(t, "use of moved value");
    n = NewNode(N_LOCAL, t); n->name = name; n->slot = l->slot; n->type = l->type; n->local_ref = l; n->mutable = l->mutable; if (Aggregate(n->type)) n->storage = Storage(n->type); return n;
}
Node *Primary() {
    Node *n = Atom(), *index, *address, *load, *high; Token *t; I64 kind, element; Field *field; Bool mutable;
    while (At()->kind == '[' || At()->kind == '.') {
        t = At();
        if (Take('.')) {
            if(MethodAhead()){n=MethodCall(n,t);goto primary_next;}
            kind = n->type; mutable = n->mutable;
            if (Pointer(kind)) { if (!unsafe_depth) ErrorAt(t, "pointer field access requires unsafe"); kind -= T_PTR; address = n; mutable = TRUE; }
            else address = AggregateAddress(n);
            if (AggregateKind(kind) != A_STRUCT) ErrorAt(t, "field access requires a struct");
            field = FindField(kind, Ident(), t); load = NewNode(N_FIELD_ADDRESS, t); load->a = address; load->value = field->offset; load->type = T_PTR+field->type;
            load->origin_source = n; n = NewNode(N_LOAD, t); n->origin_source = load->origin_source; n->a = load; n->type = field->type; n->mutable = mutable; if (Aggregate(n->type)) n->storage = Storage(n->type);
        } else {
            pos++; kind = AggregateKind(n->type); mutable = n->mutable;
            if (kind != A_ARRAY && kind != A_SLICE && (!Pointer(n->type) || n->type == T_PTR)) ErrorAt(t, "indexing requires an array, slice or typed pointer");
            if (!kind && !unsafe_depth) ErrorAt(t, "raw pointer indexing requires unsafe");
            if (At()->kind == ':') { index = NewNode(N_INT, t); index->type = T_INT; } else index = Expr(1);
            CheckLivePlace(n);
            if (!Integer(index->type)) ErrorAt(t, "index must be an integer");
            if (kind) element = Shape(n->type)->element; else element = n->type-T_PTR;
            if (Take(':')) {
                if (!kind) ErrorAt(t, "slicing requires an array or slice");
                if (Borrowed(element)) ErrorAt(t, "slice elements cannot contain borrowed slices until lifetime analysis exists");
                if (kind == A_ARRAY && !mutable) ErrorAt(t, "mutable slice requires a var array");
                high = NULL; if (At()->kind != ']') { high = Expr(1); if (!Integer(high->type)) ErrorAt(t, "slice bound must be an integer"); }
                Need(']', "expected ']'"); address = NewNode(N_SLICE, t); address->a = n; if (kind == A_ARRAY) address->a = AggregateAddress(n);
                address->origin_source = n; address->b = index; address->c = high; address->op = kind; address->value = Shape(n->type)->count;
                address->type = SequenceType(A_SLICE, element, 0, t); address->storage = Storage(address->type); n = address;
            } else {
                Need(']', "expected ']'"); address = NewNode(N_ADDRESS, t); address->a = n; address->b = index; address->type = T_PTR+element;
                if (kind) { address->kind = N_INDEX_ADDRESS; address->op = kind; address->value = Shape(n->type)->count; if (kind == A_ARRAY) address->a = AggregateAddress(n); }
                load = NewNode(N_LOAD, t); load->origin_source = n; load->a = address; load->type = element; load->mutable = mutable || kind == A_SLICE || !kind;
                if (Aggregate(element)) load->storage = Storage(element); n = load;
            }
        }
primary_next:;
    }
    return n;
}
Node *Expr(I64 min) {
    Node *a = Primary(), *n; Token *t; I64 p, op;
    while (Prec(At()->kind) >= min) {
        t = At(); op = t->kind; p = Prec(op); pos++;
        n = NewNode(N_BINARY, t); n->op = op; n->a = a; n->b = Expr(p + 1);
        if (op == K_AND || op == K_OR) {
            if (a->type != T_BOOL || n->b->type != T_BOOL) ErrorAt(t, "logical operators require bool operands");
            n->type = T_BOOL;
        } else {
            if ((op == '+' || op == '-') && Pointer(a->type) && Integer(n->b->type)) {
                if (!unsafe_depth) ErrorAt(t, "pointer arithmetic requires unsafe");
                if (a->type == T_PTR) ErrorAt(t, "void pointer arithmetic is not defined");
                n->kind = N_ADDRESS; n->type = a->type; a = n; goto expr_next;
            }
            if (a->type != n->b->type) {
                if (a->kind == N_INT) Coerce(a, n->b->type); else Coerce(n->b, a->type);
            }
            if (op == K_EQ || op == K_NE) {
                if (a->type == T_VOID || a->type == T_STRING || Aggregate(a->type)) ErrorAt(t, "equality requires integers or bool");
                n->type = T_BOOL;
            } else {
                if (!Numeric(a->type)) ErrorAt(t, "operator requires numeric operands");
                if (Floating(a->type) && (op == '%' || op == '&' || op == '|' || op == '^' || op == K_SHL || op == K_SHR)) ErrorAt(t, "operator requires integer operands");
                n->type = a->type;
                if (op == '<' || op == '>' || op == K_LE || op == K_GE) n->type = T_BOOL;
            }
        }
        if (!Floating(a->type) && (op == '/' || op == '%') && n->b->kind == N_INT && !n->b->value) ErrorAt(t, "division by zero");
        if ((op == K_SHL || op == K_SHR) && n->b->kind == N_INT && (n->b->value < 0 || n->b->value >= Width(n->a->type))) ErrorAt(t, "shift count must be below operand width");
        a = n;
expr_next:;
    }
    return a;
}
extern Node *Statement();
Node *Block() {
    Node *n = NewNode(N_BLOCK, At()), *tail = NULL, *s; Local *saved = locals;
    Need('{', "expected '{'"); depth++;
    while (!Take('}')) {
        if (!At()->kind) Error("unterminated block");
        s = Statement(); if (tail) tail->next = s; else n->a = s; tail = s; if (s->kind == N_BIND && Owned(s->type)) { tail->next = OwnerDefer(s->slot, s->type, s->token); tail = tail->next; }
    }
    depth--; locals = saved; return n;
}
extern Bool Returns(Node *n);
Node *MatchStatement() {
    Token *token = At(); Node *block, *value, *binding, *branch, *last = NULL, *previous = NULL, *address, *load, *constant, *test, *arm, *payload_bind = NULL;
    I64 type, pattern, slot, count = 0, *seen; Field *variant; Local *saved, *local; U8 *name; Bool wildcard = FALSE; MoveState *moves;
    pos++; Need('(', "expected '(' after match"); value = Expr(1); Transfer(value); Need(')', "expected ')' after match value"); type = value->type;
    if (AggregateKind(type) != A_ENUM) ErrorAt(token, "match requires an enum"); Layout(type);
    block = NewNode(N_BLOCK, token); binding = NewNode(N_BIND, token); binding->type = type; binding->a = value; slot = Storage(type); binding->slot = slot; ReferenceMatchBinding(binding); block->a = binding;
    moves = MoveSnapshot(); seen = ScratchAllocate(Shape(type)->count*8); Need('{', "expected match arms");
    while (!Take('}')) {
        if (wildcard) Error("wildcard must be the last match arm");
        MoveRestore(moves); saved = locals; depth++; payload_bind = NULL;
        if (Is("_")) { pos++; wildcard = TRUE; }
        else {
            pattern = ParseType(); if (pattern != type) Error("match pattern has a different enum type"); Need('.', "expected enum variant"); variant = FindField(type, Ident(), token);
            if (seen[variant->tag]) Error("duplicate match arm"); seen[variant->tag] = TRUE; count++;
            address = NewNode(N_LOCAL_ADDRESS, token); address->slot = slot; address->local_ref = binding->local_ref; address->type = T_PTR+type;
            load = NewNode(N_LOAD, token); load->a = address; load->type = T_INT;
            constant = NewNode(N_INT, token); constant->type = T_INT; constant->value = variant->tag;
            test = NewNode(N_BINARY, token); test->op = K_EQ; test->a = load; test->b = constant; test->type = T_BOOL;
            if (variant->type) {
                Need('(', "payload variant requires a binding"); name = Ident(); Need(')', "expected ')' after pattern binding");
                if (!Eq(name, "_")) {
                    branch = NewNode(N_FIELD_ADDRESS, token); branch->a = address; branch->value = 8; branch->type = T_PTR+variant->type;
                    load = NewNode(N_LOAD, token); load->a = branch; load->origin_source = value; load->type = variant->type; if (Aggregate(load->type)) load->storage = Storage(load->type);
                    local = AddLocal(name, variant->type, FALSE); payload_bind = NewNode(N_BIND, token); if (Owned(load->type)) { constant = NewNode(N_MOVE, token); constant->a = branch; constant->type = load->type; constant->storage = Storage(load->type); load = constant; }
                    payload_bind->a = load; payload_bind->local_ref = local; payload_bind->type = variant->type; payload_bind->slot = local->slot;
                }
            } else if (Take('(')) Need(')', "unit variant takes no binding");
        }
        Need(K_FAT_ARROW, "expected '=>' after match pattern"); arm = Block();
        if (payload_bind) { branch = NewNode(N_BLOCK, token); branch->a = payload_bind; if (Owned(payload_bind->type)) { payload_bind->next = OwnerDefer(payload_bind->slot, payload_bind->type, token); payload_bind->next->next = arm; } else payload_bind->next = arm; arm = branch; }
        if(!Returns(arm)) MoveJoin(moves); locals = saved; depth--; Take(',');
        if (wildcard) { if (last) last->c = arm; else binding->next = arm; }
        else { branch = NewNode(N_IF, token); branch->a = test; branch->b = arm; if (last) last->c = branch; else binding->next = branch; previous = last; last = branch; }
    }
    if (!wildcard) {
        if (count != Shape(type)->count) ErrorAt(token, "non-exhaustive match");
        if (previous) previous->c = last->b; else binding->next = last->b;
    }
    if (Owned(type)) { branch = OwnerDefer(slot, type, token); branch->next = binding->next; binding->next = branch; }
    MoveFinish(moves); ScratchRelease(seen); return block;
}
Node *Statement() {
    Token *t = At(); Node *n, *initial, *post, *block; Local *l, *saved; U8 *name; I64 ty = -1; Bool mutable; MoveState *moves;
    if (t->kind == '{') return Block();
    if (Is("match")) return MatchStatement();
    if (Is("unsafe")) { pos++; unsafe_depth++; n = Block(); unsafe_depth--; return n; }
    if (Is("let") || Is("var")) {
        mutable = Is("var"); pos++; name = Ident(); if (Take(':')) ty = ParseType();
        Need('=', "variables must have an initializer");
        n = NewNode(N_BIND, t); n->a = Expr(1);
        if (ty < 0) ty = n->a->type;
        if (ty == T_VOID) ErrorAt(t, "cannot bind a void value");
        Coerce(n->a, ty); Transfer(n->a); l = AddLocal(name, ty, mutable); n->slot = l->slot; n->local_ref = l; n->type = ty;
        Need(';', "expected ';'"); return n;
    }
    if (Is("return")) {
        pos++; n = NewNode(N_RETURN, t); ty = functions[current_fun].result;
        if (At()->kind != ';') { n->a = Expr(1); Coerce(n->a, ty); Transfer(n->a); }
        else if (ty != T_VOID) ErrorAt(t, "return value required");
        Need(';', "expected ';'"); return n;
    }
    if (Is("for")) {
        pos++; Need('(', "expected '(' after for"); saved = locals; depth++;
        block = NewNode(N_BLOCK, t); initial = NULL;
        if (!Take(';')) {
            initial = Statement();
            if (initial->kind != N_BIND && initial->kind != N_ASSIGN && initial->kind != N_EXPR) ErrorAt(t, "invalid for initializer");
        }
        moves = MoveSnapshot(); MoveJoin(moves);
        loop_depth++; n = NewNode(N_FOR, t);
        if (Take(';')) { n->a = NewNode(N_INT, t); n->a->type = T_BOOL; n->a->value = 1; }
        else { n->a = Expr(1); Need(';', "expected ';' after for condition"); }
        if (n->a->type != T_BOOL) ErrorAt(t, "for condition must be bool");
        if (!Take(')')) {
            post = NewNode(N_EXPR, At()); post->a = Expr(1);
            if (Take('=')) {
                if (!post->a->mutable) ErrorAt(t, "cannot assign through an immutable value");
                if (post->a->kind == N_LOCAL) {
                    l = FindLocal(post->a->name); if (!l->mutable) ErrorAt(t, "cannot assign to let binding or parameter");
                    post->kind = N_ASSIGN; post->local_ref = l; post->slot = l->slot; post->type = l->type; post->a = Expr(1); Coerce(post->a, post->type); Transfer(post->a); l->moved = FALSE;
                } else if (post->a->kind == N_LOAD) {
                    post->kind = N_STORE; post->type = post->a->type; post->a = post->a->a; post->b = Expr(1); Coerce(post->b, post->type); Transfer(post->b); CheckLivePlace(post->a);
                } else ErrorAt(t, "invalid for update assignment");
            }
            n->c = post; Need(')', "expected ')' after for update");
        }
        MoveRestore(moves); n->b = Block(); MoveJoin(moves); MoveFinish(moves); loop_depth--; depth--; locals = saved;
        if (initial) { block->a = initial; if (initial->kind == N_BIND && Owned(initial->type)) { initial->next = OwnerDefer(initial->slot, initial->type, initial->token); initial->next->next = n; } else initial->next = n; } else block->a = n;
        return block;
    }
    if (Is("if") || Is("while")) {
        mutable = Is("while"); pos++; n = NewNode(N_IF, t); if (mutable) n->kind = N_WHILE;
        if (mutable) loop_depth++;
        Need('(', "expected '(' before condition"); n->a = Expr(1); Need(')', "expected ')' after condition");
        if (n->a->type != T_BOOL) ErrorAt(t, "condition must have type bool");
        moves = MoveSnapshot(); if (mutable) MoveJoin(moves); n->b = Block(); if(mutable || !Returns(n->b)) MoveJoin(moves);
        if (!mutable) MoveRestore(moves);
        if (mutable) loop_depth--;
        else if (Is("else")) { pos++; if (Is("if")) n->c = Statement(); else n->c = Block(); }
        if(mutable || !Returns(n->c)) MoveJoin(moves); MoveFinish(moves); return n;
    }
    if (Is("break") || Is("continue")) {
        if (!loop_depth) Error("loop control outside a loop");
        n = NewNode(N_BREAK, t); if (Is("continue")) n->kind = N_CONTINUE;
        pos++; Need(';', "expected ';'"); return n;
    }
    if (Is("defer")) {
        pos++; n = NewNode(N_DEFER, t); n->a = Expr(1);
        if (n->a->kind != N_CALL || n->a->type != T_VOID) ErrorAt(t, "defer requires a void function call");
        Need(';', "expected ';'"); return n;
    }
    if (t->kind == K_ID && tokens[pos + 1].kind == '=') {
        name = Ident(); pos++; l = FindLocal(name);
        if (!l) ErrorAt(t, "unknown assignment target");
        if (!l->mutable) ErrorAt(t, "cannot assign to let binding or parameter");
        n = NewNode(N_ASSIGN, t); n->local_ref = l; n->slot = l->slot; n->type = l->type; n->a = Expr(1); Coerce(n->a, l->type); Transfer(n->a); l->moved = FALSE;
        Need(';', "expected ';'"); return n;
    }
    n = NewNode(N_EXPR, t); n->a = Expr(1);
    if (Take('=')) {
        if (n->a->kind != N_LOAD) ErrorAt(t, "invalid assignment target");
        if (!n->a->mutable) ErrorAt(t, "cannot assign through an immutable value");
        n->kind = N_STORE; n->type = n->a->type; n->a = n->a->a;
        n->b = Expr(1); Coerce(n->b, n->type); Transfer(n->b); CheckLivePlace(n->a);
    }
    Need(';', "expected ';'"); return n;
}
Bool Returns(Node *n) {
    if (!n) return FALSE;
    if (n->kind == N_RETURN) return TRUE;
    if (n->kind == N_IF) return Returns(n->b) && Returns(n->c);
    if (n->kind == N_BLOCK) { n = n->a; while (n) { if (Returns(n)) return TRUE; n = n->next; } }
    return FALSE;
}
U0 FunctionSignature(Function *f) {
    I64 i; U8 *name; f->borrow_contract = f->has_contract = 0;
    Need('(', "expected '(' after function name");
    if (!Take(')')) {
        do { if (f->argc == 32) Error("function argument limit exceeded"); f->arg_names[f->argc] = Ident(); Need(':', "expected ':' after parameter"); f->arg_types[f->argc] = ParseType(); ValidateBorrowedElements(f->arg_types[f->argc]); if (!f->arg_types[f->argc]) Error("parameter cannot be void"); f->argc++; } while (Take(','));
        Need(')', "expected ')'");
    }
    if (Take(K_ARROW)) { f->result = ParseType(); ValidateBorrowedElements(f->result); }
    if (Is("borrows")) {
        pos++; f->has_contract = TRUE; Need('(', "expected '(' after borrows");
        if (!Take(')')) {
            do { name = Ident(); for (i = 0; i < f->argc; i++) if (Eq(name, f->arg_names[i])) break; if (i == f->argc) Error("unknown parameter in borrows contract"); if (Borrowed(f->result) && !Borrowed(f->arg_types[i])) Error("borrows source must contain borrowed references"); f->borrow_contract |= 1 << i; } while (Take(','));
            Need(')', "expected ')' after borrows contract");
        }
    }
    if (Borrowed(f->result) && !f->has_contract) ErrorAt(f->token, "returning borrowed values requires a borrows(parameter) contract");
    ValidateMethodSignature(f);
}
I64 specialization_depth;
I64 SpecializeFunction(I64 template_id, I64 *types, I64 count) {
    Function *base = &functions[template_id], *f; I64 i, j, id, saved_pos = pos, saved_fun = current_fun, saved_depth = depth, saved_loop = loop_depth, saved_unsafe = unsafe_depth; Local *saved_locals = locals; TypeBinding *saved_bindings = type_bindings;
    if (count != base->generic_count) Error("wrong generic argument count");
    if (!count) return template_id;
    for (i = 0; i < nfun; i++) if (functions[i].origin == template_id+1) { for (j = 0; j < count; j++) if (functions[i].generic_args[j] != types[j]) goto function_different; return i; function_different:; }
    if (++specialization_depth > 64 || nfun == MAX_FUNCTIONS) Error("generic specialization limit exceeded");
    id = nfun++; f = &functions[id]; MemSet(f, 0, sizeof(Function)); f->name = base->name; f->package = base->package; f->public = base->public; f->token = base->token; f->origin = template_id+1;
    for (j = 0; j < count; j++) f->generic_args[j] = types[j];
    BindTypes(base->generic_names, types, count); pos = base->signature; FunctionSignature(f); f->begin = pos;
    current_fun = id; locals = NULL; depth = loop_depth = unsafe_depth = 0;
    for (j = 0; j < f->argc; j++) { Local *parameter = AddLocal(f->arg_names[j], f->arg_types[j], FALSE); if (Borrowed(parameter->type)) parameter->region = 1 << j; }
    f->body = Block(); AnalyzeBorrows(f); AnalyzeReferences(f); InjectDrops(f); f->end = pos; if (f->result != T_VOID && !Returns(f->body)) ErrorAt(f->token, "not every path returns a value");
    pos = saved_pos; current_fun = saved_fun; depth = saved_depth; loop_depth = saved_loop; unsafe_depth = saved_unsafe; locals = saved_locals; type_bindings = saved_bindings; specialization_depth--; return id;
}
U0 ParseProgram() {
    Function previous,*f, *old; U8 *name, *alias, *path; I64 braces, i, j, k, id, parsed[4096], count = 0; Bool public, foreign, exported; Token *t;
    if (!functions) functions = CAlloc(MAX_FUNCTIONS * sizeof(Function));
    CollectTypes();
    while (At()->kind) {
        if (Is("package")) { pos++; Ident(); Need(';', "expected ';' after package"); }
        else if (Is("import")) {
            t = At(); pos++; alias = NULL;
            if (At()->kind == K_ID) alias = Ident();
            if (At()->kind != K_STRING) Error("expected import path string");
            path = At()->text;
            if (!alias) { alias = path; for (j = 0; path[j]; j++) if (path[j] == '/') alias = path + j + 1; }
            if (!*alias) Error("empty import name");
            pos++; Need(';', "expected ';' after import");
        } else {
            public = FALSE; if (Is("pub")) { public = TRUE; pos++; }
            if (Is("struct") || Is("enum")) { pos++; name = Ident(); id = FindType(At()->package, name); if (!Shape(id)->generic_count) { Layout(id); ValidateBorrowedElements(id); } pos = Shape(id)->end+1; Take(';'); goto declaration_next; }
            foreign = FALSE; exported = FALSE;
            if (Is("extern") || Is("export")) {
                exported = Is("export"); foreign = !exported; pos++;
                if (At()->kind != K_STRING || !Eq(At()->text, "C")) Error("only extern C is supported");
                pos++;
            }
            if (!Is("fn")) Error("expected fn, package or import declaration");
            pos++; name = MethodDeclarationName();
            if (FindType(At()->package, name) >= 0) Error("function name conflicts with a type");
            id = FindFunIn(At()->package, name); old = NULL;
            if (id >= 0) {
                if (!allow_redefinition) Error("duplicate function declaration");
                if (id == 0) Error("internal session function cannot be redefined");
                for (j = 0; j < count; j++) if (parsed[j] == id) Error("duplicate declaration in submission");
                old = &previous; MemCpy(old, &functions[id], sizeof(Function));
            } else {
                if (nfun >= MAX_FUNCTIONS) Error("function limit exceeded");
                id = nfun++;
            }
            parsed[count++] = id; f = &functions[id];
            // Clear compilation products so only the changed function is recompiled.
            f->drops = NULL; f->all_locals = NULL; f->allocated_locals=NULL;f->nodes=NULL;f->body=NULL;f->machine_size=0; f->bytecode = NULL; f->byte_allocations = NULL; f->machine = NULL; f->code_count = f->code_capacity = f->registers = f->slots = f->calls = f->argc = f->result = 0;
            f->foreign = foreign; f->exported = exported; f->name = name; f->package = At()->package; f->public = public; f->token = At();
            if (old && (old->generic_count || At()->kind == '[')) Error("generic redefinition requires a new session");
            f->generic_count = GenericNames(f->generic_names); ValidateMethodTemplate(f); f->signature = pos;
            if (f->generic_count) { if (foreign || exported) Error("C ABI functions cannot be generic"); while (At()->kind && At()->kind != '{') pos++; }
            else FunctionSignature(f);
            if (old) {
                if(old->foreign!=f->foreign || old->exported!=f->exported)ErrorAt(f->token,"C ABI change requires a new session");
                if (old->argc != f->argc || old->result != f->result || old->borrow_contract != f->borrow_contract) ErrorAt(f->token, "signature change requires a new session");
                for (j = 0; j < f->argc; j++) if (old->arg_types[j] != f->arg_types[j]) ErrorAt(f->token, "signature change requires a new session");
            }
            if (foreign || exported) {
                if (Eq(name, "main") || (StrLen(name) >= 7 && name[0] == '_' && name[1] == '_' && name[2] == 'c' && name[3] == 'o' && name[4] == 'o' && name[5] == 'l' && name[6] == '_') || (StrLen(name) >= 5 && name[0] == 'c' && name[1] == 'o' && name[2] == 'o' && name[3] == 'l' && name[4] == '_')) Error("reserved C runtime symbol");
                for (k = 0; k < nfun; k++) {
                    if (k != id && (functions[k].foreign || functions[k].exported) && Eq(functions[k].name, name)) {
                        if (exported || functions[k].exported) Error("duplicate exported C symbol");
                        if (functions[k].argc != f->argc || functions[k].result != f->result) Error("conflicting C function signature");
                        for (j = 0; j < f->argc; j++) if (functions[k].arg_types[j] != f->arg_types[j]) Error("conflicting C function signature");
                    }
                }
                if (Aggregate(f->result)) Error("C ABI aggregate values are not supported; use a pointer");
                for (j = 0; j < f->argc; j++) if (Aggregate(f->arg_types[j])) Error("C ABI aggregate values are not supported; use a pointer");
                if (f->result == T_STRING) Error("C ABI strings must use an explicit pointer");
                for (j = 0; j < f->argc; j++) if (f->arg_types[j] == T_STRING) Error("C ABI strings must use an explicit pointer");
                if (foreign) { Need(';', "expected ';' after extern declaration"); f->body = NULL; goto declaration_next; }
            }
            f->begin = pos; Need('{', "expected function body"); braces = 1;
            while (braces) {
                if (!At()->kind) Error("unterminated function body");
                if (Take('{')) braces++; else if (Take('}')) braces--; else pos++;
            }
            f->end = pos;
declaration_next:;
        }
    }
    for (i = 0; i < count; i++) {
        current_fun = parsed[i]; f = &functions[current_fun]; if (f->foreign || f->generic_count) goto parsed_next; pos = f->begin; locals = NULL; depth = 0; unsafe_depth = 0;
        for (j = 0; j < f->argc; j++) { Local *parameter = AddLocal(f->arg_names[j], f->arg_types[j], FALSE); if (Borrowed(parameter->type)) parameter->region = 1 << j; }
        f->body = Block(); AnalyzeBorrows(f); AnalyzeReferences(f); InjectDrops(f);
        if (f->result != T_VOID && !Returns(f->body)) ErrorAt(f->token, "not every path returns a value");
parsed_next:;
    }
}
