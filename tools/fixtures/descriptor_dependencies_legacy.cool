// Handwritten legacy mirror of the private descriptor dependency audit.
class AuditDependencies { U8 seen[4096]; I64 queue[4096],count; };
U0 AuditDependencyAdd(AuditDependencies *a,I64 type){I64 index;while(type>=100000)type-=100000;if(type<1000)return;index=type-1000;if(index>=naggregates || index>=4096)NativeExit(96);if(a->seen[index])return;a->seen[index]=1;a->queue[a->count++]=type;}
U0 AuditDependencyField(Field *field){ReplTypeChange *change;Field *current,*head;ReplTypeChange *previous;I64 i;for(change=repl_type_changes;change;change=change->next){head=change->target->fields;for(previous=repl_type_changes;previous!=change;previous=previous->next)if(previous->target==change->target)head=previous->saved.fields;if(head!=change->saved.fields)for(current=head;current;current=current->next)if(current==field)NativeExit(98);}for(i=repl_saved_types;i<naggregates;i++)for(current=aggregate_types[i].fields;current;current=current->next)if(current==field)NativeExit(98);}
U0 AuditDependencyHeaders(AggregateType *shape){ReplTypeChange *change;AggregateType *saved;I64 i;for(change=repl_type_changes;change;change=change->next)if(change->target==shape){saved=&change->saved;if(shape->kind!=saved->kind || shape->element!=saved->element || shape->origin!=saved->origin || shape->generic_count!=saved->generic_count)NativeExit(99);if((shape->kind==2 || shape->kind==6) && shape->count!=saved->count)NativeExit(99);for(i=0;i<8;i++)if(shape->generic_args[i]!=saved->generic_args[i])NativeExit(99);}}
U0 AuditDependencyLocal(AuditDependencies *a,Local *local){if(local)AuditDependencyAdd(a,local->type);}
I64 AuditDescriptorDependencies(){AuditDependencies a;ProvenanceNode *node;ProvenanceEdge *edge;ReferenceLoan *loan;AggregateType *shape,*effective;ReplTypeChange *change;Field *field;I64 i,position=0,type;MemSet(&a,0,sizeof(AuditDependencies));if(repl_graph)for(node=repl_graph->nodes;node;node=node->next){AuditDependencyAdd(&a,node->type);AuditDependencyLocal(&a,node->root);AuditDependencyLocal(&a,node->summary_root);for(edge=node->edges;edge;edge=edge->next)if(edge->kind==1){field=edge->key;if(!field)NativeExit(96);AuditDependencyField(field);AuditDependencyAdd(&a,field->type);}}for(loan=repl_loans;loan;loan=loan->next){AuditDependencyAdd(&a,loan->provenance_type);AuditDependencyLocal(&a,loan->root);AuditDependencyLocal(&a,loan->holder);AuditDependencyLocal(&a,loan->parent);}while(position<a.count){type=a.queue[position++];if(type-1000>=repl_saved_types)NativeExit(97);shape=Shape(type);AuditDependencyHeaders(shape);effective=shape;for(change=repl_type_changes;change;change=change->next)if(change->target==shape)effective=&change->saved;AuditDependencyAdd(&a,effective->element);AuditDependencyAdd(&a,effective->origin);for(i=0;i<8;i++)AuditDependencyAdd(&a,effective->generic_args[i]);for(field=effective->fields;field;field=field->next){AuditDependencyField(field);AuditDependencyAdd(&a,field->type);}}Out("AUDIT_DEPENDENCY_PREFLIGHT\n");return a.count;}
U0 AuditDependencyProbe(I64 mode){ProvenanceGraph graph;AggregateType *root;Field field;ReplTypeChange change,older;I64 i,count;MemSet(aggregate_types,0,4096*sizeof(AggregateType));naggregates=2;repl_saved_types=1;MemSet(&graph,0,sizeof(ProvenanceGraph));repl_graph=&graph;ProvenanceNodeNew(&graph,101000,NULL,1);root=&aggregate_types[0];root->kind=1;aggregate_types[1].kind=1;MemSet(&field,0,sizeof(Field));MemSet(&change,0,sizeof(ReplTypeChange));MemSet(&older,0,sizeof(ReplTypeChange));if(mode==1){root->fields=&field;field.type=101001;}if(mode==2){root->kind=5;root->element=1001;}if(mode==3)root->generic_args[0]=1001;if(mode==4)root->origin=1001;if(mode==5){repl_saved_types=2;root->fields=&field;field.type=101000;root->element=1001;aggregate_types[1].element=1000;}if(mode==6){repl_saved_types=2;change.target=root;change.saved=*root;root->fields=&field;field.type=1;repl_type_changes=&change;if(!ProvenanceEdgeNew(graph.nodes,1,&field,graph.nodes,1))NativeExit(96);}if(mode==7){naggregates=4096;repl_saved_types=4096;for(i=0;i<4096;i++){aggregate_types[i].kind=5;if(i<4095)aggregate_types[i].element=i+1001;}}if(mode==8 || mode==9){repl_saved_types=2;root->kind=6;root->element=1;change.target=root;change.saved=*root;repl_type_changes=&change;if(mode==8)root->count=1;if(mode==9){root->state=2;root->size=8;root->align=8;}}if(mode==10){change.target=root;change.saved=*root;root->fields=&field;field.type=1001;repl_type_changes=&change;}if(mode==11){repl_saved_types=2;change.target=root;change.saved=*root;change.saved.fields=&field;older.target=root;older.saved=*root;change.next=&older;field.type=1;repl_type_changes=&change;if(!ProvenanceEdgeNew(graph.nodes,1,&field,graph.nodes,1))NativeExit(96);}count=AuditDescriptorDependencies();if((mode==7 && count!=4096) || (mode==5 && count!=2) || ((mode==9 || mode==10) && count!=1))NativeExit(96);NativeExit(0);}
