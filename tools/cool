#!/usr/bin/env python3
"""Cool project driver. Parsing, typing, interpretation and emission run in Cool."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
from driver_common import atomic_write, cache_home, find_root

ROOT = Path(__file__).resolve().parents[1]
FRONTEND = Path(os.environ.get('COOL_FRONTEND', ROOT/'build/cool-compiler')).resolve()
_FRONTEND_DIGEST = None

def ensure_frontend():
    if 'COOL_FRONTEND' not in os.environ:
        ensure('build/cool-compiler')
    elif not FRONTEND.is_file():
        raise ValueError(f'frontend executable not found: {FRONTEND}')



def ensure(*targets):
    if (ROOT/'release.json').exists():
        from release_support import ensure_installed
        if ensure_installed(ROOT, targets):
            return
    (ROOT / 'build').mkdir(exist_ok=True)
    with (ROOT / 'build/.cool.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # This separately locked build cannot inherit make jobserver descriptors
        # through Python's closed subprocess fds. Start an independent serial make.
        env = dict(os.environ)
        for key in ('MAKEFLAGS', 'MFLAGS', 'MAKELEVEL'):
            env.pop(key, None)
        subprocess.run(['make', '-s', '-C', ROOT, *targets], check=True, stdout=sys.stderr, env=env)


def front(mode, source, *args, capture=False):
    return subprocess.run([FRONTEND, mode, source, *args],
                          check=True, text=True, capture_output=capture)


def frontend_digest():
    # One content hash per invocation, shared by all package scans/artifacts.
    # Do not persist this using mtimes: replacing a binary must invalidate scans.
    global _FRONTEND_DIGEST
    if _FRONTEND_DIGEST is None:
        _FRONTEND_DIGEST = hashlib.sha256(FRONTEND.read_bytes()).digest()
    return _FRONTEND_DIGEST


def metadata_many(paths, work):
    cached, missing = {}, {}
    for path in paths:
        if '\t' in str(path) or '\n' in str(path):
            raise ValueError('source paths cannot contain tabs or newlines')
        key = hashlib.sha256(b'cool-scan-v2\0' + frontend_digest() + path.read_bytes()).hexdigest()
        cache = cache_home() / 'scan' / key
        if cache.exists():
            cached[path] = cache.read_text()
        else:
            missing[str(path)] = (path, cache)
    if missing:
        manifest = work / 'scan.list'
        manifest.write_text(''.join(f'__scan\t{path}\n' for path in missing))
        # Language tokens are still scanned by Cool, once for all package files.
        output = front('scan-bundle', manifest, capture=True).stdout
        records = {path: [] for path in missing}
        for line in output.splitlines():
            path, kind, value = line.split('\t', 2)
            if path not in records or kind not in ('package', 'import'):
                raise ValueError('invalid frontend scan record')
            records[path].append(kind + '\t' + value + '\n')
        for name, (path, cache) in missing.items():
            lines = ''.join(records[name])
            atomic_write(cache, lines.encode())
            cached[path] = lines
    return {path: parse_metadata(path, cached[path]) for path in paths}


def parse_metadata(path, lines):
    package, imports = None, []
    for line in lines.splitlines():
        kind, value = line.split('\t', 1)
        if kind == 'package':
            if package is not None:
                raise ValueError(f'{path}: duplicate package declaration')
            package = value
        elif kind == 'import':
            imports.append(value)
    return package, imports


def bundle(entry, work, offline=False, frozen=False, include_tests=False, *, import_path=None):
    entry = Path(entry).resolve()
    if not entry.exists():
        raise ValueError(f'input does not exist: {entry}')
    root = find_root(entry)
    graph = None
    if root:
        from modules import Graph, Manifest
        graph = Graph(Manifest.read(root), offline, frozen).resolve()
    files, active, done = [], [], set()

    def visit(package, location):
        if package in active:
            raise ValueError('import cycle: ' + ' -> '.join([*active, package]))
        if package in done:
            return
        sources = [location] if location.is_file() else sorted(p for p in location.glob('*.cool') if include_tests or not p.name.endswith('_test.cool'))
        if not sources:
            raise ValueError(f'no Cool files in package {package}: {location}')
        active.append(package)
        declared = set()
        imports = set()
        scanned = metadata_many(sources, work)
        for source in sources:
            name, dependencies = scanned[source]
            if location.is_dir() and name is None:
                raise ValueError(f'{source}: directory packages require a package declaration')
            declared.add(name)
            imports.update(dependencies)
            if '\t' in str(source) or '\n' in str(source):
                raise ValueError('source paths cannot contain tabs or newlines')
        if len(declared) != 1:
            raise ValueError(f'mixed package declarations in {location}')
        for dependency in sorted(imports):
            visit_import(dependency)
        files.extend((package, source) for source in sources)
        active.pop(); done.add(package)

    def visit_import(dependency):
        if dependency in ('__main','__scan'):
            raise ValueError(f'reserved package identity: {dependency}')
        if dependency in ('std/io', 'std/mem'):
            return
        if dependency.startswith('std/'):
            standard = ROOT/'stdlib'/dependency[4:]
            if not standard.is_dir() or '..' in Path(dependency).parts:
                raise ValueError(f'unknown standard package: {dependency}')
            visit(dependency, standard)
            return
        if graph is None:
            raise ValueError(f'import {dependency} requires cool.mod')
        visit(dependency, graph.package(dependency))

    if import_path is None:
        visit('__main', entry)
    else:
        visit_import(import_path)
    manifest = work / 'sources.list'
    manifest.write_text(''.join(f'{package}\t{path}\n' for package, path in files))
    if graph:
        graph.save_sums()
    return manifest, files


def artifact(files, optimization):
    digest = hashlib.sha256(b'cool-artifact-v2\0' + optimization.encode() + frontend_digest())
    for path in (ROOT/'language/runtime.c', ROOT/'language/numeric.h', ROOT/'language/memory.h', ROOT/'language/args.h', ROOT/'build/language-runtime.o'):
        digest.update(path.read_bytes())
    digest.update(subprocess.check_output(['clang', '--version']))
    for package, path in files:
        digest.update(package.encode() + b'\0' + str(path).encode() + b'\0' + path.read_bytes())
    return cache_home() / 'build' / digest.hexdigest()


def native(bundle_path, files, optimization):
    target = artifact(files, optimization)
    target.parent.mkdir(parents=True, exist_ok=True)
    with (target.parent / (target.name + '.lock')).open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not target.exists():
            with tempfile.TemporaryDirectory(dir=target.parent, prefix='.build-') as tmp:
                tmp = Path(tmp)
                front('llvm-bundle', bundle_path, tmp/'program.ll')
                subprocess.run(['clang', '-Wno-override-module', optimization, tmp/'program.ll',
                                ROOT/'build/language-runtime.o', '-o', tmp/'program'], check=True)
                (tmp/'program').replace(target)
    return target


def module_command(args):
    from modules import Graph, Manifest, validate_path, version_key, tree_hash as tree_hash_for_vendor
    cwd = Path.cwd()
    if args.action == 'init':
        path = cwd/'cool.mod'
        if path.exists():
            raise ValueError('cool.mod already exists')
        validate_path(args.value)
        Manifest(cwd, args.value).write()
        return
    root = find_root(cwd)
    if not root:
        raise ValueError('no cool.mod; run cool mod init <module-path>')
    manifest = Manifest.read(root)
    if args.action == 'tidy':
        ensure_frontend()
        imports = set()
        for base, dirs, files in os.walk(root):
            dirs[:] = sorted(d for d in dirs if d not in ('build', 'vendor') and not d.startswith('.') and not (Path(base)/d/'cool.mod').exists())
            for name in files:
                if name.endswith('.cool'):
                    imports.update(metadata(Path(base)/name)[1])
        direct = set()
        for dependency in imports:
            if dependency.startswith('std/') or dependency == manifest.module or dependency.startswith(manifest.module + '/'):
                continue
            candidates = [p for p in manifest.requires if dependency == p or dependency.startswith(p + '/')]
            if candidates:
                direct.add(max(candidates, key=len))
            elif not any(dependency == p or dependency.startswith(p + '/') for p in manifest.replaces):
                raise ValueError(f'missing requirement for {dependency}; use cool get')
        manifest.requires = {p: v for p, v in manifest.requires.items() if p in direct}
    if args.action == 'get':
        if '@' not in args.value:
            raise ValueError('use module/path@vX.Y.Z')
        path, version = args.value.rsplit('@', 1)
        validate_path(path); version_key(version)
        manifest.requires[path] = version
    graph = Graph(manifest, getattr(args, 'offline', False), args.action == 'verify',
                  use_vendor=args.action in ('verify', 'graph')).resolve()
    if args.action in ('get', 'tidy'):
        # MVS-selected minimum versions become explicit requirements.
        manifest.requires.update(graph.selected)
        manifest.write()
    if args.action != 'verify':
        graph.save_sums()
    if args.action == 'vendor':
        destination = root/'vendor'
        with tempfile.TemporaryDirectory(dir=root, prefix='.cool-vendor-') as tmp:
            staged = Path(tmp)/'vendor'; staged.mkdir()
            for (path, version), source in graph.visited_roots.items():
                if path in graph.local:
                    raise ValueError('vendoring mutable local replacements is not supported; pin a version first')
                tree = staged/path if graph.selected[path] == version else staged/'.versions'/(path+'@'+version); tree.parent.mkdir(parents=True, exist_ok=True)
                shutil.copytree(source, tree, ignore=shutil.ignore_patterns('.git'))
                if tree_hash_for_vendor(tree) != graph.pending_sums[path, version]:
                    raise ValueError(f'module changed while vendoring: {path}')
            (staged/'cool.vendor.json').write_text(json.dumps(graph.selected, sort_keys=True, indent=2) + '\n')
            backup = Path(tmp)/'previous'
            if destination.exists():
                destination.rename(backup)
            try:
                staged.rename(destination)
            except BaseException:
                if backup.exists():
                    backup.rename(destination)
                raise
    for path, version in sorted(graph.selected.items()):
        print(f'{path} {version}')


def main():
    if len(sys.argv) > 1 and sys.argv[1] == 'legacy':
        if (ROOT/'release.json').exists():
            raise ValueError('legacy tools are available only in the source checkout')
        os.execv(str(ROOT/'tools/cool-legacy'), [str(ROOT/'tools/cool-legacy'), *sys.argv[2:]])
    parser = argparse.ArgumentParser(description=__doc__)
    class VersionAction(argparse.Action):
        def __call__(self, parser, namespace, values, option_string=None):
            from release_support import version
            print(version(ROOT)); parser.exit()
    parser.add_argument('--version', action=VersionAction, nargs=0, help='show compiler distribution version')
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('run', 'build', 'check', 'emit-ir'):
        p = sub.add_parser(name)
        p.add_argument('source', nargs='?', default='.')
        p.add_argument('--offline', action='store_true')
        p.add_argument('--frozen', action='store_true')
        if name == 'run':
            p.add_argument('--backend', choices=('auto', 'interp', 'tree', 'jit', 'llvm', 'llvm-jit'), default='auto')
        if name in ('build', 'emit-ir'):
            p.add_argument('-o', '--output', default='a.out' if name == 'build' else 'program.ll')
        if name in ('run', 'build'):
            p.add_argument('--release', action='store_true')
    sub.add_parser('doctor')
    p = sub.add_parser('repl'); p.add_argument('--offline',action='store_true'); p.add_argument('--frozen',action='store_true')
    p = sub.add_parser('test'); p.add_argument('source', nargs='?', default='.'); p.add_argument('--backend', choices=('interp', 'jit'), default='interp'); p.add_argument('--offline', action='store_true'); p.add_argument('--frozen', action='store_true')
    p = sub.add_parser('doc'); p.add_argument('source', nargs='?', default='.'); p.add_argument('--offline', action='store_true'); p.add_argument('--frozen', action='store_true')
    p = sub.add_parser('fmt'); p.add_argument('paths', nargs='*', default=['.']); p.add_argument('--check', action='store_true'); p.add_argument('--diff', action='store_true')
    p = sub.add_parser('get'); p.add_argument('value'); p.add_argument('--offline', action='store_true'); p.set_defaults(action='get')
    p = sub.add_parser('mod'); ms = p.add_subparsers(dest='action', required=True)
    q = ms.add_parser('init'); q.add_argument('value')
    for name in ('download', 'verify', 'graph', 'tidy', 'vendor'):
        q = ms.add_parser(name); q.add_argument('--offline', action='store_true')
    raw = sys.argv[1:]
    forwarded = []
    if '--' in raw:
        at = raw.index('--'); raw, forwarded = raw[:at], raw[at+1:]
    args = parser.parse_args(raw)
    if forwarded and args.command != 'run':
        parser.error('program arguments after -- require run')
    if args.command == 'doctor':
        from release_support import doctor
        raise SystemExit(0 if doctor(ROOT) else 2)
    if args.command in ('mod', 'get'):
        module_command(args); return
    ensure_frontend()
    if args.command == 'fmt':
        import difflib
        changed = False
        sources = []
        for item in args.paths:
            path = Path(item).resolve()
            if not path.exists():
                raise ValueError(f'input does not exist: {path}')
            if path.is_file():
                sources.append(path)
            else:
                for base, dirs, files in os.walk(path):
                    dirs[:] = sorted(d for d in dirs if not d.startswith('.') and d not in ('build', 'vendor', 'coolc', 'language') and not (Path(base)/d).is_symlink())
                    sources.extend(Path(base)/name for name in sorted(files) if name.endswith('.cool'))
        with tempfile.TemporaryDirectory(prefix='cool-fmt-') as tmp:
            output = Path(tmp)/'formatted.cool'
            for source in dict.fromkeys(sources):
                before = source.read_bytes()
                front('fmt', source, output)
                after = output.read_bytes()
                if before != after:
                    changed = True
                    if args.diff:
                        sys.stdout.writelines(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=str(source), tofile=str(source)))
                    elif not args.check:
                        # Preserve permissions when replacing a source file.
                        mode = source.stat().st_mode
                        atomic_write(source, after); source.chmod(mode)
                    else:
                        print(source)
        if changed and (args.check or args.diff):
            raise SystemExit(1)
        return
    if args.command == 'repl':
        from repl_driver import run_repl
        with tempfile.TemporaryDirectory(prefix='cool-repl-') as tmp:
            work=Path(tmp)
            def resolve(package):
                return bundle(Path.cwd(),work,args.offline,args.frozen,import_path=package)[1]
            run_repl(FRONTEND,sys.stdin.isatty(),work,resolve)
        return
    if args.command == 'build' or (args.command == 'run' and args.backend == 'llvm'):
        ensure('build/language-runtime.o')
    with tempfile.TemporaryDirectory(prefix='cool-') as tmp:
        work = Path(tmp)
        manifest, files = bundle(args.source, work, args.offline, args.frozen, args.command == 'test')
        if args.command == 'test':
            front('jit-test-bundle' if args.backend == 'jit' else 'test-bundle', manifest)
        elif args.command == 'doc':
            names = {0: 'void', 1: 'i64', 2: 'bool', 3: 'string', 4: 'i32', 5: 'u8', 6: 'i8', 7: 'i16', 8: 'u16', 9: 'u32', 10: 'u64', 11: 'f64', 12: 'f32'}
            def type_name(t):
                return '*' + type_name(t - 100000) if t >= 100000 else names[t]
            for line in front('symbols', manifest, capture=True).stdout.splitlines():
                if line.startswith('@type\t'):
                    _, key, spelling = line.split('\t'); names[int(key)] = spelling; continue
                if line.startswith('@struct\t'):
                    _, package, signature = line.split('\t')
                    if package == '__main': print(signature)
                    continue
                package, name, public, result, params = line.split('\t')
                if package != '__main' or public != '1':
                    continue
                arguments = ', '.join(n + ': ' + type_name(int(t)) for n, t in (p.split(':') for p in params.split(',') if p))
                print(f'pub fn {name}({arguments}) -> {type_name(int(result))};')
        elif args.command == 'check':
            front('check-bundle', manifest)
        elif args.command == 'emit-ir':
            output = Path(args.output).resolve()
            if output in [p for _, p in files]:
                raise ValueError('output would overwrite source')
            front('llvm-bundle', manifest, work/'program.ll')
            atomic_write(output, (work/'program.ll').read_bytes())
        elif args.command == 'run' and args.backend in ('auto', 'interp', 'tree', 'jit'):
            mode = {'auto': 'auto-bundle', 'interp': 'bytecode-bundle', 'tree': 'run-bundle', 'jit': 'jit-bundle'}[args.backend]
            front(mode, manifest, *forwarded)
        elif args.command == 'run' and args.backend == 'llvm-jit':
            lli = os.environ.get('COOL_LLI') or shutil.which('lli')
            if not lli and Path('/opt/homebrew/opt/llvm/bin/lli').exists():
                lli = '/opt/homebrew/opt/llvm/bin/lli'
            if not lli:
                raise ValueError('LLVM lli not found; set COOL_LLI')
            ensure('build/language-runtime.dylib')
            front('llvm-bundle', manifest, work/'program.ll')
            subprocess.run([lli, '--dlopen=' + str(ROOT/'build/language-runtime.dylib'), work/'program.ll', *forwarded], check=True)
        else:
            binary = native(manifest, files, '-O2' if args.release else '-O0')
            if args.command == 'run':
                subprocess.run([binary, *forwarded], check=True)
            else:
                output = Path(args.output).resolve()
                if output in [p for _, p in files]:
                    raise ValueError('output would overwrite source')
                atomic_write(output, binary.read_bytes()); output.chmod(0o755)


if __name__ == '__main__':
    try:
        main()
    except subprocess.CalledProcessError as error:
        if error.stderr:
            sys.stderr.write(error.stderr)
        raise SystemExit(error.returncode if error.returncode > 0 else 128 - error.returncode)
    except (OSError, ValueError) as error:
        print(f'cool: {error}', file=sys.stderr)
        raise SystemExit(2)
