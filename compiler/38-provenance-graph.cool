// A graph owns its nodes and edges. Cursors are query inputs, never retained.
// Descriptor identities are opaque keys: the graph does not own type layouts.
// Edges may only target nodes owned by this graph; cross-arena substitution
// requires copying into the destination arena before linking.
// Installing persistent graphs must pin their descriptors under transaction
// ownership before the current two-layer checker can use this representation.
struct ProvenanceGraph { nodes: *ProvenanceNode; }
struct ProvenanceNode {
    // Arena-local semantic summary keys survive compaction with live nodes.
    // Kind 1=type skeleton, 2=value bound, 3=referent bound, 4=shared-origin skeleton.
    // Owned reachability for canonical summaries; never an authorization edge.
    summary_base: *ProvenanceNode;
    summary_root: *Local;
    summary_kind: i64;
    summary_mode: i64;
    opaque: i64;
    graph: *ProvenanceGraph;
    type: i64;
    root: *Local;
    // Terminal root capability; intermediate barriers belong to edges.
    exclusive: i64;
    edges: *ProvenanceEdge;
    next: *ProvenanceNode;
}
struct ProvenanceEdge {
    kind: i64;
    key: i64;
    exclusive: i64;
    target: *ProvenanceNode;
    next: *ProvenanceEdge;
}
struct ProvenanceCursor {
    type: i64;
    kind: i64;
    key: i64;
    next: *ProvenanceCursor;
}
struct ProvenanceQueryState {
    node: *ProvenanceNode;
    cursor: *ProvenanceCursor;
    exclusive: i64;
    next: *ProvenanceQueryState;
}
fn ProvenanceNodeNew(graph: *ProvenanceGraph, type: i64, root: *Local, exclusive: i64) -> *ProvenanceNode {
    unsafe {
        let node = cast[*ProvenanceNode](CAlloc(i64(sizeof(ProvenanceNode))));
        node.graph = graph;
        node.type = type;
        node.root = root;
        node.exclusive = BoolInt(exclusive != 0);
        node.next = graph.nodes;
        graph.nodes = node;
        return node;
    }
}
fn ProvenanceEdgeNew(node: *ProvenanceNode, kind: i64, key: i64, target: *ProvenanceNode, exclusive: i64) -> bool {
    unsafe {
        if (node == null || kind < 1 || kind > 4) { return false; }
        if (target != null && target.graph != node.graph) { return false; }
        // Merging identical edges preserves both actual capabilities when the
        // same declaration receives shared and exclusive source paths.
        let mode = BoolInt(exclusive != 0);
        var edge = node.edges;
        while (edge != null) {
            if (edge.kind == kind && edge.key == key && edge.target == target && edge.exclusive == mode) { return true; }
            edge = edge.next;
        }
        let fresh = cast[*ProvenanceEdge](CAlloc(i64(sizeof(ProvenanceEdge))));
        fresh.kind = kind;
        fresh.key = key;
        fresh.target = target;
        fresh.exclusive = mode;
        fresh.next = node.edges;
        node.edges = fresh;
        return true;
    }
}
fn ProvenanceGraphFree(graph: *ProvenanceGraph) {
    unsafe {
        var node = graph.nodes;
        graph.nodes = null;
        while (node != null) {
            let next = node.next;
            var edge = node.edges;
            while (edge != null) {
                let following = edge.next;
                Free(cast[*u8](edge));
                edge = following;
            }
            Free(cast[*u8](node));
            node = next;
        }
    }
}
fn ProvenanceQueryAppend(head: *ProvenanceQueryState, tail: *ProvenanceQueryState, node: *ProvenanceNode, cursor: *ProvenanceCursor, exclusive: i64) -> *ProvenanceQueryState {
    unsafe {
        if (node == null) { return tail; }
        var state = head;
        while (state != null) {
            if (state.node == node && state.cursor == cursor && state.exclusive == exclusive) { return tail; }
            state = state.next;
        }
        let fresh = cast[*ProvenanceQueryState](CAlloc(i64(sizeof(ProvenanceQueryState))));
        fresh.node = node;
        fresh.cursor = cursor;
        fresh.exclusive = exclusive;
        tail.next = fresh;
        return fresh;
    }
}
// Select a root at a value-relative cursor. This is payload selection, not
// physical prefix-overlap: moving an ancestor needs a separate protection query.
// Each (node,cursor,actual mode) state is processed once; type-only visited sets
// would lose recursive projections or a second path with different permission.
fn ProvenanceQueryRoot(start: *ProvenanceNode, cursor: *ProvenanceCursor, root: *Local, exclusive: i64, writing: bool) -> bool {
    unsafe {
        if (start == null || root == null) { return false; }
        let first = cast[*ProvenanceQueryState](CAlloc(i64(sizeof(ProvenanceQueryState))));
        first.node = start;
        first.cursor = cursor;
        first.exclusive = BoolInt(exclusive != 0);
        var tail = first;
        var current = first;
        var found = false;
        while (current != null) {
            let node = current.node;
            let path = current.cursor;
            if (path == null) {
                if (node.root == root && (!writing || (current.exclusive & node.exclusive) != 0)) {
                    found = true;
                    break;
                }
            } else if (path.type == node.type) {
                var edge = node.edges;
                while (edge != null) {
                    // Elements select a conservative union. Only declaration
                    // projections use keys; byte offsets never identify fields.
                    if (edge.kind == path.kind && (path.kind != 1 || edge.key == path.key)) {
                        tail = ProvenanceQueryAppend(first, tail, edge.target, path.next, current.exclusive & edge.exclusive);
                    }
                    edge = edge.next;
                }
            }
            current = current.next;
        }
        current = first;
        while (current != null) {
            let next = current.next;
            Free(cast[*u8](current));
            current = next;
        }
        return found;
    }
}

// Copy reachable nodes into a destination arena before linking a substituted
// value. Sharing and cycles survive through source-node identity, not type IDs.
// Root Locals and declaration/type identities remain borrowed metadata.
struct ProvenanceCopyState {
    source: *ProvenanceNode;
    target: *ProvenanceNode;
    next: *ProvenanceCopyState;
}
fn ProvenanceCopyFind(head: *ProvenanceCopyState, source: *ProvenanceNode) -> *ProvenanceCopyState {
    unsafe {
        var state = head;
        while (state != null) {
            if (state.source == source) { return state; }
            state = state.next;
        }
        return null;
    }
}
fn ProvenanceCopyNew(graph: *ProvenanceGraph, source: *ProvenanceNode) -> *ProvenanceCopyState {
    unsafe {
        let state = cast[*ProvenanceCopyState](CAlloc(i64(sizeof(ProvenanceCopyState))));
        state.source = source;
        state.target = ProvenanceNodeNew(graph, source.type, source.root, source.exclusive);
        state.target.opaque = source.opaque;
        state.target.summary_root = source.summary_root;
        state.target.summary_kind = source.summary_kind;
        state.target.summary_mode = source.summary_mode;
        return state;
    }
}
// One map spans every supplied root, preserving sharing between loans.
// Failed insertion rolls back only allocations made by this copy operation.
fn ProvenanceGraphCopyRoots(graph: *ProvenanceGraph, sources: **ProvenanceNode, targets: **ProvenanceNode, count: i64) -> bool {
    unsafe {
        if (count < 0 || count > 1152921504606846975) { return false; }
        if (count > 0) {
            if (sources == null || targets == null) { return false; }
            let input = cast[i64](sources);
            let output = cast[i64](targets);
            let span = count * 8;
            if ((input <= output && output - input < span) || (output < input && input - output < span)) { return false; }
        }
        let before = graph.nodes;
        var first: *ProvenanceCopyState = null;
        var tail: *ProvenanceCopyState = null;
        for (var index: i64 = 0; index < count; index = index + 1) {
            targets[index] = null;
            if (sources[index] != null) {
                var mapped = ProvenanceCopyFind(first, sources[index]);
                if (mapped == null) {
                    mapped = ProvenanceCopyNew(graph, sources[index]);
                    if (tail == null) { first = mapped; } else { tail.next = mapped; }
                    tail = mapped;
                }
                targets[index] = mapped.target;
            }
        }
        var current = first;
        var valid = true;
        while (current != null && valid) {
            let base = current.source.summary_base;
            if (base != null) {
                if (base.graph != current.source.graph) { valid = false; }
                else {
                    var mapped = ProvenanceCopyFind(first, base);
                    if (mapped == null) {
                        mapped = ProvenanceCopyNew(graph, base);
                        tail.next = mapped; tail = mapped;
                    }
                    current.target.summary_base = mapped.target;
                }
            }
            var edge = current.source.edges;
            while (edge != null && valid) {
                var target: *ProvenanceNode = null;
                if (edge.target != null) {
                    var mapped = ProvenanceCopyFind(first, edge.target);
                    if (mapped == null) {
                        mapped = ProvenanceCopyNew(graph, edge.target);
                        tail.next = mapped;
                        tail = mapped;
                    }
                    target = mapped.target;
                }
                valid = ProvenanceEdgeNew(current.target, edge.kind, edge.key, target, edge.exclusive);
                edge = edge.next;
            }
            current = current.next;
        }
        current = first;
        while (current != null) {
            let next = current.next;
            Free(cast[*u8](current));
            current = next;
        }
        if (!valid) {
            var node = graph.nodes;
            graph.nodes = before;
            while (node != before) {
                let next = node.next;
                var edge = node.edges;
                while (edge != null) {
                    let following = edge.next;
                    Free(cast[*u8](edge));
                    edge = following;
                }
                Free(cast[*u8](node));
                node = next;
            }
            for (var index: i64 = 0; index < count; index = index + 1) { targets[index] = null; }
        }
        return valid;
    }
}
fn ProvenanceGraphCopy(graph: *ProvenanceGraph, source: *ProvenanceNode) -> *ProvenanceNode {
    unsafe {
        var input = source;
        var output: *ProvenanceNode = null;
        if (!ProvenanceGraphCopyRoots(graph, &raw input, &raw output, 1)) {
            Error(cast[*u8]("invalid internal provenance graph copy"));
        }
        return output;
    }
}

struct ProvenancePairState{left:*ProvenanceNode;right:*ProvenanceNode;next:*ProvenancePairState;}
fn ProvenancePairAppend(head:*ProvenancePairState,tail:*ProvenancePairState,left:*ProvenanceNode,right:*ProvenanceNode)->*ProvenancePairState{unsafe{
 if(left==null || right==null){return tail;}var state=head;
 while(state!=null){if(state.left==left && state.right==right){return tail;}state=state.next;}
 let fresh=cast[*ProvenancePairState](CAlloc(i64(sizeof(ProvenancePairState))));fresh.left=left;fresh.right=right;tail.next=fresh;return fresh;
}}
fn ProvenanceAddressRootPossible(node:*ProvenanceNode,root:*Local)->bool{unsafe{
 if(node==null){return false;}
 let first=cast[*ProvenanceQueryState](CAlloc(i64(sizeof(ProvenanceQueryState))));first.node=node;
 var current=first;var tail=first;var found=false;
 while(current!=null && !found){if(current.node.opaque!=0 || current.node.root==root){found=true;}else{var edge=current.node.edges;while(edge!=null){tail=ProvenanceQueryAppend(first,tail,edge.target,null,0);edge=edge.next;}}current=current.next;}
 current=first;while(current!=null){let next=current.next;Free(cast[*u8](current));current=next;}return found;
}}
fn ProvenanceAddressOverlap(left:*ProvenanceNode,right:*ProvenanceNode,root:*Local)->bool{unsafe{
 if(left==null || right==null){return true;}
 let first=cast[*ProvenancePairState](CAlloc(i64(sizeof(ProvenancePairState))));first.left=left;first.right=right;
 var current=first;var tail=first;var found=false;
 while(current!=null && !found){let a=current.left;let b=current.right;
  if(a.opaque!=0 || b.opaque!=0 || a.type!=b.type){found=true;}
  else if(a.root==root){found=ProvenanceAddressRootPossible(b,root);}
  else if(b.root==root){found=ProvenanceAddressRootPossible(a,root);}
  else{var x=a.edges;while(x!=null){var y=b.edges;while(y!=null){if(x.kind==y.kind && (x.kind!=1 || x.key==y.key || AggregateKind(a.type)==4)){tail=ProvenancePairAppend(first,tail,x.target,y.target);}y=y.next;}x=x.next;}}
  current=current.next;
 }
 current=first;while(current!=null){let next=current.next;Free(cast[*u8](current));current=next;}return found;
}}

// Caller proves an owner descriptor endpoint; query excludes only its payload.
fn ProvenanceOwnerSlotOverlap(source:*ProvenanceNode,path:*ProvenanceCursor,type:i64)->bool{unsafe{
 if(source==null){return true;}
 let first=cast[*ProvenanceQueryState](CAlloc(i64(sizeof(ProvenanceQueryState))));first.node=source;first.cursor=path;
 var current=first;var tail=first;var found=false;
 while(current!=null && !found){
  let node=current.node;let step=current.cursor;
  if(node.opaque!=0 || node.root!=null){found=true;}
  else if(step==null){
   if(node.type!=type){found=true;}
   else{var edge=node.edges;while(edge!=null){if(edge.kind!=4){found=true;}edge=edge.next;}}
  }else if(node.type!=step.type){found=true;}
  else{var edge=node.edges;while(edge!=null){if(edge.kind==step.kind && (step.kind!=1 || edge.key==step.key || AggregateKind(node.type)==4)){tail=ProvenanceQueryAppend(first,tail,edge.target,step.next,0);}edge=edge.next;}}
  current=current.next;
 }
 current=first;while(current!=null){let next=current.next;Free(cast[*u8](current));current=next;}
 return found;
}}
