// Called only after all user frames have returned or been unwound. Retained
// callers dispatch by function ID; they do not own the callee's compilation.
fn FreeFunctionChanges(discard: *Function, retain: *Function) {
    unsafe {
        if (discard.machine != retain.machine) {
            NativeJitFree(discard.machine, discard.machine_size);
            discard.machine = null;
            discard.machine_size = 0;
        }
        if (discard.bytecode != retain.bytecode || discard.byte_allocations != retain.byte_allocations) { FreeBytecode(discard); }
        if (discard.allocated_locals != retain.allocated_locals) {
            var local = discard.allocated_locals;
            while (local != null) {
                let next = local.repl_next;
                var edge = cast[*BorrowSource](local.sources);
                while (edge != null) {
                    let following = edge.next;
                    Free(cast[*u8](edge));
                    edge = following;
                }
                // Function names/parameters refer to retained declaration tokens.
                Free(cast[*u8](local));
                local = next;
            }
            discard.allocated_locals = null;
            discard.all_locals = null;
        }
        if (discard.nodes != retain.nodes) {
            var node = discard.nodes;
            while (node != null) {
                let next = node.next;
                Free(cast[*u8](node));
                node = next;
            }
            discard.nodes = null;
            discard.body = null;
        }
        if (discard.drops != retain.drops) {
            var drop = discard.drops;
            while (drop != null) {
                let next = drop.next;
                Free(cast[*u8](drop));
                drop = next;
            }
            discard.drops = null;
        }
    }
}
fn ReplRollbackFunctions() {
    unsafe {
        let ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        Free(cast[*u8](ctx.v_jit_offsets));
        Free(cast[*u8](ctx.v_jit_patches));
        ctx.v_jit_offsets = null;
        ctx.v_jit_patches = null;
        if (ctx.v_machine != null) {
            Free(ctx.v_machine.data);
            Free(cast[*u8](ctx.v_machine));
            ctx.v_machine = null;
        }
        var empty = Function{};
        for (var i: i64 = 1; i < ctx.v_nfun; i = i + 1) {
            var retained = &raw empty;
            if (i < ctx.v_repl_saved_nfun) { retained = &raw ctx.v_repl_snapshot[i]; }
            FreeFunctionChanges(&raw ctx.v_functions[i], retained);
        }
    }
}
fn ReplCommitFunctions() {
    unsafe {
        let ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        for (var i: i64 = 1; i < ctx.v_repl_saved_nfun; i = i + 1) {
            FreeFunctionChanges(&raw ctx.v_repl_snapshot[i], &raw ctx.v_functions[i]);
        }
    }
}

// Existing values retain their actual historical origins. Future calls through
// retained bodies must remain valid under the newly installed projections.
fn ReplRevalidateBorrowProjections(){unsafe{
    let ctx=cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
    if(ctx.v_allow_redefinition==i8(0) || ctx.v_repl_snapshot==null){return;}
    var changed=false;
    for(var i:i64=1;i<ctx.v_repl_saved_nfun;i=i+1){
        let old=&raw ctx.v_repl_snapshot[i];let current=&raw ctx.v_functions[i];
        if(old.body!=current.body && ReferenceSliceProjection(old)>=0 && ReferenceSliceProjection(old)!=ReferenceSliceProjection(current)){changed=true;}
    }
    if(!changed){return;}
    let count=ctx.v_repl_saved_nfun;
    let affected=cast[*i64](ScratchAllocate(count*8));
    let queue=cast[*i64](ScratchAllocate(count*8));
    let heads=cast[*i64](ScratchAllocate(count*8));
    var tail:i64=0;var edge_count:i64=0;var fallback=false;
    for(var i:i64=1;i<count;i=i+1){
        heads[i]=-1;
        let old=&raw ctx.v_repl_snapshot[i];let current=&raw ctx.v_functions[i];
        if(old.body!=current.body && ReferenceSliceProjection(old)>=0 && ReferenceSliceProjection(old)!=ReferenceSliceProjection(current)){
            affected[i]=1;queue[tail]=i;tail=tail+1;
        }
        if(current.body!=null && current.body==old.body && current.generic_count==0){
            if(current.nodes==null){fallback=true;}
            var allocation=current.nodes;
            while(allocation!=null){
                let node=&raw allocation.value;
                if(node.kind==4){
                    if(node.slot>=count){fallback=true;}
                    if(node.slot>0 && node.slot<count){edge_count=edge_count+1;}
                }
                allocation=allocation.next;
            }
        }
    }
    // Scratch ownership survives nonlocal errors and is reclaimed at the end
    // of the submission. Allocation wrappers include every cloned CALL node.
    let callers=cast[*i64](ScratchAllocate(edge_count*8));
    let links=cast[*i64](ScratchAllocate(edge_count*8));
    var edge:i64=0;
    for(var i:i64=1;i<count;i=i+1){
        let current=&raw ctx.v_functions[i];
        if(current.body!=null && current.body==ctx.v_repl_snapshot[i].body && current.generic_count==0){
            var allocation=current.nodes;
            while(allocation!=null){
                let node=&raw allocation.value;
                if(node.kind==4 && node.slot>0 && node.slot<count){
                    callers[edge]=i;links[edge]=heads[node.slot];heads[node.slot]=edge;edge=edge+1;
                }
                allocation=allocation.next;
            }
        }
    }
    var front:i64=0;
    while(front<tail){
        var link=heads[queue[front]];front=front+1;
        while(link>=0){
            let caller=callers[link];
            if(affected[caller]==0){affected[caller]=1;queue[tail]=caller;tail=tail+1;}
            link=links[link];
        }
    }
    for(var i:i64=1;i<count;i=i+1){
        let current=&raw ctx.v_functions[i];
        if((fallback || affected[i]!=0) && current.body!=null && current.body==ctx.v_repl_snapshot[i].body && current.generic_count==0){AnalyzeReferences(current);}
    }
}}
