fn EmitDrop(arg_v_address8: i64, arg_v_type39: i64) {
unsafe {
var ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
var v_address8: i64 = arg_v_address8;
var v_type39: i64 = arg_v_type39;
var t0: i64 = i64(0);
var t1: i8 = i8(0);
var t2: *u8 = null;
var t3: i64 = i64(0);
var t4: *u8 = null;
var t5: i64 = i64(0);
var t6: *u8 = null;
t0 = v_type39;
t1 = Owned(t0);
if (!((t1 != i8(0)))) {
return;
}
t2 = cast[*u8]("  call void @__cool_drop");
IR(t2);
t3 = v_type39;
RI(t3);
t4 = cast[*u8]("(i64 ");
IR(t4);
t5 = v_address8;
Reg(t5);
t6 = cast[*u8](")\n");
IR(t6);
}
return;
}


fn DropFieldIR(arg_v_field4: *Field) {
unsafe {
var ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
var v_field4: *Field = arg_v_field4;
var t0: *u8 = null;
var t1: i64 = i64(0);
var t2: *u8 = null;
var t3: i64 = i64(0);
var t4: *u8 = null;
var t5: i64 = i64(0);
var t6: *u8 = null;
var t7: i64 = i64(0);
var t8: *u8 = null;
t0 = cast[*u8]("  %field");
IR(t0);
t1 = (v_field4).tag;
RI(t1);
t2 = cast[*u8](" = add i64 %address, ");
IR(t2);
t3 = (v_field4).offset;
RI(t3);
t4 = cast[*u8]("\n  call void @__cool_drop");
IR(t4);
t5 = (v_field4).type;
RI(t5);
t6 = cast[*u8]("(i64 %field");
IR(t6);
t7 = (v_field4).tag;
RI(t7);
t8 = cast[*u8](")\n");
IR(t8);
}
return;
}


// Enqueue children in reverse order so the runtime LIFO dispatcher preserves
// forward field/element destruction and child-before-owner release.
fn DropFieldsReverseIR(field:*Field){unsafe{
 var count:i64=0;var index:i64=0;var item=field;
 while(item!=null){if(Owned(item.type)!=i8(0)){count=count+1;}item=item.next;}
 if(count==0){return;}
 let fields=cast[**Field](CAlloc(count*8));item=field;
 while(item!=null){if(Owned(item.type)!=i8(0)){fields[index]=item;index=index+1;}item=item.next;}
 while(index>0){index=index-1;DropFieldIR(fields[index]);}
 Free(cast[*u8](fields));
}}
// Bounded structural drop depth. Recursive types exhaust the budget and stay
// on the runtime worklist; shallow types are emitted as direct recursive drops
// so ordinary destruction pays no dispatch cost.
fn DropInlineDepth(type:i64,budget:i64)->i64{unsafe{
 if(budget<=0){return 1000000;}
 if(Owned(type)==i8(0)){return 0;}
 let shape=Shape(type);
 if(shape.kind==5||shape.kind==2){
  let child=DropInlineDepth(shape.element,budget-1);
  if(child>=1000000){return 1000000;}
  return child+1;
 }
 var best:i64=0;var field=shape.fields;
 while(field!=null){if(Owned(field.type)!=i8(0)){let child=DropInlineDepth(field.type,budget-1);if(child>=1000000){return 1000000;}if(child>best){best=child;}}field=field.next;}
 return best+1;
}}
fn EmitDropFunctions(){unsafe{
 EmitClearFunctions();
 let ctx=cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
 for(var i:i64=0;i<ctx.v_naggregates;i=i+1){
  let type=1000+i;let a=Shape(type);
  if(a.generic_count==0 && Owned(type)!=i8(0)){
   let inlined=DropInlineDepth(type,8)<1000000;
   if(inlined){IR(cast[*u8]("define void @__cool_drop"));RI(type);IR(cast[*u8]("(i64 %address) {\nentry:\n  %cell = inttoptr i64 %address to ptr\n"));}
   else if(a.kind==5){IR(cast[*u8]("define void @__cool_drop"));RI(type);IR(cast[*u8]("(i64 %address) {\nentry:\n  %cell = inttoptr i64 %address to ptr\n  %live = load i64, ptr %cell\n  %alive = icmp ne i64 %live, 0\n  br i1 %alive, label %drop, label %done\ndrop:\n  call void @cool_drop_enqueue(i64 %address, ptr @__cool_drop_body"));RI(type);IR(cast[*u8](")\n  br label %done\ndone:\n  ret void\n}\n"));IR(cast[*u8]("define void @__cool_drop_body"));RI(type);IR(cast[*u8]("(i64 %address) {\nentry:\n  %cell = inttoptr i64 %address to ptr\n"));}
   else{IR(cast[*u8]("define void @__cool_drop"));RI(type);IR(cast[*u8]("(i64 %address) {\nentry:\n  call void @cool_drop_enqueue(i64 %address, ptr @__cool_drop_body"));RI(type);IR(cast[*u8](")\n  ret void\n}\n"));IR(cast[*u8]("define void @__cool_drop_body"));RI(type);IR(cast[*u8]("(i64 %address) {\nentry:\n  %cell = inttoptr i64 %address to ptr\n"));}
   if(a.kind==5){
    IR(cast[*u8]("  %owned = load i64, ptr %cell\n  %alive = icmp ne i64 %owned, 0\n  br i1 %alive, label %drop, label %done\ndrop:\n  store i64 0, ptr %cell\n"));
    if(Owned(a.element)!=i8(0)){
     if(inlined){IR(cast[*u8]("  call void @__cool_drop"));RI(a.element);IR(cast[*u8]("(i64 %owned)\n  call void @cool_owner_free(i64 %owned)\n"));}
     else{IR(cast[*u8]("  call void @cool_drop_defer_free(i64 %owned)\n  call void @__cool_drop"));RI(a.element);IR(cast[*u8]("(i64 %owned)\n"));}
    }else{IR(cast[*u8]("  call void @cool_owner_free(i64 %owned)\n"));}
    IR(cast[*u8]("  br label %done\ndone:\n  ret void\n"));
   }else if(a.kind==2){
    if(inlined){
     IR(cast[*u8]("  br label %loop\nloop:\n  %index = phi i64 [0, %entry], [%next, %body]\n  %more = icmp ult i64 %index, "));RI(a.count);IR(cast[*u8]("\n  br i1 %more, label %body, label %done\nbody:\n  %offset = mul i64 %index, "));RI(ByteSize(a.element));
     IR(cast[*u8]("\n  %element = add i64 %address, %offset\n  call void @__cool_drop"));RI(a.element);IR(cast[*u8]("(i64 %element)\n  %next = add i64 %index, 1\n  br label %loop\ndone:\n  ret void\n"));
    }else{
     IR(cast[*u8]("  br label %loop\nloop:\n  %index = phi i64 ["));RI(a.count);IR(cast[*u8](", %entry], [%item, %body]\n  %more = icmp ne i64 %index, 0\n  br i1 %more, label %body, label %done\nbody:\n  %item = sub i64 %index, 1\n  %offset = mul i64 %item, "));RI(ByteSize(a.element));
     IR(cast[*u8]("\n  %element = add i64 %address, %offset\n  call void @__cool_drop"));RI(a.element);IR(cast[*u8]("(i64 %element)\n  br label %loop\ndone:\n  ret void\n"));
    }
   }else if(a.kind==4){
    IR(cast[*u8]("  %tag = load i64, ptr %cell\n  switch i64 %tag, label %done [\n"));
    var field=a.fields;while(field!=null){if(Owned(field.type)!=i8(0)){IR(cast[*u8]("    i64 "));RI(field.tag);IR(cast[*u8](", label %variant"));RI(field.tag);IR(cast[*u8]("\n"));}field=field.next;}
    IR(cast[*u8]("  ]\n"));field=a.fields;
    while(field!=null){if(Owned(field.type)!=i8(0)){IR(cast[*u8]("variant"));RI(field.tag);IR(cast[*u8](":\n"));DropFieldIR(field);IR(cast[*u8]("  br label %done\n"));}field=field.next;}
    IR(cast[*u8]("done:\n  ret void\n"));
   }else{
    if(inlined){var field=a.fields;while(field!=null){if(Owned(field.type)!=i8(0)){DropFieldIR(field);}field=field.next;}}
    else{DropFieldsReverseIR(a.fields);}
    IR(cast[*u8]("  ret void\n"));
   }
   IR(cast[*u8]("}\n"));
  }
 }
}}

fn ClearFieldIR(field:*Field){unsafe{
 IR(cast[*u8]("  %field"));RI(field.tag);IR(cast[*u8](" = add i64 %address, "));RI(field.offset);
 IR(cast[*u8]("\n  call void @__cool_clear"));RI(field.type);IR(cast[*u8]("(i64 %field"));RI(field.tag);IR(cast[*u8](")\n"));
}}
fn EmitClearFunctions(){unsafe{
 let ctx=cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
 var i:i64=0;
 while(i<ctx.v_naggregates){
  let type=1000+i;let shape=Shape(type);i=i+1;
  if(shape.generic_count==0 && Owned(type)!=i8(0)){
   IR(cast[*u8]("define void @__cool_clear"));RI(type);IR(cast[*u8]("(i64 %address) {\nentry:\n  %cell = inttoptr i64 %address to ptr\n"));
   if(shape.kind==5 || Borrowed(type)==i8(0)){
    IR(cast[*u8]("  call void @cool_zero(i64 %address, i64 "));RI(ByteSize(type));IR(cast[*u8](")\n  ret void\n"));
   }else if(shape.kind==2){
    IR(cast[*u8]("  br label %loop\nloop:\n  %index = phi i64 [0, %entry], [%next, %body]\n  %more = icmp ult i64 %index, "));RI(shape.count);
    IR(cast[*u8]("\n  br i1 %more, label %body, label %done\nbody:\n  %offset = mul i64 %index, "));RI(ByteSize(shape.element));
    IR(cast[*u8]("\n  %element = add i64 %address, %offset\n  call void @__cool_clear"));RI(shape.element);
    IR(cast[*u8]("(i64 %element)\n  %next = add i64 %index, 1\n  br label %loop\ndone:\n  ret void\n"));
   }else if(shape.kind==4){
    IR(cast[*u8]("  %tag = load i64, ptr %cell\n  switch i64 %tag, label %done [\n"));
    var field=shape.fields;while(field!=null){if(Owned(field.type)!=i8(0)){IR(cast[*u8]("    i64 "));RI(field.tag);IR(cast[*u8](", label %variant"));RI(field.tag);IR(cast[*u8]("\n"));}field=field.next;}
    IR(cast[*u8]("  ]\n"));field=shape.fields;
    while(field!=null){if(Owned(field.type)!=i8(0)){IR(cast[*u8]("variant"));RI(field.tag);IR(cast[*u8](":\n"));ClearFieldIR(field);IR(cast[*u8]("  br label %done\n"));}field=field.next;}
    IR(cast[*u8]("done:\n  ret void\n"));
   }else{
    var field=shape.fields;while(field!=null){if(Owned(field.type)!=i8(0)){ClearFieldIR(field);}field=field.next;}
    IR(cast[*u8]("  ret void\n"));
   }
   IR(cast[*u8]("}\n"));
  }
 }
}}
