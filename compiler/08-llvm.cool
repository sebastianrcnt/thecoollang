// Emit the whole module: runtime declarations, foreign declarations, drop
// functions, one body per non-generic function and the C main wrapper. Globals
// and function IR are buffered separately and concatenated for the write.
fn EmitLLVM(output: *u8) {
    unsafe {
        let ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        let main_id = FindFun(cast[*u8]("main"));
        if (main_id < 0) {
            Error(cast[*u8]("no main function"));
        }
        let main_fn = & raw(ctx.v_functions)[main_id];
        if (main_fn.generic_count != 0 || main_fn.argc != 0 || (main_fn.result != 0 && main_fn.result != 4 && main_fn.result != 1)) {
            ErrorAt(main_fn.token, cast[*u8]("invalid main signature"));
        }
        ctx.v_ir = TextNew();
        ctx.v_globals = TextNew();
        IR(cast[*u8]("; Generated by the Cool-written frontend. No C transpilation.\n"));
        IR(cast[*u8]("declare i64 @cool_owner_alloc(i64)\ndeclare void @cool_owner_free(i64)\ndeclare void @cool_drop_enqueue(i64, ptr)\ndeclare void @cool_drop_defer_free(i64)\ndeclare i64 @cool_owner_count()\ndeclare i64 @cool_owner_address(i64)\n"));
        IR(cast[*u8]("declare void @cool_zero(i64, i64)\ndeclare i64 @cool_length(i64, i64, i64)\ndeclare i64 @cool_index(i64, i64, i64, i64, i64)\ndeclare void @cool_slice(i64, i64, i64, i64, i64, i64, i64)\n"));
        IR(cast[*u8]("declare i64 @cool_alloc(i64)\ndeclare void @cool_free(i64)\ndeclare void @cool_copy(i64, i64, i64)\ndeclare i64 @cool_load(i64, i64)\ndeclare void @cool_store(i64, i64, i64)\n"));
        IR(cast[*u8]("declare void @cool_args_init(i32, ptr)\n"));
        IR(cast[*u8]("declare i64 @cool_cast(i64, i64, i64)\n"));
        IR(cast[*u8]("declare void @cool_print(i64, i64, i64)\ndeclare void @cool_assert(i64)\ndeclare i64 @cool_div(i64, i64, i64, i64, i64)\ndeclare i64 @cool_shift(i64, i64, i64, i64, i64)\n"));
        var i: i64 = 0;
        while (i < ctx.v_nfun) {
            let f = & raw(ctx.v_functions)[i];
            if (f.foreign != 0) {
                var k: i64 = 0;
                while (k < i && !(ctx.v_functions[k].foreign != 0 && Eq(ctx.v_functions[k].name, f.name) != i8(0))) {
                    k = k + 1;
                }
                if (k == i) {
                    ForeignDeclaration(f);
                }
            }
            i = i + 1;
        }
        EmitDropFunctions();
        i = 0;
        while (i < ctx.v_nfun) {
            let f = & raw(ctx.v_functions)[i];
            if (f.generic_count == 0) {
                ctx.v_reg_id = 0;
                ctx.v_terminated = i8(0);
                ctx.v_scope = null;
                IR(cast[*u8]("define i64 @__cool_fn"));
                RI(i);
                IR(cast[*u8]("("));
                if (Aggregate(f.result) != i8(0)) {
                    IR(cast[*u8]("i64 %result"));
                }
                var j: i64 = 0;
                while (j < f.argc) {
                    if (j != 0 || Aggregate(f.result) != i8(0)) {
                        IR(cast[*u8](", "));
                    }
                    IR(cast[*u8]("i64 %a"));
                    RI(j);
                    j = j + 1;
                }
                IR(cast[*u8](") {\nentry:\n"));
                IR(cast[*u8]("  %frame = alloca ["));
                RI(f.slots + 1);
                IR(cast[*u8](" x i64], align 8\n"));
                j = 0;
                while (j < f.slots) {
                    IR(cast[*u8]("  %v"));
                    RI(j);
                    IR(cast[*u8](" = getelementptr i64, ptr %frame, i64 "));
                    RI(j);
                    IR(cast[*u8]("\n"));
                    j = j + 1;
                }
                if (f.drops != null) {
                    IR(cast[*u8]("  %frame_address = ptrtoint ptr %frame to i64\n  call void @cool_zero(i64 %frame_address, i64 "));
                    RI((f.slots + 1) * 8);
                    IR(cast[*u8](")\n"));
                }
                var offset: i64 = 0;
                j = 0;
                while (f.foreign == 0 && j < f.argc) {
                    var parameter = Fresh();
                    IR(cast[*u8]("  "));
                    Reg(parameter);
                    IR(cast[*u8](" = add i64 0, %a"));
                    RI(j);
                    IR(cast[*u8]("\n"));
                    if (Aggregate(f.arg_types[j]) != i8(0)) {
                        EmitCopy(SlotAddress(offset), parameter, f.arg_types[j]);
                    } else {
                        parameter = LocalWrite(parameter, f.arg_types[j]);
                        IR(cast[*u8]("  store i64 "));
                        Reg(parameter);
                        IR(cast[*u8](", ptr %v"));
                        RI(offset);
                        IR(cast[*u8]("\n"));
                    }
                    offset = offset + TypeSlots(f.arg_types[j]);
                    j = j + 1;
                }
                if (f.foreign != 0) {
                    ForeignWrapper(f);
                    ctx.v_terminated = i8(1);
                } else {
                    EmitStmt(f.body);
                }
                if (ctx.v_terminated == i8(0)) {
                    IR(cast[*u8]("  ret i64 0\n"));
                }
                IR(cast[*u8]("}\n"));
                if (f.exported != 0) {
                    ExportWrapper(f, i);
                }
            }
            i = i + 1;
        }
        IR(cast[*u8]("define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  call void @cool_args_init(i32 %argc, ptr %argv)\n  %exit = call i64 @__cool_fn"));
        RI(main_id);
        IR(cast[*u8]("()\n  %status = trunc i64 %exit to i32\n  ret i32 %status\n}\n"));
        let all = TextNew();
        if (ctx.v_globals.len != 0) {
            Append(all, ctx.v_globals.data);
        }
        Append(all, ctx.v_ir.data);
        if (FileWrite(output, all.data, all.len) == 0) {
            Error(cast[*u8]("failed to write LLVM IR"));
        }
    }
}

