// Nonzero argument-origin masks for pure slice aliases and boolean branches.
// Bounds never identify individual elements; -1 denotes an opaque body.
struct SliceProjectionScan {
    function:*Function;tokens:*Token;position:i64;end:i64;
    names:**u8;origins:*i64;count:i64;depth:i64;mask:i64;
}
fn SliceProjectionValue(scan:*SliceProjectionScan)->i64 {unsafe{
    if(scan.position>=scan.end || scan.tokens[scan.position].kind!=256){return -1;}
    var selected:i64=0;
    while(selected<scan.count && Eq(scan.names[selected],scan.tokens[scan.position].text)==i8(0)){selected=selected+1;}
    if(selected==scan.count || scan.origins[selected]<=0){return -1;}
    let origin=scan.origins[selected];scan.position=scan.position+1;
    if(scan.position<scan.end && scan.tokens[scan.position].kind==91){
        scan.position=scan.position+1;
        if(scan.position<scan.end && scan.tokens[scan.position].kind==257){scan.position=scan.position+1;}
        if(scan.position>=scan.end || scan.tokens[scan.position].kind!=58){return -1;}
        scan.position=scan.position+1;
        if(scan.position<scan.end && scan.tokens[scan.position].kind==257){scan.position=scan.position+1;}
        if(scan.position>=scan.end || scan.tokens[scan.position].kind!=93){return -1;}
        scan.position=scan.position+1;
    }
    return origin;
}}
// -1 unsupported, 0 fallthrough, 1 all paths return. Scope restoration is
// independent of the union of returned origins accumulated across branches.
fn SliceProjectionBlock(scan:*SliceProjectionScan)->i64 {unsafe{
    if(scan.depth>=16 || scan.position>=scan.end || scan.tokens[scan.position].kind!=123){return -1;}
    scan.depth=scan.depth+1;let base=scan.count;scan.position=scan.position+1;
    var outcome:i64=0;
    while(scan.position<scan.end && scan.tokens[scan.position].kind!=125){
        if(outcome==1){return -1;}
        let token=&raw scan.tokens[scan.position];
        if(token.kind==123){outcome=SliceProjectionBlock(scan);if(outcome<0){return -1;}}
        else{
            if(token.kind!=256){return -1;}
            if(Eq(token.text,cast[*u8]("return"))!=i8(0)){
                scan.position=scan.position+1;let origin=SliceProjectionValue(scan);
                if(origin<=0 || scan.position>=scan.end || scan.tokens[scan.position].kind!=59){return -1;}
                scan.mask=scan.mask|origin;scan.position=scan.position+1;outcome=1;
            }else if(Eq(token.text,cast[*u8]("if"))!=i8(0)){
                scan.position=scan.position+1;
                if(scan.position>=scan.end || scan.tokens[scan.position].kind!=40){return -1;}
                scan.position=scan.position+1;
                if(scan.position<scan.end && scan.tokens[scan.position].kind==33){scan.position=scan.position+1;}
                if(scan.position>=scan.end || scan.tokens[scan.position].kind!=256){return -1;}
                let condition=scan.tokens[scan.position].text;
                var valid=Eq(condition,cast[*u8]("true"))!=i8(0) || Eq(condition,cast[*u8]("false"))!=i8(0);
                for(var i:i64=0;i<scan.function.argc;i=i+1){if(scan.function.arg_types[i]==2 && Eq(scan.function.arg_names[i],condition)!=i8(0)){valid=true;}}
                if(!valid){return -1;}
                scan.position=scan.position+1;
                if(scan.position>=scan.end || scan.tokens[scan.position].kind!=41){return -1;}
                scan.position=scan.position+1;let left=SliceProjectionBlock(scan);if(left<0){return -1;}
                var right:i64=0;
                if(scan.position<scan.end && scan.tokens[scan.position].kind==256 && Eq(scan.tokens[scan.position].text,cast[*u8]("else"))!=i8(0)){
                    scan.position=scan.position+1;right=SliceProjectionBlock(scan);if(right<0){return -1;}
                }
                if(left==1 && right==1){outcome=1;}
            }else{
                if(Eq(token.text,cast[*u8]("let"))==i8(0) && Eq(token.text,cast[*u8]("var"))==i8(0)){return -1;}
                if(scan.position+3>=scan.end || scan.tokens[scan.position+1].kind!=256 || scan.tokens[scan.position+2].kind!=61 || scan.count==32){return -1;}
                let name=scan.tokens[scan.position+1].text;
                for(var i:i64=0;i<scan.count;i=i+1){if(Eq(scan.names[i],name)!=i8(0)){return -1;}}
                scan.position=scan.position+3;let origin=SliceProjectionValue(scan);
                if(origin<=0 || scan.position>=scan.end || scan.tokens[scan.position].kind!=59){return -1;}
                scan.position=scan.position+1;scan.names[scan.count]=name;scan.origins[scan.count]=origin;scan.count=scan.count+1;
            }
        }
    }
    if(scan.position>=scan.end){return -1;}
    scan.position=scan.position+1;scan.count=base;scan.depth=scan.depth-1;return outcome;
}}
fn ReferenceSliceProjection(function:*Function)->i64 {unsafe{
    let ctx=cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
    if(function.foreign!=0 || function.generic_count!=0 || function.store_destinations!=0 || AggregateKind(function.result)!=3 || function.argc>32){return -1;}
    if(function.begin<0 || function.end>ctx.v_ntok || function.end-function.begin<5 || function.end-function.begin>512){return -1;}
    var names=[32]*u8{};var origins=[32]i64{};
    for(var i:i64=0;i<function.argc;i=i+1){names[i]=function.arg_names[i];origins[i]=-1;if(function.arg_types[i]==function.result && (function.borrow_contract&(1<<i))!=0){origins[i]=1<<i;}}
    var scan=SliceProjectionScan{function:function,tokens:ctx.v_tokens,position:function.begin,end:function.end,names:&raw names[0],origins:&raw origins[0],count:function.argc,depth:0,mask:0};
    if(SliceProjectionBlock(&raw scan)!=1 || scan.position!=scan.end || scan.mask<=0){return -1;}
    return scan.mask;
}}
// Opaque contracts specify possible origins, not field correspondences. Each
// source root may occur in every borrowed output slot permitted by its type.
// Root/capability keys live on graph nodes so clone/compaction preserves reuse
// without retaining caches whose values are no longer reachable from loans.
fn ReferenceBoundedSummary(check: *ReferenceCheck, type: i64, root: *Local, mode: i64, payload: bool) -> *ProvenanceNode {
    unsafe {
        var kind: i64 = 2;
        if (payload) { kind = 3; if (ReferenceBorrowedSlice(type)) { kind = 5; } }
        var old = check.graph.nodes;
        while (old != null) {
            if (old.summary_kind == kind && old.summary_root == root && old.type == type && old.summary_mode == mode) { return old; }
            old = old.next;
        }
        var value_type = type;
        if (payload) { value_type = Shape(type).element; }
        var base: *ProvenanceNode = null;
        if (mode == 0) { base = ReferenceSharedOriginSummary(check, value_type, root); }
        else { base = ReferenceTypeSummary(check, value_type, root); }
        if (base == null) { return null; }
        var result: *ProvenanceNode = null;
        if (payload) {
            result = ProvenanceNodeNew(check.graph, type, null, 1);
            var edge_kind:i64 = 3;
            if (ReferenceBorrowedSlice(type)) { edge_kind = 2; }
            if (!ProvenanceEdgeNew(result, edge_kind, 0, base, mode)) { Error(cast[*u8]("invalid internal call payload summary")); }
        } else {
            result = ProvenanceNodeNew(check.graph, type, base.root, base.exclusive & mode);
            result.opaque = base.opaque;
            var edge = base.edges;
            while (edge != null) {
                if (!ProvenanceEdgeNew(result, edge.kind, edge.key, edge.target, edge.exclusive & mode)) { Error(cast[*u8]("invalid internal call value summary")); }
                edge = edge.next;
            }
        }
        result.summary_base = base;
        result.summary_root = root; result.summary_kind = kind; result.summary_mode = mode;
        return result;
    }
}
fn ReferenceCallGraph(check: *ReferenceCheck, source: *ReferenceLoan, type: i64, indirect: i64) -> ReferenceLoan {
    unsafe {
        var result = *source;
        result.physical_provenance = null;
        result.provenance_type = type;
        if (source.provenance == null && source.provenance_known != 0) { return result; }
        let bound = source.exclusive & ReferenceRootMode(source);
        if (ReferenceLayered(type) && indirect == 0) {
            // A result's physical address may be any contracted source anchor.
            result.provenance = ReferenceGraphLeaf(check.graph, type, source.root, bound);
        } else {
            result.provenance = ReferenceBoundedSummary(check, type, source.root, bound, ReferenceLayered(type) && indirect != 0);
        }
        result.provenance_known = 1;
        if (result.provenance != null) { result.provenance_known = BoolInt(result.provenance.opaque == 0); }
        return result;
    }
}
fn ReferenceNewCall(check: *ReferenceCheck, source: *ReferenceLoan, parent: *Local, exclusive: i64, indirect: i64, expression: *Node, next: *ReferenceLoan) -> *ReferenceLoan {
    unsafe {
        var scoped = *source;
        scoped.exclusive = scoped.exclusive & exclusive;
        var value = scoped;
        let ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        if (expression.kind == 4 && expression.slot >= 0 && expression.slot < ctx.v_nfun && ReferenceSliceProjection(&raw ctx.v_functions[expression.slot]) >= 0 && scoped.provenance_type == expression.type) {
            value.physical_provenance = null;
        } else { value = ReferenceCallGraph(check, &raw scoped, expression.type, indirect); }
        var old = next;
        while (old != null && old.expression == expression && old.holder == null && old.owner_pin == check.pending_owner) {
            if (old.root == source.root && old.parent == parent && old.exclusive == exclusive && old.indirect == indirect) {
                ReferenceProvenanceJoin(check, old, &raw value);
                return next;
            }
            old = old.next;
        }
        let loan = ReferenceNew(check, source.root, parent, exclusive, indirect, expression, next);
        loan.physical_provenance = value.physical_provenance;
        loan.provenance = value.provenance;
        loan.provenance_type = value.provenance_type;
        loan.provenance_known = value.provenance_known;
        return loan;
    }
}
