// Opaque contracts specify possible origins, not field correspondences. Each
// source root may occur in every borrowed output slot permitted by its type.
// Root/capability keys live on graph nodes so clone/compaction preserves reuse
// without retaining caches whose values are no longer reachable from loans.
fn ReferenceBoundedSummary(check: *ReferenceCheck, type: i64, root: *Local, mode: i64, payload: bool) -> *ProvenanceNode {
    unsafe {
        var kind: i64 = 2;
        if (payload) { kind = 3; if (ReferenceBorrowedSlice(type)) { kind = 5; } }
        var old = check.graph.nodes;
        while (old != null) {
            if (old.summary_kind == kind && old.summary_root == root && old.type == type && old.summary_mode == mode) { return old; }
            old = old.next;
        }
        var value_type = type;
        if (payload) { value_type = Shape(type).element; }
        var base: *ProvenanceNode = null;
        if (mode == 0) { base = ReferenceSharedOriginSummary(check, value_type, root); }
        else { base = ReferenceTypeSummary(check, value_type, root); }
        if (base == null) { return null; }
        var result: *ProvenanceNode = null;
        if (payload) {
            result = ProvenanceNodeNew(check.graph, type, null, 1);
            var edge_kind:i64 = 3;
            if (ReferenceBorrowedSlice(type)) { edge_kind = 2; }
            if (!ProvenanceEdgeNew(result, edge_kind, 0, base, mode)) { Error(cast[*u8]("invalid internal call payload summary")); }
        } else {
            result = ProvenanceNodeNew(check.graph, type, base.root, base.exclusive & mode);
            result.opaque = base.opaque;
            var edge = base.edges;
            while (edge != null) {
                if (!ProvenanceEdgeNew(result, edge.kind, edge.key, edge.target, edge.exclusive & mode)) { Error(cast[*u8]("invalid internal call value summary")); }
                edge = edge.next;
            }
        }
        result.summary_base = base;
        result.summary_root = root; result.summary_kind = kind; result.summary_mode = mode;
        return result;
    }
}
fn ReferenceCallGraph(check: *ReferenceCheck, source: *ReferenceLoan, type: i64, indirect: i64) -> ReferenceLoan {
    unsafe {
        var result = *source;
        result.physical_provenance = null;
        result.provenance_type = type;
        if (source.provenance == null && source.provenance_known != 0) { return result; }
        let bound = source.exclusive & ReferenceRootMode(source);
        if (ReferenceLayered(type) && indirect == 0) {
            // A result's physical address may be any contracted source anchor.
            result.provenance = ReferenceGraphLeaf(check.graph, type, source.root, bound);
        } else {
            result.provenance = ReferenceBoundedSummary(check, type, source.root, bound, ReferenceLayered(type) && indirect != 0);
        }
        result.provenance_known = 1;
        if (result.provenance != null) { result.provenance_known = BoolInt(result.provenance.opaque == 0); }
        return result;
    }
}
fn ReferenceNewCall(check: *ReferenceCheck, source: *ReferenceLoan, parent: *Local, exclusive: i64, indirect: i64, expression: *Node, next: *ReferenceLoan) -> *ReferenceLoan {
    unsafe {
        var scoped = *source;
        scoped.exclusive = scoped.exclusive & exclusive;
        var value = ReferenceCallGraph(check, &raw scoped, expression.type, indirect);
        var old = next;
        while (old != null && old.expression == expression && old.holder == null && old.owner_pin == check.pending_owner) {
            if (old.root == source.root && old.parent == parent && old.exclusive == exclusive && old.indirect == indirect) {
                ReferenceProvenanceJoin(check, old, &raw value);
                return next;
            }
            old = old.next;
        }
        let loan = ReferenceNew(check, source.root, parent, exclusive, indirect, expression, next);
        loan.physical_provenance = value.physical_provenance;
        loan.provenance = value.provenance;
        loan.provenance_type = value.provenance_type;
        loan.provenance_known = value.provenance_known;
        return loan;
    }
}
