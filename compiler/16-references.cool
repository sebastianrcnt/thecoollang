// Scoped references use a pointer-sized aggregate, never an owning allocation.
// Numeric AST tags are shared with the bootstrap frontend's Core.cool.
struct ReferenceLoan {
    root: * Local;
    holder: * Local;
    parent: * Local;
    exclusive: i64;
    indirect: i64;
    expression: * Node;
    next: * ReferenceLoan;
}
struct ReferenceCheck {
    loans: * ReferenceLoan;
    function: * Function;
}
fn IsReference(type: i64) -> bool {
    return AggregateKind(type) == 6;
}
fn ReferenceType(token: * Token) -> i64 {
    unsafe {
        let ctx = cast[ * CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        var exclusive: i64 = 0;
        if (Is(cast[ * u8]("mut")) != i8(0)) {
            ctx.v_pos = ctx.v_pos + 1;
            exclusive = 1;
        }
        return SequenceType(6, ParseType(), exclusive, token);
    }
}
fn ReferenceExpression(token: * Token) -> * Node {
    unsafe {
        let ctx = cast[ * CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        let exclusive = BoolInt(Is(cast[ * u8]("mut")) != i8(0));
        if (exclusive != 0) {
            ctx.v_pos = ctx.v_pos + 1;
        }
        return ReferenceForPlace(Primary(), exclusive, token);
    }
}
fn ReferenceForPlace(place: * Node, exclusive: i64, token: * Token) -> * Node {
    unsafe {
        if (exclusive != 0 && place.mutable == 0) {
            ErrorAt(token, cast[ * u8]("exclusive borrow requires a mutable place"));
        }
        if (Borrowed(place.type) != i8(0) && !ReferenceStorage(place.type)) {
            ErrorAt(token, cast[ * u8]("nested borrowed storage is not yet supported by scoped references"));
        }
        var address: * Node = null;
        if (place.kind == 3) {
            address = NewNode(22, token);
            address.slot = place.slot;
            address.local_ref = place.local_ref;
            address.type = 100000 + place.type;
        } else {
            if (place.kind != 18) {
                ErrorAt(token, cast[ * u8]("reference operand must be a stable place"));
            }
            address = place.a;
        }
        if (BorrowRoot(address) == null && ReferencePlaceSource(address) == null) {
            ErrorAt(token, cast[ * u8]("reference requires a tracked local or parameter root"));
        }
        let result = NewNode(23, token);
        result.type = SequenceType(6, place.type, exclusive, token);
        result.storage = Storage(result.type);
        result.a = address;
        result.origin_source = address;
        return result;
    }
}
fn ReferenceLoad(value: * Node, token: * Token) -> * Node {
    unsafe {
        let address = NewNode(30, token);
        address.a = value;
        address.type = 100000 + Shape(value.type).element;
        let load = NewNode(18, token);
        load.a = address;
        load.origin_source = value;
        load.type = Shape(value.type).element;
        load.mutable = Shape(value.type).count;
        if (Aggregate(load.type) != i8(0)) {
            load.storage = Storage(load.type);
        }
        return load;
    }
}
fn ContainsReference(type: i64) -> bool {
    unsafe {
        if (IsReference(type)) {
            return true;
        }
        if (Aggregate(type) == i8(0)) {
            return false;
        }
        Layout(type);
        let shape = Shape(type);
        if (shape.kind == 2 || shape.kind == 3) {
            return ContainsReference(shape.element);
        }
        if (shape.kind == 5) {
            return false;
        }
        var field = shape.fields;
        while (field != null) {
            if (ContainsReference(field.type)) {
                return true;
            }
            field = field.next;
        }
        return false;
    }
}
// Stored references are copied as reborrows. Owning and slice payloads need
// further lifetime-aware storage tracking before they can participate.
fn TrackedBorrow(type: i64) -> bool { return Borrowed(type) != i8(0); }
fn ReferenceStorage(type: i64) -> bool {
    unsafe {
        if (IsReference(type)) {
            return Borrowed(Shape(type).element) == i8(0);
        }
        if (Aggregate(type) == i8(0)) {
            return true;
        }
        let shape = Shape(type);
        if (shape.kind == 3 || shape.kind == 5) {
            return false;
        }
        if (shape.kind == 2) {
            return ReferenceStorage(shape.element);
        }
        var field = shape.fields;
        while (field != null) {
            if (!ReferenceStorage(field.type)) {
                return false;
            }
            field = field.next;
        }
        return true;
    }
}
// Per-root modes are retained in loans. This maximum is only the permission
// required to copy a typed value; it must never upgrade a shared source root.
fn ReferenceMode(type: i64) -> i64 {
    unsafe {
        if (IsReference(type)) {
            return Shape(type).count;
        }
        if (Aggregate(type) == i8(0)) {
            return 0;
        }
        Layout(type);
        let shape = Shape(type);
        if (shape.kind == 5) {
            return 0;
        }
        if (shape.kind == 3) { return 1; }
        if (shape.kind == 2) {
            return ReferenceMode(shape.element);
        }
        var field = shape.fields;
        while (field != null) {
            if (ReferenceMode(field.type) != 0) {
                return 1;
            }
            field = field.next;
        }
        return 0;
    }
}
fn ValidateReferenceStorage(type: i64, token: * Token) {
    unsafe {
        if (IsReference(type)) {
            if (Borrowed(Shape(type).element) != i8(0) && !ReferenceStorage(Shape(type).element)) {
                ErrorAt(token, cast[ * u8]("nested borrowed storage is not yet supported by scoped references"));
            }
        } else {
            if (ContainsReference(type) && !ReferenceStorage(type)) {
                ErrorAt(token, cast[ * u8]("stored references currently require non-owning, slice-free, single-layer aggregate storage"));
            }
        }
    }
}
// Match evaluates its scrutinee once into anonymous storage. Give borrowed
// payloads a real loan holder, without exposing a name in the lexical scope.
fn ReferenceMatchBinding(binding: * Node) {
    unsafe {
        if (!TrackedBorrow(binding.type)) {
            return;
        }
        let ctx = cast[ * CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        let local = AllocateLocal();
        local.type = binding.type;
        local.slot = binding.slot;
        local.depth = ctx.v_depth;
        local.all_next = ctx.v_functions[ctx.v_current_fun].all_locals;
        ctx.v_functions[ctx.v_current_fun].all_locals = local;
        binding.local_ref = local;
    }
}
// A binding can protect multiple possible roots. Parent ancestry is resolved
// separately for each root; selecting one source must never discard the others.
fn ReferenceHolder(check: * ReferenceCheck, holder: * Local, root: * Local) -> * ReferenceLoan {
    unsafe {
        var loan = check.loans;
        while (loan != null) {
            if (holder != null && loan.holder == holder && loan.root == root) {
                return loan;
            }
            loan = loan.next;
        }
        return null;
    }
}
// Layer zero protects the storage addressed by a reference. Layer one keeps
// the shared referents inside that storage alive; mutating a cursor is not an
// exclusive borrow of the vector stored in its shared source field.
fn NestedReference(type: i64) -> bool {
    unsafe {
        return IsReference(type) && Borrowed(Shape(type).element) != i8(0);
    }
}
fn ReferenceThroughStored(place: * Node) -> bool {
    unsafe {
        if (place == null) {
            return false;
        }
        if (place.kind == 25 && place.op == 3) { return true; }
        if (place.kind == 30) {
            if (IsReference(place.a.type)) {
                return place.a.kind == 18;
            }
            return ReferenceThroughStored(place.a);
        }
        if (place.kind == 18 || place.kind == 24 || place.kind == 25) {
            return ReferenceThroughStored(place.a);
        }
        return false;
    }
}
fn ReferenceMatches(check: * ReferenceCheck, place: * Node, via: * Local, root: * Local, writing: bool) -> bool {
    unsafe {
        if (via == root) {
            return true;
        }
        let through = ReferenceThroughStored(place);
        if (!IsReference(via.type) && AggregateKind(via.type) != 3 && !through) {
            return false;
        }
        if (place.kind == 22 || place.kind == 8) {
            return false;
        }
        var layer: i64 = 0;
        if (NestedReference(via.type) && through) {
            layer = 1;
        }
        var loan = check.loans;
        while (loan != null) {
            if (loan.holder == via && loan.indirect == layer && loan.root == root && (!writing || loan.exclusive != 0)) {
                return true;
            }
            loan = loan.next;
        }
        return false;
    }
}
fn ReferenceAncestor(check: * ReferenceCheck, holder: * Local, via: * Local, root: * Local) -> bool {
    unsafe {
        var current = via;
        while (current != null) {
            if (current == holder) {
                return true;
            }
            let loan = ReferenceHolder(check, current, root);
            if (loan == null) {
                return false;
            }
            current = loan.parent;
        }
        return false;
    }
}
fn ReferenceAccess(check: * ReferenceCheck, place: * Node, writing: bool) {
    unsafe {
        let via = BorrowRoot(place);
        if (via == null) {
            return;
        }
        if (writing && IsReference(via.type) && Shape(via.type).count == 0 && place.kind != 22) {
            ErrorAt(place.token, cast[ * u8]("cannot mutate or move through a shared reference"));
        }
        var loan = check.loans;
        while (loan != null) {
            if ((writing || loan.exclusive != 0) && ReferenceMatches(check, place, via, loan.root, writing) && !ReferenceAncestor(check, loan.holder, via, loan.root) && !(loan.holder == null && loan.expression == ReferencePlaceSource(place))) {
                ErrorAt(place.token, cast[ * u8]("access conflicts with a live scoped reference"));
            }
            loan = loan.next;
        }
    }
}
fn ReferenceNew(root: * Local, parent: * Local, exclusive: i64, indirect: i64, expression: * Node, next: * ReferenceLoan) -> * ReferenceLoan {
    unsafe {
        var old = next;
        while (old != null && old.expression == expression && old.holder == null) {
            if (old.root == root && old.parent == parent && old.exclusive == exclusive && old.indirect == indirect) {
                return next;
            }
            old = old.next;
        }
        let loan = cast[ * ReferenceLoan](CAlloc(i64(sizeof(ReferenceLoan))));
        loan.root = root;
        loan.parent = parent;
        loan.exclusive = exclusive;
        loan.indirect = indirect;
        loan.expression = expression;
        loan.next = next;
        return loan;
    }
}
// A projection through a computed reference carries a temporary result loan.
// Reborrowing it changes that loan's mode/provenance marker, without guessing
// a single syntactic root or creating a conflicting sibling loan.
fn ReferencePlaceSource(place: * Node) -> * Node {
    unsafe {
        if (place == null) {
            return null;
        }
        if (place.kind == 25 && place.op == 3) { return place.a; }
        if (place.kind == 30 && IsReference(place.a.type)) {
            return place.a;
        }
        if (place.kind == 18 || place.kind == 24 || place.kind == 25 || place.kind == 30) {
            return ReferencePlaceSource(place.a);
        }
        return null;
    }
}
fn ReferenceSourceAccess(check: * ReferenceCheck, before: * ReferenceLoan, via: * Local, root: * Local, exclusive: i64, token: * Token, origin: * Node) {
    unsafe {
        var loan = before;
        while (loan != null) {
            if (loan.root == root && (exclusive != 0 || loan.exclusive != 0) && !ReferenceAncestor(check, loan.holder, via, root) && !(loan.holder == null && loan.expression == origin)) {
                ErrorAt(token, cast[ * u8]("access conflicts with a live scoped reference"));
            }
            loan = loan.next;
        }
    }
}
fn ReferenceAcquire(check: * ReferenceCheck, place: * Node, exclusive: i64, token: * Token, expression: * Node) {
    unsafe {
        let via = BorrowRoot(place);
        let nested = NestedReference(expression.type);
        let origin = ReferencePlaceSource(place);
        if (via == null || (origin != null && origin.kind != 3)) {
            var loan = check.loans;
            var found = false;
            while (loan != null) {
                if (origin != null && loan.expression == origin && loan.holder == null) {
                    if (exclusive > ReferenceMode(origin.type)) {
                        ErrorAt(token, cast[ * u8]("cannot make an exclusive borrow from a shared reference"));
                    }
                    loan.exclusive = exclusive & loan.exclusive;
                    // A scalar projection may retain extra shared roots. Keep
                    // them conservatively rather than losing the anchor.
                    if (!nested) {
                        loan.indirect = 0;
                    }
                    loan.expression = expression;
                    found = true;
                }
                loan = loan.next;
            }
            if (!found) {
                ErrorAt(token, cast[ * u8]("reference result requires a tracked root"));
            }
            return;
        }
        ReferenceAccess(check, place, exclusive != 0);
        let address = expression.kind == 23 && expression.op == 0;
        let bridge = expression.kind == 23 && expression.op == 1;
        let through = ReferenceThroughStored(place);
        let physical = address && !through && (!IsReference(via.type) || place.kind == 22);
        var layer: i64 = 0;
        if (NestedReference(via.type) && (through || expression.kind == 18)) {
            layer = 1;
        }
        let preserve = nested && NestedReference(via.type) && !physical && !bridge;
        let before = check.loans;
        var found = false;
        if (physical) {
            check.loans = ReferenceNew(via, via, exclusive, 0, expression, check.loans);
            found = true;
        }
        var source = before;
        while (source != null) {
            if (source.root != null && source.holder == via && (preserve || bridge || source.indirect == layer)) {
                if (physical) {
                    if (nested) {
                        ReferenceSourceAccess(check, before, via, source.root, exclusive & source.exclusive, token, origin);
                        check.loans = ReferenceNew(source.root, via, exclusive & source.exclusive, 1, expression, check.loans);
                    }
                } else {
                    var mode = exclusive & source.exclusive;
                    var indirect: i64 = 0;
                    if (preserve) {
                        indirect = source.indirect;
                    }
                    ReferenceSourceAccess(check, before, via, source.root, mode, token, origin);
                    check.loans = ReferenceNew(source.root, via, mode, indirect, expression, check.loans);
                    if (nested && !preserve) {
                        check.loans = ReferenceNew(source.root, via, mode & ReferenceMode(Shape(expression.type).element), 1, expression, check.loans);
                    }
                    found = true;
                }
            }
            source = source.next;
        }
        if (!found) {
            check.loans = ReferenceNew(via, via, exclusive, 0, expression, check.loans);
            if (nested) {
                check.loans = ReferenceNew(via, via, exclusive & ReferenceMode(Shape(expression.type).element), 1, expression, check.loans);
            }
        }
    }
}
fn ReferenceRelease(check: * ReferenceCheck, stop: * ReferenceLoan) {
    unsafe {
        while (check.loans != stop) {
            let old = check.loans;
            check.loans = old.next;
            Free(cast[ * u8](old));
        }
    }
}
// Evaluate indices and address bases without mistaking an address for a read.
fn ReferenceAddressMode(check: * ReferenceCheck, node: * Node, writing: bool) {
    unsafe {
        if (node == null) {
            return;
        }
        if (node.kind == 22) {
            return;
        }
        if (node.kind == 24) {
            ReferenceAddressMode(check, node.a, writing);
            return;
        }
        if (node.kind == 25) {
            if (node.op == 3 && node.a.kind == 3) {
                ReferenceAccess(check, node.a, false);
            } else { ReferenceAddressMode(check, node.a, writing); }
            ReferenceValue(check, node.b);
            return;
        }
        if (node.kind == 30) {
            if (writing && IsReference(node.a.type) && Shape(node.a.type).count == 0) {
                ErrorAt(node.token, cast[*u8]("cannot mutate or move through a shared reference"));
            }
            if (IsReference(node.a.type) && node.a.kind == 3) {
                ReferenceAccess(check, node.a, false);
            } else {
                // Calls and temporary borrow expressions must establish their
                // loans before a later index or assignment RHS is evaluated.
                if (IsReference(node.a.type) && node.a.kind == 18) {
                    var mode = Shape(node.a.type).count;
                    if (!writing) { mode = 0; }
                    if (BorrowRoot(node.a.a) != null) {
                        ReferenceAddressMode(check, node.a.a, false);
                        ReferenceAcquire(check, node.a.a, mode, node.a.token, node.a);
                    } else { ReferenceProjection(check, node.a, mode); }
                } else {
                    if (AggregateKind(node.a.type) == 5 && node.a.kind == 18) {
                        ReferenceAddressMode(check, node.a.a, writing);
                        ReferenceAccess(check, node.a.a, false);
                    } else { ReferenceValue(check, node.a); }
                }
                if (AggregateKind(node.a.type) == 5) {
                    let origin = ReferencePlaceSource(node);
                    if (origin != null) {
                        var pin = check.loans;
                        var retained = false;
                        while (pin != null) {
                            if (pin.holder == null && pin.expression == origin) {
                                retained = true;
                            }
                            pin = pin.next;
                        }
                        // Loading an owner's pointer creates a pending address.
                        // A named reference must not move/replace that owner
                        // while a later index or assignment RHS is evaluated.
                        if (!retained) {
                            ReferenceAcquire(check, origin, 0, node.token, origin);
                        }
                    }
                }
            }
            return;
        }
        ReferenceValue(check, node);
    }
}
fn ReferenceAddress(check: * ReferenceCheck, node: * Node) {
    ReferenceAddressMode(check, node, true);
}
fn ReferenceAddressIndices(check: * ReferenceCheck, node: * Node) {
    unsafe {
        if (node == null) {
            return;
        }
        if (node.kind == 25) {
            ReferenceValue(check, node.b);
        }
    }
}
fn ReferenceProjection(check:*ReferenceCheck, node:*Node, mode:i64) {
    unsafe {
        let origin = node.origin_source;
        if (origin == null) { ErrorAt(node.token, cast[*u8]("reference projection requires an origin")); }
        if (mode != 0 && NestedReference(origin.type) && Shape(origin.type).count == 0) {
            ErrorAt(node.token, cast[*u8]("cannot mutate or move through a shared reference"));
        }
        let before = check.loans;
        if (origin.kind == 18 && TrackedBorrow(origin.type) && BorrowRoot(origin.a) == null) {
            ReferenceProjection(check, origin, mode);
        } else { ReferenceValue(check, origin); }
        var source = check.loans;
        while (source != before) {
            if (source.expression == origin && (!NestedReference(origin.type) || source.indirect != 0)) {
                check.loans = ReferenceNew(source.root, source.parent, mode & source.exclusive, 0, node, check.loans);
            }
            source = source.next;
        }
        ReferenceAddressIndices(check, node.a);
    }
}
fn ReferenceValue(check: * ReferenceCheck, node: * Node) {
    unsafe {
        if (node == null) {
            return;
        }
        // len of a named slice observes only its descriptor, not its elements.
        if (node.kind == 27 && AggregateKind(node.a.type) == 3 && node.a.kind == 3) { return; }
        if (node.kind == 26) {
            if (node.op == 2) {
                ReferenceAddressMode(check, node.a, true);
                ReferenceAcquire(check, node.a, 1, node.token, node);
            } else {
                let before = check.loans;
                ReferenceValue(check, node.a);
                var loan = check.loans;
                while (loan != before) {
                    if (loan.expression == node.a) { loan.expression = node; }
                    loan = loan.next;
                }
            }
            ReferenceValue(check, node.b);
            ReferenceValue(check, node.c);
            return;
        }
        if (TrackedBorrow(node.type) && (node.kind == 3 || node.kind == 18)) {
            var mode = ReferenceMode(node.type);
            if (node.kind == 3) {
                ReferenceAcquire(check, node, mode, node.token, node);
                return;
            }
            if (BorrowRoot(node.a) != null) {
                ReferenceAddressMode(check, node.a, mode != 0);
                ReferenceAcquire(check, node.a, mode, node.token, node);
            } else {
                ReferenceProjection(check, node, mode);
            }
            return;
        }
        if (IsReference(node.type)) {
            if (node.kind == 23) {
                if (node.op == 1) {
                    ReferenceValue(check, node.a);
                    ReferenceAcquire(check, node.origin_source, Shape(node.type).count, node.token, node);
                    return;
                }
                ReferenceAddressMode(check, node.a, Shape(node.type).count != 0);
                ReferenceAcquire(check, node.a, Shape(node.type).count, node.token, node);
                return;
            }
            if (node.kind == 3) {
                ReferenceAcquire(check, node, Shape(node.type).count, node.token, node);
                return;
            }
            if (node.kind != 4) {
                ErrorAt(node.token, cast[ * u8]("unsupported scoped reference expression"));
            }
        }
        if (node.kind == 3) {
            ReferenceAccess(check, node, false);
            return;
        }
        if (node.kind == 18) {
            let before = check.loans;
            ReferenceAddressMode(check, node.a, false);
            ReferenceAccess(check, node.a, false);
            // Plain copies no longer depend on the address. Owner handles can
            // still be dereferenced by a surrounding projection: retain pins.
            if (Owned(node.type) == i8(0)) {
                ReferenceRelease(check, before);
            }
            return;
        }
        if (node.kind == 29) {
            ReferenceAddress(check, node.a);
            if (TrackedBorrow(node.type)) { ReferenceAcquire(check, node.a, ReferenceMode(node.type), node.token, node); }
            else { ReferenceAccess(check, node.a, true); }
            return;
        }
        if (node.kind == 22 || node.kind == 24 || node.kind == 25 || node.kind == 30) {
            ReferenceAddressMode(check, node, node.op != 1 || node.kind != 30);
            ReferenceAccess(check, node, node.op != 1 || node.kind != 30);
            return;
        }
        if (node.kind == 4) {
            let saved = check.loans;
            var contract: i64 = 0;
            if (TrackedBorrow(node.type)) {
                let ctx = cast[ * CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
                contract = ctx.v_functions[node.slot].borrow_contract;
                if (contract == 0 && IsReference(node.type)) {
                    ErrorAt(node.token, cast[ * u8]("reference return requires at least one borrows source"));
                }
            }
            var results: * ReferenceLoan = null;
            var index: i64 = 0;
            var arg = node.a;
            while (arg != null) {
                let before = check.loans;
                ReferenceValue(check, arg);
                if ((contract & (1 << index)) != 0) {
                    if (!TrackedBorrow(arg.type)) {
                        ErrorAt(node.token, cast[ * u8]("reference return requires a tracked reference argument"));
                    }
                    var source = check.loans;
                    var found = false;
                    while (source != before) {
                        if (source.expression == arg) {
                            found = true;
                            var mode = ReferenceMode(node.type) & source.exclusive;
                            var indirect: i64 = 0;
                            if (NestedReference(node.type) && NestedReference(arg.type)) {
                                indirect = source.indirect;
                            }
                            results = ReferenceNew(source.root, source.parent, mode, indirect, node, results);
                            // An opaque non-nested anchor may protect both the
                            // returned storage and its borrowed payloads.
                            if (NestedReference(node.type) && !NestedReference(arg.type)) {
                                results = ReferenceNew(source.root, source.parent, mode & ReferenceMode(Shape(node.type).element), 1, node, results);
                            }
                        }
                        source = source.next;
                    }
                    if (!found && IsReference(arg.type)) {
                        ErrorAt(node.token, cast[ * u8]("reference return requires a tracked reference argument"));
                    }
                }
                index = index + 1;
                arg = arg.next;
            }
            if (TrackedBorrow(node.type)) {
                // Argument loans protect later arguments until the call completes.
                // Replace them with the union selected by the declared contract.
                ReferenceRelease(check, saved);
                while (results != null) {
                    let loan = results;
                    results = loan.next;
                    loan.next = check.loans;
                    check.loans = loan;
                }
            }
            return;
        }
        if (node.kind == 23) {
            if (ContainsReference(node.type) && node.a == null) {
                ErrorAt(node.token, cast[ * u8]("reference storage requires an explicit initializer"));
            }
            var item = node.a;
            while (item != null) {
                let before = check.loans;
                ReferenceValue(check, item);
                if (TrackedBorrow(node.type)) {
                    var source = check.loans;
                    while (source != before) {
                        if (source.expression == item) {
                            source.expression = node;
                        }
                        source = source.next;
                    }
                }
                item = item.next;
            }
            return;
        }
        ReferenceValue(check, node.a);
        ReferenceValue(check, node.b);
        ReferenceValue(check, node.c);
    }
}
// Slice replacement accumulates possible roots at the binding's original
// lifetime marker, so branches and nested blocks cannot release them early.
fn ReferenceAssign(check:*ReferenceCheck, target:*Local, value:*Node, stop:*ReferenceLoan) {
    unsafe {
        var marker = stop;
        while (marker != null && !(marker.root == null && marker.holder == target)) { marker = marker.next; }
        if (marker == null) { ErrorAt(value.token, cast[*u8]("borrowed assignment requires local tracked storage")); }
        var loan = check.loans;
        while (loan != stop) {
            if (loan.expression == value && loan.root != null) {
                if (loan.root.depth > target.depth) { ErrorAt(value.token, cast[*u8]("assigned borrow may outlive local storage")); }
                var parent = loan.parent;
                if (ReferenceAncestor(check, target, parent, loan.root)) {
                    let previous = ReferenceHolder(check, target, loan.root);
                    if (previous != null) { parent = previous.parent; } else { parent = null; }
                }
                let retained = ReferenceNew(loan.root, parent, loan.exclusive, loan.indirect, value, marker.next);
                retained.holder = target;
                marker.next = retained;
            }
            loan = loan.next;
        }
    }
}
fn ReferenceStatement(check: * ReferenceCheck, node: * Node) {
    unsafe {
        if (node == null) {
            return;
        }
        let saved = check.loans;
        if (node.kind == 12) {
            var statement = node.a;
            while (statement != null) {
                ReferenceStatement(check, statement);
                statement = statement.next;
            }
            ReferenceRelease(check, saved);
            return;
        }
        if (node.kind == 7 && TrackedBorrow(node.type)) {
            ReferenceValue(check, node.a);
            var link = & raw check.loans;
            while ( * link != saved) {
                let loan = * link;
                if (loan.expression == node.a) {
                    loan.holder = node.local_ref;
                    link = & raw loan.next;
                } else {
                    * link = loan.next;
                    Free(cast[ * u8](loan));
                }
            }
            let marker = ReferenceNew(null, null, 0, 0, node, check.loans);
            marker.holder = node.local_ref;
            check.loans = marker;
            return;
        }
        if (node.kind == 8) {
            if (ContainsReference(node.type)) {
                ErrorAt(node.token, cast[ * u8]("scoped reference bindings cannot be reassigned"));
            }
            ReferenceValue(check, node.a);
            ReferenceAccess(check, node, true);
            if (TrackedBorrow(node.type)) { ReferenceAssign(check, node.local_ref, node.a, saved); }
        } else {
            if (node.kind == 19) {
                if (ContainsReference(node.type)) {
                    ErrorAt(node.token, cast[ * u8]("stored reference fields cannot be reassigned"));
                }
                ReferenceAddress(check, node.a);
                ReferenceValue(check, node.b);
                ReferenceAccess(check, node.a, true);
                if (TrackedBorrow(node.type)) { ReferenceAssign(check, BorrowRoot(node.a), node.b, saved); }
            } else {
                if (node.kind == 10 || node.kind == 11 || node.kind == 21) {
                    ReferenceValue(check, node.a);
                    ReferenceRelease(check, saved);
                    ReferenceStatement(check, node.b);
                    ReferenceStatement(check, node.c);
                } else {
                    ReferenceValue(check, node.a);
                }
            }
        }
        if (node.kind != 15) {
            ReferenceRelease(check, saved);
        }
    }
}
fn AnalyzeReferences(function: * Function) {
    unsafe {
        var check = ReferenceCheck {
        };
        check.function = function;
        ReferenceStatement( & raw check, function.body);
        ReferenceRelease( & raw check, null);
    }
}
fn RawReferenceExpression() -> * Node {
    unsafe {
        let ctx = cast[ * CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        let token = At();
        ctx.v_pos = ctx.v_pos + 1;
        if (ctx.v_unsafe_depth == 0) {
            ErrorAt(token, cast[ * u8]("borrow_raw requires unsafe"));
        }
        Need(91, cast[ * u8]("expected '[' after borrow_raw"));
        let type = ParseType();
        Need(93, cast[ * u8]("expected ']'"));
        if (!IsReference(type)) {
            ErrorAt(token, cast[ * u8]("borrow_raw requires a reference result type"));
        }
        ValidateReferenceStorage(type, token);
        Need(40, cast[ * u8]("expected '('"));
        let pointer = Expr(1);
        Need(44, cast[ * u8]("expected anchor argument"));
        let anchor = Expr(1);
        Need(41, cast[ * u8]("expected ')'"));
        if (pointer.type != 100000 + Shape(type).element) {
            ErrorAt(token, cast[ * u8]("borrow_raw pointer element type mismatch"));
        }
        if (anchor.kind != 3 || !IsReference(anchor.type)) {
            ErrorAt(token, cast[ * u8]("borrow_raw anchor must be a named reference"));
        }
        if (Shape(type).count > Shape(anchor.type).count) {
            ErrorAt(token, cast[ * u8]("exclusive reference requires an exclusive anchor"));
        }
        let result = NewNode(23, token);
        result.type = type;
        result.storage = Storage(type);
        result.op = 1;
        result.a = pointer;
        result.origin_source = anchor;
        return result;
    }
}
fn ReferencePointerCast(value: * Node, type: i64, token: * Token) -> * Node {
    unsafe {
        let ctx = cast[ * CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        if (ctx.v_unsafe_depth == 0) {
            ErrorAt(token, cast[ * u8]("reference pointer casts require unsafe"));
        }
        if (type != 100000 + Shape(value.type).element) {
            ErrorAt(token, cast[ * u8]("reference pointer cast element type mismatch"));
        }
        let result = NewNode(30, token);
        result.a = value;
        result.type = type;
        result.op = 1;
        return result;
    }
}
