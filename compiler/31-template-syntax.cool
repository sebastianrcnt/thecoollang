// Template signature grammar is checked even when no specialization is used.
// Resolve nominal names and arity without constructing concrete layouts.
fn TemplateTypeSyntax(function: *Function, nesting: i64) -> i64 {
    unsafe {
        let ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        if (nesting > 256) { Error(cast[*u8]("template type syntax nesting limit exceeded")); }
        if (Take(38) != i8(0)) {
            if (Is(cast[*u8]("mut")) != i8(0)) { ctx.v_pos = ctx.v_pos + 1; }
            if (TemplateTypeSyntax(function, nesting + 1) != 0) { Error(cast[*u8]("invalid element type")); } return 0;
        }
        if (Take(42) != i8(0)) { TemplateTypeSyntax(function, nesting + 1); return 0; }
        if (Is(cast[*u8]("own")) != i8(0)) {
            ctx.v_pos = ctx.v_pos + 1;
            Need(91, cast[*u8]("expected '[' after own"));
            if (TemplateTypeSyntax(function, nesting + 1) != 0) { Error(cast[*u8]("invalid element type")); }
            Need(93, cast[*u8]("expected ']' after owned type")); return 0;
        }
        if (Take(91) != i8(0)) {
            if (Take(93) == i8(0)) {
                let length = At().val;
                Need(257, cast[*u8]("array length must be an integer literal"));
                if (length < 0 || length > 65536) { Error(cast[*u8]("array length outside 0..65536")); }
                Need(93, cast[*u8]("expected ']'"));
            }
            if (TemplateTypeSyntax(function, nesting + 1) != 0) { Error(cast[*u8]("invalid element type")); } return 0;
        }
        var expected = TemplateNamedArity(function);
        let is_void = expected < 0; if (is_void) { expected = 0; }
        var count: i64 = 0;
        if (Take(91) != i8(0)) {
            while (true) {
                if (count == 8) { Error(cast[*u8]("generic argument limit exceeded")); }
                if (TemplateTypeSyntax(function, nesting + 1) != 0) { Error(cast[*u8]("generic argument cannot be void")); } count = count + 1;
                if (Take(44) == i8(0)) { break; }
            }
            Need(93, cast[*u8]("expected ']' after type arguments"));
        }
        if (count != expected) { Error(cast[*u8]("wrong generic argument count")); }
        return BoolInt(is_void);
    }
}
fn TemplateSignatureSyntax(function: *Function) {
    unsafe {
        let ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        var names: [32]*u8 = [32]*u8{};
        var starts:[32]i64=[32]i64{};var ends:[32]i64=[32]i64{};
        var count: i64 = 0;
        Need(40, cast[*u8]("expected '(' after function name"));
        if (Take(41) == i8(0)) {
            while (true) {
                if (count == 32) { Error(cast[*u8]("function argument limit exceeded")); }
                let name = Ident();
                for (var i: i64 = 0; i < count; i = i + 1) {
                    if (Eq(names[i], name) != i8(0)) { Error(cast[*u8]("duplicate parameter name")); }
                }
                names[count] = name; count = count + 1;
                Need(58, cast[*u8]("expected ':' after parameter"));
                starts[count-1]=ctx.v_pos;
                if (TemplateTypeSyntax(function, 0) != 0) { Error(cast[*u8]("parameter cannot be void")); }
                ends[count-1]=ctx.v_pos;
                if (Take(44) == i8(0)) { break; }
            }
            Need(41, cast[*u8]("expected ')'"));
        }
        if (Take(265) != i8(0)) { TemplateTypeSyntax(function, 0); }
        if (Is(cast[*u8]("borrows")) != i8(0)) {
            ctx.v_pos = ctx.v_pos + 1;
            Need(40, cast[*u8]("expected '(' after borrows"));
            if (Take(41) == i8(0)) {
                while (true) {
                    let name = Ident(); var i: i64 = 0;
                    while (i < count) {
                        if (Eq(names[i], name) != i8(0)) { break; }
                        i = i + 1;
                    }
                    if (i == count) { Error(cast[*u8]("unknown parameter in borrows contract")); }
                    if (Take(44) == i8(0)) { break; }
                }
                Need(41, cast[*u8]("expected ')' after borrows contract"));
            }
        }
        if(Is(cast[*u8]("stores"))!=i8(0)){
            var contract=Function{};contract.argc=count;let saved=ctx.v_pos;
            for(var i:i64=0;i<count;i=i+1){
                contract.arg_names[i]=names[i];contract.arg_types[i]=-1;var dependent=false;
                for(var token:i64=starts[i];token<ends[i];token=token+1){
                    for(var generic:i64=0;generic<function.generic_count;generic=generic+1){
                        if(ctx.v_tokens[token].kind==256 && Eq(ctx.v_tokens[token].text,function.generic_names[generic])!=i8(0)){dependent=true;}
                    }
                }
                if(!dependent){ctx.v_pos=starts[i];contract.arg_types[i]=ParseType();}
            }
            ctx.v_pos=saved;StoreSignature(&raw contract,false);
        }
        if (At().kind != 123) { Error(cast[*u8]("expected function body after signature")); }
    }
}

fn TemplateNamedArity(function: *Function) -> i64 {
    unsafe {
        let token = At(); var name = Ident(); var package = token.package;
        for (var i: i64 = 0; i < function.generic_count; i = i + 1) {
            if (Eq(name, function.generic_names[i]) != i8(0)) { return 0; }
        }
        if (TypeName(name) == 0) { return -1; }
        if (TypeName(name) >= 0) { return 0; }
        if (FindType(package, name) < 0 && Take(46) != i8(0)) {
            package = ResolveAlias(token, name); name = Ident();
        }
        let type = FindType(package, name);
        if (type < 0) { ErrorAt(token, cast[*u8]("unsupported or unknown type")); }
        if (Eq(package, token.package) == i8(0) && Shape(type).public == i8(0)) {
            ErrorAt(token, cast[*u8]("type is private to its package"));
        }
        EditorTypeReference(name, type);
        return Shape(type).generic_count;
    }
}
