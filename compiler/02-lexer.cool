fn Alpha(arg_v_ch1: i64) -> i8 {
unsafe {
var ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
var v_ch1: i64 = arg_v_ch1;
var t0: bool = false;
var t1: bool = false;
var t2: bool = false;
var t3: bool = false;
t0 = (97 <= v_ch1);
if (t0) {
t0 = (v_ch1 <= 122);
}
t1 = t0;
if (!t1) {
t2 = (65 <= v_ch1);
if (t2) {
t2 = (v_ch1 <= 90);
}
t1 = t2;
}
t3 = t1;
if (!t3) {
t3 = (v_ch1 == 95);
}
return i8(BoolInt(t3));
}
return i8(0);
}


fn Digit(arg_v_ch2: i64) -> i8 {
unsafe {
var ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
var v_ch2: i64 = arg_v_ch2;
var t0: bool = false;
t0 = (48 <= v_ch2);
if (t0) {
t0 = (v_ch2 <= 57);
}
return i8(BoolInt(t0));
}
return i8(0);
}


fn LexSource(arg_v_src: *u8, arg_v_file: *u8) {
    unsafe {
        var ctx = cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
        var src: *u8 = arg_v_src;
        var file: *u8 = arg_v_file;
        if (ctx.v_tokens == null) {
            ctx.v_tokens = cast[*Token](CAlloc(i64(u64(262144) * sizeof(Token))));
        }
        var i: i64 = 0;
        var line: i64 = 1;
        var col: i64 = 1;
        var start: i64 = 0;
        var ch: i64 = 0;
        var next: i64 = 0;
        var base: i64 = 0;
        var d: i64 = 0;
        var ok: i64 = 0;
        var comment_start: i64 = 0;
        var digits: i64 = 0;
        var emitted: i8 = i8(0);
        var integer_overflow: bool = false;
        var t: *Token = null;
        var text: *Text = null;
        var number: *u8 = null;
        while (i64(src[i]) != 0) {
            emitted = i8(0);
            ch = i64(src[i]);
            next = i64(src[i + 1]);
            if (ch == 32 || ch == 9 || ch == 13 || ch == 10) {
                i = i + 1;
                col = col + 1;
                if (ch == 10) { line = line + 1; col = 1; }
            } else if (ch == 47 && next == 47) {
                comment_start = i;
                while (i64(src[i]) != 0 && i64(src[i]) != 10) { i = i + 1; col = col + 1; }
                CompletionExcluded(file, comment_start, i + 1);
            } else if (ch == 47 && next == 42) {
                comment_start = i;
                i = i + 2;
                col = col + 2;
                while (i64(src[i]) != 0 && !(i64(src[i]) == 42 && i64(src[i + 1]) == 47)) {
                    if (i64(src[i]) == 10) { line = line + 1; col = 0; }
                    i = i + 1;
                    col = col + 1;
                }
                if (i64(src[i]) == 0) {
                    (ctx.v_tokens[ctx.v_ntok]).file = file;
                    (ctx.v_tokens[ctx.v_ntok]).line = line;
                    (ctx.v_tokens[ctx.v_ntok]).col = col;
                    ErrorAt(&raw ctx.v_tokens[ctx.v_ntok], cast[*u8]("unterminated comment"));
                }
                i = i + 2;
                col = col + 2;
                CompletionExcluded(file, comment_start, i);
            } else {
                if (ctx.v_ntok >= (262144 - 2)) {
                    ctx.v_tokens[ctx.v_ntok].file = file;
                    ctx.v_tokens[ctx.v_ntok].line = line;
                    ctx.v_tokens[ctx.v_ntok].col = col;
                    ErrorAt(&raw ctx.v_tokens[ctx.v_ntok], cast[*u8]("token limit exceeded"));
                }
                t = &raw ((ctx.v_tokens)[ctx.v_ntok]);
                ctx.v_ntok = ctx.v_ntok + 1;
                t.val = 0;
                t.text = null;
                t.raw = null;
                t.kind = 0;
                t.file = file;
                t.package = ctx.v_lex_package;
                t.line = line;
                t.col = col;
                start = i;
                t.start = i;
                emitted = i8(1);
                if (Alpha(ch) != i8(0)) {
                    i = i + 1;
                    col = col + 1;
                    while (Alpha(i64(src[i])) != i8(0) || Digit(i64(src[i])) != i8(0)) { i = i + 1; col = col + 1; }
                    t.kind = 256;
                    t.text = Slice(src, start, i);
                } else if (Digit(ch) != i8(0)) {
                    t.kind = 257;
                    base = 10;
                    if (ch == 48 && (next == 120 || next == 98)) {
                        base = 16;
                        if (next == 98) { base = 2; }
                        i = i + 2;
                        col = col + 2;
                    }
                    digits = 0;
                    integer_overflow = false;
                    start = i;
                    while (i64(src[i]) != 0) {
                        ch = i64(src[i]);
                        d = -1;
                        if (Digit(ch) != i8(0)) { d = ch - 48; }
                        if (97 <= ch && ch <= 102) { d = (ch - 97) + 10; }
                        if (65 <= ch && ch <= 70) { d = (ch - 65) + 10; }
                        if (ch == 95) { i = i + 1; col = col + 1; continue; }
                        if (d < 0 || d >= base) { break; }
                        if (u64(t.val) > ((18446744073709551615 - u64(d)) / u64(base))) { integer_overflow = true; }
                        digits = digits + 1;
                        if (!integer_overflow) { t.val = (t.val * base) + d; }
                        i = i + 1;
                        col = col + 1;
                    }
                    if (base == 10 && ((i64(src[i]) == 46 && Digit(i64(src[i + 1])) != i8(0)) || i64(src[i]) == 101 || i64(src[i]) == 69)) {
                        if (i64(src[i]) == 46) {
                            i = i + 1;
                            col = col + 1;
                            while (Digit(i64(src[i])) != i8(0)) { i = i + 1; col = col + 1; }
                        }
                        if (i64(src[i]) == 101 || i64(src[i]) == 69) {
                            i = i + 1;
                            col = col + 1;
                            if (i64(src[i]) == 43 || i64(src[i]) == 45) { i = i + 1; col = col + 1; }
                            if (Digit(i64(src[i])) == i8(0)) { ErrorAt(t, cast[*u8]("expected exponent digits")); }
                            while (Digit(i64(src[i])) != i8(0)) { i = i + 1; col = col + 1; }
                        }
                        number = Slice(src, t.start, i);
                        t.val = NativeParseFloat(number, &raw ok);
                        Free(number);
                        if (!(ok != 0)) { ErrorAt(t, cast[*u8]("floating literal out of range or invalid")); }
                        t.kind = 268;
                    }
                    if (integer_overflow && t.kind == 257) { ErrorAt(t, cast[*u8]("integer literal exceeds u64 range")); }
                    if (digits == 0 || Alpha(i64(src[i])) != i8(0) || Digit(i64(src[i])) != i8(0)) { ErrorAt(t, cast[*u8]("invalid integer literal")); }
                } else if (ch == 34) {
                    text = TextNew();
                    ctx.v_lex_pending = text;
                    i = i + 1;
                    col = col + 1;
                    while (i64(src[i]) != 0 && i64(src[i]) != 34) {
                        ch = i64(src[i]);
                        i = i + 1;
                        col = col + 1;
                        if (ch == 10) { ErrorAt(t, cast[*u8]("newline in string literal")); }
                        if (ch == 92) {
                            ch = i64(src[i]);
                            i = i + 1;
                            col = col + 1;
                            if (ch == 110) { ch = 10; }
                            else if (ch == 116) { ch = 9; }
                            else if (ch == 114) { ch = 13; }
                            else if (ch != 92 && ch != 34) { ErrorAt(t, cast[*u8]("unsupported string escape")); }
                        }
                        Char(text, ch);
                    }
                    if (i64(src[i]) == 0) { ErrorAt(t, cast[*u8]("unterminated string literal")); }
                    Reserve(text, 0);
                    t.text = (text).data;
                    Free(cast[*u8](text));
                    ctx.v_lex_pending = null;
                    t.kind = 258;
                    i = i + 1;
                    col = col + 1;
                } else {
                    t.kind = ch;
                    i = i + 1;
                    col = col + 1;
                    if (ch == 61 && next == 62) { t.kind = 269; }
                    if (ch == 61 && next == 61) { t.kind = 259; }
                    if (ch == 33 && next == 61) { t.kind = 260; }
                    if (ch == 60 && next == 61) { t.kind = 261; }
                    if (ch == 62 && next == 61) { t.kind = 262; }
                    if (ch == 38 && next == 38) { t.kind = 263; }
                    if (ch == 124 && next == 124) { t.kind = 264; }
                    if (ch == 45 && next == 62) { t.kind = 265; }
                    if (ch == 60 && next == 60) { t.kind = 266; }
                    if (ch == 62 && next == 62) { t.kind = 267; }
                    if (t.kind >= 259) { i = i + 1; col = col + 1; }
                }
            }
            if (emitted != i8(0)) {
                t.end = i;
                t.raw = Slice(src, t.start, i);
            }
        }
        ctx.v_tokens[ctx.v_ntok].start = i;
        ctx.v_tokens[ctx.v_ntok].end = i;
        (ctx.v_tokens[ctx.v_ntok]).kind = 0;
        (ctx.v_tokens[ctx.v_ntok]).file = file;
        (ctx.v_tokens[ctx.v_ntok]).line = line;
        (ctx.v_tokens[ctx.v_ntok]).col = col;
    }
    return;
}


// File and submission lengths are authoritative; a NUL inside that length is
// not EOF. Validate before tokenization or any command/manifest interpretation.
fn ValidateInput(source: *u8, size: i64, file: *u8) {
    unsafe {
        var i:i64=0;var line:i64=1;var column:i64=1;
        while(i<size){
            let first=i64(source[i]);var width:i64=1;var invalid=false;
            var message=cast[*u8]("invalid UTF-8 in input");
            if(first==0){invalid=true;message=cast[*u8]("embedded NUL byte in input");}
            else if(first>=128){
                if(first>=194 && first<=223){width=2;}
                else if(first>=224 && first<=239){width=3;}
                else if(first>=240 && first<=244){width=4;}
                else{invalid=true;}
                if(width>size-i){invalid=true;}
                if(!invalid){
                    for(var part:i64=1;part<width;part=part+1){
                        let next=i64(source[i+part]);if(next<128 || next>191){invalid=true;}
                    }
                    let second=i64(source[i+1]);
                    if((first==224 && second<160) || (first==237 && second>=160) || (first==240 && second<144) || (first==244 && second>=144)){invalid=true;}
                }
            }
            if(invalid){
                var token=Token{};token.file=file;token.start=i;token.end=i+1;token.line=line;token.col=column;
                ErrorAt(&raw token,message);
            }
            if(first==10){line=line+1;column=1;}else{column=column+width;}
            i=i+width;
        }
    }
}
