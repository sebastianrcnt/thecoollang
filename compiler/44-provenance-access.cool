// Root overlap is independent of capability. A shared path still accesses its
// root and must conflict with an unrelated exclusive loan. This query may prove
// payload absence; it never grants writes or weakens physical root protection.
fn ReferencePathMayAccess(source: *ReferenceLoan, path: *ProvenanceCursor, complete: i64) -> bool {
    unsafe {
        if (complete == 0) { return true; }
        if (source.provenance == null) { return source.provenance_known == 0; }
        let first = cast[*ProvenanceQueryState](CAlloc(i64(sizeof(ProvenanceQueryState))));
        first.node = source.provenance; first.cursor = path;
        var tail = first;
        var current = first;
        var found = false;
        while (current != null && !found) {
            let node = current.node;
            let cursor = current.cursor;
            // A terminal protects addressed storage and every child place, even
            // when the cursor still has fields/elements/referents to traverse.
            if (node.root == source.root && node.root != null) { found = true; }
            else if (node.opaque != 0 || (cursor != null && node.type != cursor.type)) { found = true; }
            else {
                var edge = node.edges;
                while (edge != null) {
                    if (cursor == null) {
                        tail = ProvenanceQueryAppend(first, tail, edge.target, null, 0);
                    } else if (edge.kind == cursor.kind && (cursor.kind != 1 || edge.key == cursor.key)) {
                        tail = ProvenanceQueryAppend(first, tail, edge.target, cursor.next, 0);
                    }
                    edge = edge.next;
                }
            }
            current = current.next;
        }
        current = first;
        while (current != null) { let next = current.next; Free(cast[*u8](current)); current = next; }
        return found;
    }
}
fn ReferencePayloadMayAccess(source: *ReferenceLoan, place: *Node, via: *Local) -> bool {
    unsafe {
        // Layer zero can be a physical address rather than value provenance.
        // Keep its established coarse overlap rules until typed places replace
        // the physical checker. Direct-root checks are likewise authoritative.
        if (source.indirect == 0 || source.root == via) { return true; }
        var cursor = ReferencePlaceCursor(place, via, null);
        let found = ReferencePathMayAccess(source, cursor.path, cursor.complete);
        ReferenceCursorFree(cursor.path);
        return found;
    }
}

// Bit 1: an exclusive terminal; bit 2: a shared terminal; bit 4: unknown.
// Every possible path contributes. An exclusive alternative cannot erase a
// shared alternative. Unknown paths retain the established scoped checks.
fn ReferencePathAuthorityModes(source: *ReferenceLoan, path: *ProvenanceCursor, complete: i64, copying: bool) -> i64 {
    unsafe {
        if (complete == 0) { return 4; }
        if (source.provenance == null) {
            if (source.provenance_known != 0) { return 0; }
            return 4;
        }
        let first = cast[*ProvenanceQueryState](CAlloc(i64(sizeof(ProvenanceQueryState))));
        first.node = source.provenance; first.cursor = path; first.exclusive = source.exclusive;
        var current = first; var tail = first; var modes: i64 = 0;
        while (current != null) {
            let node = current.node; let cursor = current.cursor;
            // A cursor ending at a value writes that slot, not its referents.
            if (cursor == null) {
                if (copying) {
                    if (node.opaque != 0) { modes = modes | 4; }
                    else if (IsReference(node.type) || AggregateKind(node.type) == 3) {
                        // Copy the handle, never the referents inside its payload.
                        if (ReferenceMode(node.type) != 0 && node.root == source.root && node.root != null) {
                            if ((current.exclusive & node.exclusive) != 0) { modes = modes | 1; }
                            else { modes = modes | 2; }
                        }
                    } else {
                        var edge = node.edges;
                        while (edge != null) {
                            tail = ProvenanceQueryAppend(first, tail, edge.target, null, current.exclusive & edge.exclusive);
                            edge = edge.next;
                        }
                    }
                }
            }
            else if (node.opaque != 0 || node.type != cursor.type) { modes = modes | 4; }
            else {
                if (node.root == source.root && node.root != null) {
                    if ((current.exclusive & node.exclusive) != 0) { modes = modes | 1; }
                    else { modes = modes | 2; }
                }
                // Physical protection is one contribution, not a stopping rule:
                // a deeper referent of this same root may cross a shared barrier.
                var edge = node.edges;
                while (edge != null) {
                    if (edge.kind == cursor.kind && (cursor.kind != 1 || edge.key == cursor.key)) {
                        tail = ProvenanceQueryAppend(first, tail, edge.target, cursor.next, current.exclusive & edge.exclusive);
                    }
                    edge = edge.next;
                }
            }
            current = current.next;
        }
        current = first;
        while (current != null) { let next = current.next; Free(cast[*u8](current)); current = next; }
        return modes;
    }
}
fn ReferenceRequirePayloadWrite(check: *ReferenceCheck, place: *Node, via: *Local) {
    unsafe {
        if (!ReferenceThroughStored(place)) { return; }
        var cursor = ReferencePlaceCursor(place, via, null);
        var source = check.loans;
        var shared = false;
        while (source != null) {
            if (source.holder == via && source.indirect == 1 && source.root != null && source.root != via) {
                if ((ReferencePathWriteModes(source, cursor.path, cursor.complete) & 2) != 0) { shared = true; }
            }
            source = source.next;
        }
        ReferenceCursorFree(cursor.path);
        if (shared) { ErrorAt(place.token, cast[*u8]("cannot mutate or move through a shared reference")); }
    }
}

fn ReferencePathWriteModes(source: *ReferenceLoan, path: *ProvenanceCursor, complete: i64) -> i64 {
    return ReferencePathAuthorityModes(source, path, complete, false);
}
fn ReferencePathCopyModes(source: *ReferenceLoan, path: *ProvenanceCursor, complete: i64) -> i64 {
    return ReferencePathAuthorityModes(source, path, complete, true);
}
fn ReferenceRequirePayloadCopy(check: *ReferenceCheck, place: *Node, via: *Local) {
    unsafe {
        var cursor = ReferencePlaceCursor(place, via, null);
        var source = check.loans;
        var shared = false;
        while (source != null) {
            if (source.holder == via && source.root != null) {
                if ((ReferencePathCopyModes(source, cursor.path, cursor.complete) & 2) != 0) { shared = true; }
            }
            source = source.next;
        }
        ReferenceCursorFree(cursor.path);
        if (shared) { ErrorAt(place.token, cast[*u8]("cannot copy or move an exclusive reference through a shared path")); }
    }
}

// Query temporary origins before selection/retagging destroys their identity.
fn ReferenceRequireComputedAuthority(check: *ReferenceCheck, place: *Node, origin: *Node, copying: bool) {
    unsafe {
        if (origin == null) { return; }
        let via = BorrowRoot(place);
        if (via != null) {
            if (copying) { ReferenceRequirePayloadCopy(check, place, via); }
            else { ReferenceRequirePayloadWrite(check, place, via); }
            return;
        }
        // Projection read pins deliberately lower their loan mode. Original
        // temporary source loans remain live until the enclosing operation ends.
        var boundary = origin;
        var current = origin;
        while (current != null && current.kind == 18) {
            let parent = ReferencePlaceSource(current.a);
            if (parent == null || parent == current) { break; }
            var candidate = check.loans;
            while (candidate != null) {
                if (candidate.holder == null && candidate.expression == parent && candidate.root != null) { boundary = parent; }
                candidate = candidate.next;
            }
            current = parent;
        }
        var cursor = ReferencePlaceCursor(place, null, boundary);
        var source = check.loans;
        var shared = false;
        while (source != null) {
            if (source.holder == null && source.expression == boundary && source.root != null) {
                if ((ReferencePathAuthorityModes(source, cursor.path, cursor.complete, copying) & 2) != 0) { shared = true; }
            }
            source = source.next;
        }
        ReferenceCursorFree(cursor.path);
        if (shared) {
            if (copying) { ErrorAt(place.token, cast[*u8]("cannot copy or move an exclusive reference through a shared path")); }
            ErrorAt(place.token, cast[*u8]("cannot mutate or move through a shared reference"));
        }
    }
}
