        else if (op == 266) { result = left << right; }
        else if (op == 267) { if (unsigned) { result = i64(u64(left) >> right); } else { result = left >> right; } }
        else if (op == 259) { result = BoolInt(left == right); }
        else if (op == 260) { result = BoolInt(left != right); }
        else if (op == 60) { if (unsigned) { result = BoolInt(u64(left) < u64(right)); } else { result = BoolInt(left < right); } }
        else if (op == 62) { if (unsigned) { result = BoolInt(u64(left) > u64(right)); } else { result = BoolInt(left > right); } }
        else if (op == 261) { if (unsigned) { result = BoolInt(u64(left) <= u64(right)); } else { result = BoolInt(left <= right); } }
        else if (op == 262) { if (unsigned) { result = BoolInt(u64(left) >= u64(right)); } else { result = BoolInt(left >= right); } }
        else if (op == 263) { result = BoolInt(left != 0 && right != 0); }
