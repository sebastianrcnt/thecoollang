                return BoolInt(op == 260);
            }
            let x = AsFloat(left);
            let y = AsFloat(right);
            var result: f64 = 0.0;
            if (op == 43) { result = x + y; }
            else if (op == 45) { result = x - y; }
            else if (op == 42) { result = x * y; }
            else if (op == 47) { result = x / y; }
            else if (op == 259) { return BoolInt(x == y); }
            else if (op == 260) { return BoolInt(x != y); }
            else if (op == 60) { return BoolInt(x < y); }
            else if (op == 62) { return BoolInt(x > y); }
            else if (op == 261) { return BoolInt(x <= y); }
            else if (op == 262) { return BoolInt(x >= y); }
            return ConvertNumber(AsBits(result), 11, node.type, node.token);
        }
        if ((op == 47 || op == 37) && (right == 0 ||
