        if ((op == 266 || op == 267) && (right < 0 || right >= Width(node.a.type))) {
            ErrorAt(node.token, cast[*u8]("shift count outside operand width"));
        }
        var result: i64 = 0;
        if (op == 43) { result = left + right; }
        else if (op == 45) { result = left - right; }
        else if (op == 42) { result = left * right; }
        else if (op == 47) { if (unsigned) { result = i64(u64(left) / u64(right)); } else { result = left / right; } }
        // Preserve full-width remainder without the legacy seed's truncation.
        else if (op == 37) { if (unsigned) { result = i64(u64(left) - (u64(left) / u64(right)) * u64(right)); } else { result = left % right; } }
        else if (op == 38) { result = left & right; }
