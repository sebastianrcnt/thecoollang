                Append(stats, cast[*u8](" literals="));
                Number(stats, literals);
                var blocks: i64 = 0;
                var source_bytes: i64 = 0;
                var source = ctx.v_repl_sources;
                while (source != null) {
                    if (source.live != 0) { blocks = blocks + 1; source_bytes = source_bytes + (source.end - source.begin); }
                    source = source.next;
                }
                Append(stats, cast[*u8](" source_blocks="));
                Number(stats, blocks);
                Append(stats, cast[*u8](" source_bytes="));
                Number(stats, source_bytes);
