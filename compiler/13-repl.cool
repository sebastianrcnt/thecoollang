        ctx.v_repl_snapshot = cast[*Function](CAlloc(i64(u64(4096) * sizeof(Function))));
        ctx.v_allow_redefinition = i8(1);
        ctx.v_lex_package = cast[*u8]("__main");
        ctx.v_execution_mode = 3;
