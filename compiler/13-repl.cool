        ParseProgram();
        ReplFinishLiterals();
        while (true) {
            if (prompt != i8(0)) {
                Out(cast[*u8]("cool> "));
            }
            let text = Submission();
            if (text == null) {
                break;
            }
            if ((Eq(text.data, cast[*u8](":quit\n")) != i8(0) || Eq(text.data, cast[*u8](":quit")) != i8(0)) && StrLen(text.data) == text.len) {
                break;
            }
            if (Eq(text.data, cast[*u8](":stats\n")) != i8(0) && StrLen(text.data) == text.len) {
                let stats = TextNew();
                var compiled: i64 = 0;
                var i: i64 = 1;
                while (i < ctx.v_nfun) {
                    if (ctx.v_functions[i].bytecode != null) {
                        compiled = compiled + 1;
                    }
                    i = i + 1;
                }
                Append(stats, cast[*u8]("functions="));
                Number(stats, ctx.v_nfun - 1);
                Append(stats, cast[*u8](" compiled="));
                Number(stats, compiled);
                Append(stats, cast[*u8](" bytecode_compilations="));
                Number(stats, ctx.v_bytecode_compilations);
                Append(stats, cast[*u8](" jit_compilations="));
                Number(stats, ctx.v_jit_compilations);
                Append(stats, cast[*u8](" tokens="));
                Number(stats, ctx.v_ntok);
                Append(stats, cast[*u8](" aggregates="));
                Number(stats, ctx.v_naggregates);
                var locals: i64 = 0;
