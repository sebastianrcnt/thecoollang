// Conservative value provenance and independent reference binding origins.
// Parameter bits identify external roots; bit 40 identifies this frame.
fn BorrowRegion(node:*Node,origin:bool)->i64{unsafe{
 if(node==null || Borrowed(node.type)==i8(0)){return 0;}
 if(node.kind==29){return BorrowRegion(node.origin_source,origin);}
 if(node.kind==28){return BorrowRegion(node.a,origin);}
 if(IsReference(node.type) && node.kind==23){
  if(node.op==1){return BorrowRegion(node.origin_source,origin);}
  return BorrowPlaceRegion(node.a,origin);
 }
 if(node.kind==3 && node.local_ref!=null){
  if(origin){return node.local_ref.place_region;}
  return node.local_ref.region;
 }
 if(node.kind==26){
  if(node.op==2){return BorrowPlaceRegion(node.a,origin);}
  return BorrowRegion(node.origin_source,origin);
 }
 // A load reads payload provenance, including values installed through aliases.
 if(node.kind==18){if(node.origin_source!=null){return BorrowRegion(node.origin_source,false);}return 1099511627776;}
 var result:i64=0;
 if(node.kind==23){var item=node.a;while(item!=null){result=result|BorrowRegion(item,origin);item=item.next;}return result;}
 if(node.kind==4 && node.slot>=0){
  let ctx=cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
  var index:i64=0;var item=node.a;
  while(item!=null){if((ctx.v_functions[node.slot].borrow_contract&(1<<index))!=0){result=result|BorrowRegion(item,origin);}index=index+1;item=item.next;}
  return result;
 }
 return 1099511627776;
}}
fn BorrowPlaceRegion(node:*Node,origin:bool)->i64{unsafe{
 if(node==null){return 1099511627776;}
 if(node.kind==30){
  if(IsReference(node.a.type)){return BorrowRegion(node.a,origin);}
  if(node.a.kind==18){return BorrowPlaceRegion(node.a.a,origin);}
 }
 if(node.kind==18 || node.kind==24){return BorrowPlaceRegion(node.a,origin);}
 if(node.kind==25){if(node.op==3){return BorrowRegion(node.a,origin);}return BorrowPlaceRegion(node.a,origin);}
 return 1099511627776;
}}
fn Region(node:*Node)->i64{return BorrowRegion(node,false);}
fn PlaceRegion(node:*Node)->i64{return BorrowPlaceRegion(node,false);}
fn OriginRegion(node:*Node)->i64{return BorrowRegion(node,true);}
fn BorrowRoot(node:*Node)->*Local{unsafe{
 if(node==null){return null;}
 if(node.local_ref!=null){return node.local_ref;}
 if(node.kind==18 || node.kind==24 || node.kind==25 || node.kind==22 || node.kind==30){return BorrowRoot(node.a);}
 return null;
}}
fn RecordBorrowEdge(local:*Local,source:*Node,storage:bool){unsafe{
 if(local==null || Borrowed(local.type)==i8(0)){return;}
 var previous=cast[*BorrowSource](local.sources);
 while(previous!=null){if(previous.node==source && previous.storage==storage){return;}previous=previous.next;}
 let edge=cast[*BorrowSource](CAlloc(i64(sizeof(BorrowSource))));
 edge.node=source;edge.storage=storage;edge.next=cast[*BorrowSource](local.sources);local.sources=cast[*u8](edge);
}}
fn RecordBorrow(local:*Local,source:*Node){RecordBorrowEdge(local,source,false);}
// Stores alter payload provenance, never the reference binding's physical origin.
// Follow all binding sources to retain effects on every possible destination.
fn RecordBorrowDestination(node:*Node,source:*Node){unsafe{
 if(node==null){return;}
 if(node.kind==3 && node.local_ref!=null){
  let local=node.local_ref;
  if(local.destination_mark==source){return;}local.destination_mark=source;
  RecordBorrowEdge(local,source,true);
  if(IsReference(local.type)){
   var edge=cast[*BorrowSource](local.sources);
   while(edge!=null){if(!edge.storage){RecordBorrowDestination(edge.node,source);}edge=edge.next;}
  }
  return;
 }
 if(node.kind==23 && IsReference(node.type)){
  if(node.op==1){RecordBorrowDestination(node.origin_source,source);}
  else{let origin=ReferencePlaceSource(node.a);if(origin!=null){RecordBorrowDestination(origin,source);}else{RecordBorrowEdge(BorrowRoot(node.a),source,true);}}
  return;
 }
 if(node.kind==4 && node.slot>=0){
  let ctx=cast[*CompilerState](NativeCompilerState(i64(sizeof(CompilerState))));
  var index:i64=0;var item=node.a;
  while(item!=null){if((ctx.v_functions[node.slot].borrow_contract&(1<<index))!=0){RecordBorrowDestination(item,source);}index=index+1;item=item.next;}
  return;
 }
 if(node.kind==29){RecordBorrowDestination(node.origin_source,source);return;}
 if(node.kind==18 && node.origin_source!=null){RecordBorrowDestination(node.origin_source,source);return;}
 RecordBorrowEdge(BorrowRoot(node),source,true);
}}
fn BorrowEdges(node:*Node){unsafe{
 if(node==null){return;}
 if(node.kind==7 || node.kind==8){RecordBorrow(node.local_ref,node.a);}
 // Gather binding sources before resolving stored destinations, independently
 // of AST visitation order. BorrowStoredEdges performs the second phase.
 BorrowEdges(node.a);BorrowEdges(node.b);BorrowEdges(node.c);BorrowEdges(node.next);
}}
fn BorrowStoredEdges(node:*Node){unsafe{
 if(node==null){return;}
 if(node.kind==19 && Borrowed(node.type)!=i8(0)){
  let root=BorrowRoot(node.a);
  if(root!=null && IsReference(root.type)){
   var proxy=Node{};proxy.kind=3;proxy.type=root.type;proxy.local_ref=root;RecordBorrowDestination(&raw proxy,node.b);
  }else{RecordBorrowEdge(root,node.b,true);}
 }
 BorrowStoredEdges(node.a);BorrowStoredEdges(node.b);BorrowStoredEdges(node.c);BorrowStoredEdges(node.next);
}}
fn CheckBorrowReturns(node:*Node,function:*Function){unsafe{
 if(node==null){return;}
 if(node.kind==9 && Borrowed(function.result)!=i8(0) && (Region(node.a)&~function.borrow_contract)!=0){ErrorAt(node.token,cast[*u8]("returned borrow may outlive local storage or violate its borrows contract"));}
 CheckBorrowReturns(node.a,function);CheckBorrowReturns(node.b,function);CheckBorrowReturns(node.c,function);CheckBorrowReturns(node.next,function);
}}
fn PropagateBorrowRegions(function:*Function){unsafe{
 var local=function.all_locals;
 while(local!=null){local.destination_mark=null;local=local.all_next;}
 BorrowEdges(function.body);BorrowStoredEdges(function.body);
 var changed=true;
 while(changed){
  changed=false;local=function.all_locals;
  while(local!=null){
   let before=local.region;let origin_before=local.place_region;var edge=cast[*BorrowSource](local.sources);
   while(edge!=null){local.region=local.region|Region(edge.node);if(!edge.storage){local.place_region=local.place_region|OriginRegion(edge.node);}edge=edge.next;}
   if(before!=local.region || origin_before!=local.place_region){changed=true;}
   local=local.all_next;
  }
 }
 local=function.all_locals;while(local!=null){local.destination_mark=null;local=local.all_next;}
}}
fn AnalyzeBorrows(function:*Function){unsafe{
 PropagateBorrowRegions(function);
 CheckBorrowReturns(function.body,function);
}}
