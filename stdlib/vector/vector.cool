package vector;
import option "std/option";
// Stable chunks avoid relocating live elements when the vector grows.
struct Chunk[T] {
    values: [32]option.Option[T];
    previous: * Chunk[T];
    next: own[Chunk[T]];
}
pub struct Vector[T] {
    head: own[Chunk[T]];
    tail: * Chunk[T];
    count: usize;
}
pub fn create[T]() -> Vector[T]borrows() {
    return Vector[T] {
    };
}
pub fn len[T](vector: & Vector[T]) -> usize {
    unsafe {
        return ( * vector).count;
    }
}
pub fn append[T](vector: & mut Vector[T], value: T) stores(vector, value) {
    unsafe {
        let index = ( * vector).count % 32;
        if (index == 0) {
            var empty = Vector[T] {
            };
            let chunk = new[Chunk[T]](Chunk[T] {
                previous: null, next: move empty.head, values: [32]option.Option[T] {
                    option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None, option.Option[T].None
                }
            }
            );
            let pointer = & raw * chunk;
            ( * pointer).previous = ( * vector).tail;
            if (( * vector).count == 0) {
                ( * vector).head = move chunk;
            } else {
                ( * ( * vector).tail).next = move chunk;
            }
            ( * vector).tail = pointer;
        }
        ( * ( * vector).tail).values[index] = option.Option[T].Some(move value);
        ( * vector).count = ( * vector).count + 1;
    }
}
fn pointer_at[T](vector: * Vector[T], index: usize) -> * T {
    unsafe {
        assert(index < ( * vector).count);
        var chunk = & raw * ( * vector).head;
        var block = index / 32;
        while (block > 0) {
            chunk = & raw * ( * chunk).next;
            block = block - 1;
        }
        let slot = & raw( * chunk).values[index % 32];
        assert( * cast[ * i64](slot) == 1);
        return cast[ * T](cast[ * u8](slot) + 8);
    }
}
pub fn pop[T](vector: & mut Vector[T]) -> option.Option[T]borrows(vector) {
    unsafe {
        let raw = cast[ * Vector[T]](vector);
        if (( * raw).count == 0) {
            return option.Option[T].None;
        }
        let index = (( * raw).count - 1) % 32;
        let chunk = ( * raw).tail;
        let slot = & raw( * chunk).values[index];
        let value = move * borrow_raw[ & mut option.Option[T]](slot, vector);
        * slot = option.Option[T].None;
        ( * raw).count = ( * raw).count - 1;
        if (index == 0) {
            let previous = ( * chunk).previous;
            ( * raw).tail = previous;
            if (previous == null) {
                let released = move( * raw).head;
            } else {
                let released = move( * previous).next;
            }
        }
        return move value;
    }
}
pub fn clear[T](vector: & mut Vector[T]) {
    unsafe {
        while (( * vector).count > 0) {
            pop[T](vector);
        }
    }
}
// A raw cursor borrows the vector; removal, clear or destruction can invalidate it.
pub struct Cursor[T] {
    chunk: * Chunk[T];
    index: usize;
    remaining: usize;
}
pub fn cursor[T](source: & Vector[T]) -> Cursor[T] {
    unsafe {
        let vector = cast[ * Vector[T]](source);
        var first: * Chunk[T] = null;
        if (( * vector).count > 0) {
            first = & raw * ( * vector).head;
        }
        return Cursor[T] {
            chunk: first, index: 0, remaining: ( * vector).count
        };
    }
}
pub fn next[T](cursor: * Cursor[T]) -> * T {
    unsafe {
        if (( * cursor).remaining == 0) {
            return null;
        }
        let slot = & raw( * ( * cursor).chunk).values[( * cursor).index];
        assert( * cast[ * i64](slot) == 1);
        let value = cast[ * T](cast[ * u8](slot) + 8);
        ( * cursor).index = ( * cursor).index + 1;
        ( * cursor).remaining = ( * cursor).remaining - 1;
        if (( * cursor).index == 32 && ( * cursor).remaining > 0) {
            ( * cursor).chunk = & raw * ( * ( * cursor).chunk).next;
            ( * cursor).index = 0;
        }
        return value;
    }
}
// The caller's loan keeps the vector alive and prevents removal or replacement.
pub fn at[T](vector: & Vector[T], index: usize) -> & T borrows(vector) {
    unsafe {
        let pointer = pointer_at[T](cast[ * Vector[T]](vector), index);
        return borrow_raw[ & T](pointer, vector);
    }
}
pub fn at_mut[T](vector: & mut Vector[T], index: usize) -> & mut T borrows(vector) {
    unsafe {
        let pointer = pointer_at[T](cast[ * Vector[T]](vector), index);
        return borrow_raw[ & mut T](pointer, vector);
    }
}
// Instance syntax preserves the free-function APIs and their borrow contracts.
pub fn Vector.len[T](self: & Vector[T]) -> usize {
    return ( * self).count;
}
pub fn Vector.append[T](self: & mut Vector[T], value: T) stores(self, value) {
    append[T](self, move value);
}
pub fn Vector.pop[T](self: & mut Vector[T]) -> option.Option[T]borrows(self) {
    return pop[T](self);
}
pub fn Vector.clear[T](self: & mut Vector[T]) {
    clear[T](self);
}
pub fn Vector.at[T](self: & Vector[T], index: usize) -> & T borrows(self) {
    return at[T](self, index);
}
pub fn Vector.at_mut[T](self: & mut Vector[T], index: usize) -> & mut T borrows(self) {
    return at_mut[T](self, index);
}
// A tracked cursor keeps its source borrowed for the iterator's lexical scope.
// Raw chunk links never escape the safe API. Returned element references also
// borrow the iterator, so next() cannot run while an element result is retained.
pub struct Iterator[T] {
    source: & Vector[T];
    position: Cursor[T];
}
pub fn iter[T](source: & Vector[T]) -> Iterator[T]borrows(source) {
    return Iterator[T] {
        source: source, position: cursor[T](source)
    };
}
pub fn Iterator.remaining[T](self: & Iterator[T]) -> usize {
    return ( * self).position.remaining;
}
pub fn Iterator.next[T](self: & mut Iterator[T]) -> option.Option[ & T]borrows(self) {
    unsafe {
        let pointer = next[T]( & raw( * self).position);
        if (pointer == null) {
            return option.Option[ & T].None;
        }
        return option.Option[ & T].Some(borrow_raw[ & T](pointer, self));
    }
}
pub fn Vector.iter[T](self: & Vector[T]) -> Iterator[T]borrows(self) {
    return iter[T](self);
}
// Copying an exclusive iterator reborrows its source and suspends the parent.
// Only one iterator or element loan may mutate a source at a time.
pub struct IteratorMut[T] {
    source: & mut Vector[T];
    position: Cursor[T];
}
pub fn iter_mut[T](source: & mut Vector[T]) -> IteratorMut[T]borrows(source) {
    let position = cursor[T]( & * source);
    return IteratorMut[T] {
        source: source, position: position
    };
}
pub fn IteratorMut.remaining[T](self: & IteratorMut[T]) -> usize {
    return ( * self).position.remaining;
}
pub fn IteratorMut.next[T](self: & mut IteratorMut[T]) -> option.Option[ & mut T]borrows(self) {
    unsafe {
        let pointer = next[T]( & raw( * self).position);
        if (pointer == null) {
            return option.Option[ & mut T].None;
        }
        return option.Option[ & mut T].Some(borrow_raw[ & mut T](pointer, self));
    }
}
pub fn Vector.iter_mut[T](self: & mut Vector[T]) -> IteratorMut[T]borrows(self) {
    return iter_mut[T](self);
}
