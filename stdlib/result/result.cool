package result;
pub enum Result[T, E] {
    Ok(T);
    Err(E);
}
pub fn is_ok[T, E](value: Result[T, E]) -> bool {
    match (move value) {
        Result[T, E].Ok(_) => {
            return true;
        }
        Result[T, E].Err(_) => {
            return false;
        }
    }
}
pub fn value_or[T, E](value: Result[T, E], fallback: T) -> T borrows(value, fallback) {
    match (move value) {
        Result[T, E].Ok(result) => {
            return move result;
        }
        Result[T, E].Err(_) => {
            return move fallback;
        }
    }
}
